  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/bdefa7d0-308a-426a-9b12-d60cd2d3c05b-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasAdditionalContractNature <http://publications.europa.eu/resource/authority/contract-nature/supplies>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
