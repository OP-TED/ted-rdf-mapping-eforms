  a epo:Procedure;
  epo:hasAdditionalInformation "Tulenevalt registri tehnilisest eripärast on hankelepingu eeldatava kestuse märkimisel kohustuslik väli ka lepingu algusaeg. Hankija on eelnimetatud väljal märkinud lepingu algusaja eeldatavana ning vastavalt hankelepingu projektides sätestatule hakatakse teenust osutama lepingu sõlmimisest."@et;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/dab6a595-a126-47c5-9c98-90c90f672eac-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
