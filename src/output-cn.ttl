<http://data.europa.eu/a4g/resource/2cf5f12f-ccbe-4517-9690-8d96a5517833-03/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesEstimatedContractDuration <http://data.europa.eu/a4g/resource/2cf5f12f-ccbe-4517-9690-8d96a5517833-03/ContractDuration$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering false;
  epo:hasEPayment false;
  epo:hasLegalFormRequirement "AK gazdálkodó szervezet alapítását kizárja mind RJ, mind közös RJ-k vonatkozásában. AK felhívja a figyelmet a Kbt. 35. § (1)-(8) bek-re."@hu;
  epo:hasPaymentArrangement "A teljesítésre a Kbt. 135. § (1), (5)-(6), és a Ptk. 6:130. § (1)-(2) bekezdései irányadók. Előleg: nincs. Ajánlatkérő a Kbt. 135. § (11) bek. alapján a Ptk. 6:155. § (1) bek. szerint késedelmi kamat és külön jogszabály szerinti költségátalány megfizetésére köteles. Ajánlatkérő alkalmazza a Kbt. 27/A. §-t. Az ajánlattétel, a szerződés, a kifizetések pénzneme magyar forint (HUF). A számla kiállítására, továbbá az Áfa megfizetésére a kiállításkor hatályos jogszabályok az irányadóak. A kifizetésre vonatkozó feltételek részletes leírását a közbeszerzési dokumentumok (szerződéstervezet) tartalmazzák."@hu;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no> .

<http://data.europa.eu/a4g/resource/2cf5f12f-ccbe-4517-9690-8d96a5517833-03/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>
