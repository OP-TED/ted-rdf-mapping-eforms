<http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/Procedure/adce5f2f-a9b7-45ab-a00a-b9b60a5c8c53>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/Procedure/Identifier/24CONC02>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-mult>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description """Concours restreint sur esquisse + pour la construction de deux équipements dans la ZAE de Sainte Musse :
L'opération est scindée en 2 ouvrages :
Création du Site d'Exploitation, de Maintenance et de Remisage.
Sa capacité d'accueil est de 150 bus, 80 places VL
Catégorie d'ouvrage : Bâtiment en construction neuve
Création d'un parking Silo P+R
Création d'un parc public de stationnement en superstructure, largement ventilé, à vocation mixte horaires-abonnés.
Sa capacité d'accueil est de 510 places pour le stationnement voitures, 20 places de stationnement deux-roues motorisés, et 25 places de stationnement vélos.  Catégorie d'ouvrage : Bâtiment en construction neuve.
L'enveloppe financière prévisionnelle affectée aux travaux est de 57 735 900 euros HT se décomposant en :
Création d'un SEMR : 44 060 700 euros HT,
Création d'un parking Silo : 13 675 200 euros HT
le projet porte sur la réalisation d'un projet neuf complexe (imbrication de 2 ouvrages  répondant à des règlementations différentes, avec une mise en service des sites différée, nécessitant le montage d'un dossier ICPE et le suivi de son instruction, la réalisation d'un dossier loi sur l'eau et d'une étude d'impact. concours restreint limité à 4 concepteurs, avec remise de prestation de niveau \" esquisse+ \", avec anonymat. Pour chaque ouvrage, mission de base étendue à l'OPC + missions complémentaires dont le détail figure au RC . En cas de groupement, la forme souhaitée par l'Entité Adjudicatrice pour l'exécution du marché de maitrise d'oeuvre, est un groupement conjoint avec mandataire solidaire. Si le groupement attributaire du marché est d'une forme différente, il pourra se voir contraint d'assurer sa transformation pour se conformer au souhait de l'Entité Adjudicatrice tel qu'il est indiqué ci-dessus. 
Le mandataire du groupement sera de préférence l'architecte."""@fr;
  dct:title "24CONC02 Concours de Maîtrise d'oeuvre restreint sur esquisse + en vue de la création d'un parking silo P+R et d'un site d'Exploitation, de maintenance et de remisage à Toulon (83)"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/8c2f3a8b-1239-468a-ab89-958a872183ac-01/Procedure/Identifier/adce5f2f-a9b7-45ab-a00a-b9b60a5c8c53> .

