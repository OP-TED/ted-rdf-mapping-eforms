  epo:hasAdditionalInformation "Hanke lisateave on leitav riigihanke alusdokumendist Juhised pakkujale. (356858-2022)"@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/126934e9-8491-4d90-954c-985afa877f18-01/Lot/Identifier/246561>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/126934e9-8491-4d90-954c-985afa877f18-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isRecurrent false;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/126934e9-8491-4d90-954c-985afa877f18-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
