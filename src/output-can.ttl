<http://data.europa.eu/a4g/resource/e1d1b5ea-a970-4108-958b-9d1aed75171e-01/ContractModificationInformation$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_ContractModification3>
  a epo:ContractModificationInformation;
  epo:concernsContractAmendment <http://data.europa.eu/a4g/resource/e1d1b5ea-a970-4108-958b-9d1aed75171e-01/ContractAmendment$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_ContractModification3>;
