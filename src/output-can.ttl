  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Concurrentiegerichte dialoog"@nl;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/comp-dial>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/efffbcde-11c0-4037-9408-7642cf418145-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/efffbcde-11c0-4037-9408-7642cf418145-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/efffbcde-11c0-4037-9408-7642cf418145-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description """De BVID omvat het informatiesysteem, de randapparaten, modules (v.h.: zuilen), en koffers die onze KMar-collega’s gebruiken voor identiteitscontrole en –vaststelling.

De BVID-module is het apparaat voor het adequaat monteren en gebruiken van de benodigde randapparatuur en BVID-werkplek, om met dit geheel m.b.v. de applicatie BVID biometrische gegevens van vreemdelingen en verdachten te registreren en een integraal persoonsbeeld te verkrijgen binnen de straf- en migratieketens.

Deze modules zijn geïnstalleerd op politiebureaus en spelen een cruciale rol bij het voorkomen van identiteitsfraude en het waarborgen van een betrouwbare identiteitsvaststelling."""@nl;
  dct:title "BVID-module"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/efffbcde-11c0-4037-9408-7642cf418145-01/Procedure/Identifier/0f8fe134-06c3-45f7-b8c6-1699ab8b429d> .

