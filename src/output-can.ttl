  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/ReviewProcedureInformationProvider/ORG-0002organization>;
