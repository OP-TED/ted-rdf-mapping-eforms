    <http://data.europa.eu/a4g/resource/3bc2649d-57b2-4045-b4f6-88ed65d65f73-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion7>,
    <http://data.europa.eu/a4g/resource/3bc2649d-57b2-4045-b4f6-88ed65d65f73-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion8>,
    <http://data.europa.eu/a4g/resource/3bc2649d-57b2-4045-b4f6-88ed65d65f73-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion9>;
