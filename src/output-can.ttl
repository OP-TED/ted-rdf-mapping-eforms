  epo:hasPurpose <http://data.europa.eu/a4g/resource/efffbcde-11c0-4037-9408-7642cf418145-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/efffbcde-11c0-4037-9408-7642cf418145-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
