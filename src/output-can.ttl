<http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/Procedure/3fd2cd74-e3ff-4f2e-9f3d-1c9ad4ce82dd>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/Procedure/Identifier/DOP-ZP-20%2F2025>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "art. 214 ust. 1 pkt. 1 lit a) ustawy Pzp / Zamawiający może udzielić zamówienia z wolnej ręki, jeżeli zachodzi co najmniej jedna  z następujących okoliczności: 1) dostawy, usługi lub roboty budowlane mogą być świadczone tylko przez jednego wykonawcę z przyczyn: a) technicznych o obiektywnym charakterze, b) związanych z ochroną praw wyłącznych wynikających z odrębnych przepisów- jeżeli nie istnieje rozsądne"@pl;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/DirectAwardTerm$_ContractAwardNotice1_TenderingProcess1_ProcessJustification1>,
    <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/DirectAwardTerm$_ContractAwardNotice1_TenderingProcess1_ProcessJustification2>,
    <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description """1.	Przedmiotem niniejszego zamówienia jest dostarczanie wody i odprowadzanie ścieków do budynków komunalnych stanowiących własność Gminy Miejskiej Legionowo zarządzanych i administrowanych przez KZB Legionowo Spółka z o.o. a także innych obiektów KZB Legionowo Spółka z o.o. wymienionych w załączniku nr 1.
2.	Szacunkowe zapotrzebowanie na wodę w okresie od 01.01.2026 r. do 31.12.2026r. oraz szacunkowa ilość odprowadzanych ścieków wynosi
WODA		           94000 m3
KANALIZACJA		95082 m3
3.	Na wniosek Zamawiającego możliwe jest zwiększenie lub zmniejszenie ilości obiektów (punktów poboru) wymienionych w załączniku nr 1."""@pl;
  dct:title "Dostarczanie wody i odprowadzanie ścieków do budynków a także innych obiektów KZB Legionowo Spółka z o.o."@pl;
  adms:identifier <http://data.europa.eu/a4g/resource/1005a75e-e8d7-4c75-a8ea-24a4fa70a897-02/Procedure/Identifier/3fd2cd74-e3ff-4f2e-9f3d-1c9ad4ce82dd> .

