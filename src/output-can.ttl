  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/538e23d6-5686-4659-9d39-1f56ea1951db-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
