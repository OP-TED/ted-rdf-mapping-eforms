        rr:class epo:Procedure
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPP-040-Procedure (isSubjectToTerm)" ;
        rdfs:comment "Connection from Procedure to ContractTerm" ;
        rr:predicate epo:isSubjectToTerm ;
        rr:objectMap [
            rr:parentTriplesMap tedm:MG-ContractTerm-isSubjectToTerm-Procedure_ND-ProcedureProcurementScope_v2 ;
            rr:joinCondition [
                rr:child "path(.)" ;
                rr:parent "path(.)" ;
            ] ;
        ] ;
    ] .

tedm:MG-ContractTerm-isSubjectToTerm-Procedure_ND-ProcedureProcurementScope_v2 a rr:TriplesMap ;
    rdfs:label "MG-ContractTerm-isSubjectToTerm-Procedure" ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cac:ProcurementProject/cac:ProcurementAdditionalType/cbc:ProcurementTypeCode[@listName='transport-service']" ;
        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-ProcedureProcurementScope" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/ContractTerm${replace(translate(path(../..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
        rr:class epo:ContractTerm
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPP-040-Procedure" ;
        rdfs:comment "Transport Service Type for Procedure (variant 2)" ;
        rr:predicate epo:hasTransportServiceType ;
        rr:objectMap [
            rr:parentTriplesMap tedm:transport-service ;
            rr:joinCondition [
                rr:child "." ;
                rr:parent "code.value" ;
            ] ;
        ] ;
    ] .

tedm:MG-langString-hasJustification-DirectAwardTerm-isSubjectToTerm-Procedure_ND-DirectAward a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cac:TenderingProcess/cac:ProcessJustification[cbc:ProcessReasonCode/@listName='direct-award-justification']/cbc:ProcessReason" ;
        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rr:class epo:DirectAwardTerm ;
        rdfs:label "ND-DirectAward" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/DirectAwardTerm${replace(translate(path(..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate epo:hasJustification ;
        rr:objectMap [
            rml:reference "if((exists(@languageID)) and  (not(exists(../ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:FieldsPrivacy[efbc:FieldIdentifierCode/text()='dir-awa-tex']) and ./text() = 'unpublished'))) then . else null" ;
            rml:languageMap [
                fnml:functionValue [
                    rr:predicateObjectMap [
                        rr:predicate idlab-fn:str ;
                        rr:objectMap [
                            rml:reference "@languageID" ;
                        ] ;
                    ] ;
                    rr:predicateObjectMap tedm:idlab-fn_executes_lookup ;
                    rr:predicateObjectMap tedm:idlab-fn_fromColumn_code ;
                    rr:predicateObjectMap tedm:idlab-fn_inputFile_language ;
                    rr:predicateObjectMap tedm:idlab-fn_toColumn_code ;
                ] ;
            ] ;
            rdfs:comment "Language of Direct Award Justification Text of MG-DirectAwardTerm under ND-DirectAward" ;
            rdfs:label "BT-135-Procedure-Language" ;
        ] ;
        rdfs:comment "Direct Award Justification Text of MG-DirectAwardTerm under ND-DirectAward" ;
        rdfs:label "BT-135-Procedure" ;
    ] ;
    rdfs:label "MG-DirectAwardTerm" .
