#--- Root version-specific SDK v0-1.6 ---
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix tedm: <http://data.europa.eu/a4g/mapping/sf-rml/> .
@prefix epd: <http://data.europa.eu/a4g/resource/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-not: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-con: <http://data.europa.eu/a4g/ontology#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix cpov: <http://data.europa.eu/m8g/> .
@prefix	foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2006/time#>.
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix idlab-fn: <http://example.com/idlab/function/> .

tedm:MG-ContractModificationNotice_ND-Modification a rr:TriplesMap ;
    rdfs:label "MG-ContractModificationNotice" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:ContractModification" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-Modification" ;
            rr:template "http://data.europa.eu/a4g/resource/{replace(replace(/*/cbc:ID[@schemeName='notice-id'], ' ', '-' ), '/' , '-')}-{/*/cbc:VersionID}/Notice" ;
            rr:class epo-not:ContractModificationNotice
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-1501(s)-Contract" ;
            rdfs:comment "Relation between Contract and ContractModificationNotice under ND-Modification" ;
            tedm:maxSDKVersion "1.6" ;
            rr:predicate epo:refersToContractToBeModified  ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-Contract-refersToContractToBeModified-ContractModificationNotice_ND-Modification ;
                    rr:joinCondition [
                        rr:child "path(.)" ;
                        rr:parent "path(../..)" ;
                    ];
                ] ;
        ] ;
.
tedm:MG-ContractModificationInformation_ND-Modification a rr:TriplesMap ;
    rdfs:label "MG-ContractModificationInformation" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:ContractModification/efac:Change" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-Modification" ;
            rml:reference "if (exists(efbc:ChangedSectionIdentifier)) then 'http://data.europa.eu/a4g/resource/' || replace(replace(/*/cbc:ID[@schemeName='notice-id'], ' ', '-' ), '/' , '-') || '-' || /*/cbc:VersionID || '/' || 'ContractModificationInformation' || '/' || replace(replace(replace(path(..), 'Q\{[^}]+\}', ''), '\[([0-9]+)\]', '$1'), '/', '_') else null" ;
            rr:class epo-con:ContractModificationInformation
        ] ;
    rr:predicateObjectMap
        [
            tedm:maxSDKVersion "1.6" ;
            rdfs:label "BT-1501(s)-Contract" ;
            rdfs:comment "Modification Previous Notice Section Identifier of MG-Notice under ND-Modification" ;
            rr:predicate epo:relatesToEFormSectionIdentifier ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-Identifier-relatesToEFormSectionIdentifier-ContractModificationInformation_ND-Modification ;
                    rr:joinCondition [
                        rr:child "path(.)" ;
                        rr:parent "path(..)" ;
                    ] ;
                ] ;
        ] ;
.

tedm:MG-ContractAmendment_ND-Modification a rr:TriplesMap ;
    rdfs:label "MG-Contract" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:ContractModification/efac:Change" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-Modification" ;
            rr:template "http://data.europa.eu/a4g/resource/{replace(replace(/*/cbc:ID[@schemeName='notice-id'], ' ', '-' ), '/' , '-')}-{/*/cbc:VersionID}/ContractAmendment/{replace(translate(path(..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
            rr:class epo-con:ContractAmendment
        ] ;
    rr:predicateObjectMap
        [
            tedm:maxSDKVersion "1.6" ;
            rdfs:label "BT-1501(s)-Contract" ;
            rdfs:comment "Modification Previous Notice Section Identifier of MG-Notice under ND-Modification" ;
            rr:predicate epo:amendsContract ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-Contract-amendsContract-ContractAmendment_ND-Modification ;
                    rr:joinCondition [
                        rr:child "path(.)" ;
                        rr:parent "path(..)" ;
                    ] ;
                ] ;
        ] ;
.

tedm:MG-Identifier-relatesToEFormSectionIdentifier-ContractModificationInformation_ND-Modification a rr:TriplesMap ;
    rdfs:label "MG-Identifier" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:ContractModification/efac:Change/efbc:ChangedSectionIdentifier" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-Modification" ;
            rml:reference "'http://data.europa.eu/a4g/resource/' || replace(replace(/*/cbc:ID[@schemeName='notice-id'], ' ', '-' ), '/' , '-') || '-' || /*/cbc:VersionID || '/' || 'ModifiedSectionIdentifier' || '/' || replace(replace(replace(path(), 'Q\{[^}]+\}', ''), '\[([0-9]+)\]', '$1'), '/', '_')" ;
            rr:class adms:Identifier
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-1501(s)-Contract" ;
            rdfs:comment "Modification Previous Notice Section Identifier of MG-Identifier under ND-Modification" ;
            rr:predicate skos:notation ;
            rr:objectMap
                [
                    rml:reference "." ;
                ] ;
        ] ;
     rr:predicateObjectMap
        [
            rdfs:label "BT-1501(s)-Contract-Scheme" ;
            rdfs:comment "Scheme of Modification Previous Notice Identifier of MG-Identifier under ND-Modification" ;
            rr:predicate epo:hasScheme ;
            rr:objectMap
                [
                    rml:reference "@schemeName" ;
                ] ;
        ] ;
.

tedm:MG-Contract-amendsContract-ContractAmendment_ND-Modification a rr:TriplesMap ;
    rdfs:label "MG-Contract" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:ContractModification/efac:Change/efbc:ChangedSectionIdentifier" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-Modification" ;
            rml:reference "if (starts-with(text(), 'CON')) then 'http://data.europa.eu/a4g/resource/' || replace(replace(/*/cbc:ID[@schemeName='notice-id'], ' ', '-' ), '/' , '-') || '-' || /*/cbc:VersionID || '/' || 'SettledContract' || '/' || . else null";
            rr:class epo:Contract
        ] ;
.

tedm:MG-Contract-refersToContractToBeModified-ContractModificationNotice_ND-Modification a rr:TriplesMap ;
    rdfs:label "MG-Contract" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:ContractModification/efac:Change/efbc:ChangedSectionIdentifier" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-Modification" ;
            rml:reference "if (starts-with(text(), 'CON')) then 'http://data.europa.eu/a4g/resource/' || replace(replace(/*/cbc:ID[@schemeName='notice-id'], ' ', '-' ), '/' , '-') || '-' || /*/cbc:VersionID || '/' || 'SettledContract' || '/' || . else null";
            rr:class epo:Contract
        ] ;
.
