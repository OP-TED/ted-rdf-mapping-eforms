@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix tedm: <http://data.europa.eu/a4g/mapping/sf-rml/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .

tedm:MG-Subcontractor-foreseesSubcontractor-Organization_ND-SubContractor a rr:TriplesMap ;
    rdfs:label "MG-Subcontractor" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/efac:TenderingParty/efac:SubContractor/efac:MainContractor/cbc:ID" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-SubContractor" ;
            rml:reference "if (exists(.)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/Organization/' || . else null" ;
            rr:class org:Organization
        ] ;
    rr:predicateObjectMap
        [
            tedm:minSDKVersion "1.3" ;
            tedm:maxSDKVersion "1.7" ;
            rdfs:label "OPT-301-Tenderer-MainCont" ;
            rdfs:comment "Connection of main contractor organisation to subcontractor under ND-SubContractor" ;
            rr:predicate epo:foreseesSubcontractor ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-Subcontractor_ND-SubContractor ;
                    rr:joinCondition [
                        rr:child "path(../..)" ;
                        rr:parent "path(.)" ;
                    ] ;
                ] ;
        ] ;
.
