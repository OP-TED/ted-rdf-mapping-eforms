  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion3>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ParticipationCondition$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ProcurementCriterion$_PriorInformationNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/DynamicPurchaseSystemTechnicalUsage$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """Předmětem veřejné zakázky bude dodávka díla „Modernizace systému elektronického odbavování cestujících v MAD Děčín“ za podmínek vymezených v závazném návrhu smlouvy o dílo a navazující poskytování služeb za podmínek vymezených v závazném návrhu servisní smlouvy. Dílo bude blíže specifikováno v technické specifikaci (včetně vlastních příloh této technické specifikace). Předmětem veřejné zakázky budou dále související dodávky a služby, u kterých povinnost dodat či poskytnout je vyplývá ze smlouvy o dílo anebo ze servisní smlouvy. Hlavním předmětem této veřejné zakázky bude dodávka díla. Veřejná zakázka bude proto zadávána v souladu s pravidly platnými pro druh veřejné zakázky odpovídající hlavnímu předmětu této veřejné zakázky, tedy jako veřejná zakázka na dodávky.
"""@cs;
  dct:title "Modernizace systému elektronického odbavování cestujících v MAD Děčín"@cs;
  adms:identifier <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/Identifier/LOT-0001> .

<http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/LotPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>
  a epo:Purpose;
  epo:hasAdditionalClassification <http://data.europa.eu/cpv/cpv/30231100>, <http://data.europa.eu/cpv/cpv/31710000>,
    <http://data.europa.eu/cpv/cpv/32440000>, <http://data.europa.eu/cpv/cpv/32500000>,
