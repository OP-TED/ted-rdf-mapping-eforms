<http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/SocialProcurement$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType3>,
    <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/StrategicProcurement$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:hasAdditionalInformation "Zadavatel bude požadovat, aby dodavatel přijal přiměřená opatření k ochraně důvěrné povahy. Technickou specifikaci a položkový rozpočet nelze zpřístupnit z důvodu ochrany důvěrné povahy informací. Technickou specifikaci a položkový rozpočet zadavatel poskytne dodavateli dále popsaným způsobem. Zadavatel odešle technickou specifikaci a položkový rozpočet po doručení žádosti dodavatele o jejich poskytnutí a po přijetí dále popsaných přiměřených opatření k ochraně důvěrné povahy informací. Technická specifikace a položkový rozpočet budou dodavateli, který projeví zájem účastnit se zadávacího řízení, poskytnuty po uzavření dohody o ochraně důvěrných informací."@cs;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/MonetaryValueLot$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/Lot/Identifier/Modernizace%20syst%C3%A9mu%20elektronick%C3%A9ho%20odbavov%C3%A1n%C3%AD%20cestuj%C3%ADc%C3%ADch%20v%20MAD%20D%C4%9B%C4%8D%C3%ADn>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/LotPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>;
