  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ReviewProcedureInformationProvider/ORG-0002>;
