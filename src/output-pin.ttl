<http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation """Termin podany w pkt 5.1.3 to 90 dniowy termin związania ofertą.
Okres obowiązywania umowy będzie podany w dokumentach zamówienia.
Zamawiający przewiduje możliwość skorzystania z prawa opcji, które będzie mogło być realizowane w 2026 r. i będzie polegało na przeprowadzeniu  od 1 do 2 tur ankietyzacji"""@pl;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/Lot/Identifier/Departament%20Rozwoju%20Regionalnego>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/LotPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/AccessTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/FrameworkAgreementTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/SubmissionTerm$_PriorInformationNotice1_ProcurementProjectLot1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/ParticipationCondition$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest2>,
    <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/DynamicPurchaseSystemTechnicalUsage$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Celem badania jest pozyskanie informacji od przedstawicieli przedsiębiorstw na tematy ważne z punktu widzenia rozwoju regionalnego umożliwiające diagnozę,  określenie potrzeb i kierunki rozwoju małopolskich przedsiębiorstw w  obszarach które są istotne z punktu widzenia realizacji priorytetów finansowanych Funduszy Europejskich dla Małopolski. W tym celu przeprowadzone zostaną maksymalnie dwie tury ankietyzacji w roku 2025, oraz maksymalnie dwie tury ankietyzacji w roku 2026. "@pl;
  dct:title "Przeprowadzenie ankietyzacji wśród podmiotów gospodarki narodowej prowadzących działalność na terenie województwa małopolskiego z prawem opcji (2025-2026)"@pl;
  adms:identifier <http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/Identifier/LOT-0001> .

<http://data.europa.eu/a4g/resource/a5dcf782-b0be-4e8c-aab8-2d383a9c73c2-01/LotPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>
  a epo:Purpose;
  epo:hasMainClassification <http://data.europa.eu/cpv/cpv/79300000> .

