<http://data.europa.eu/a4g/resource/739d861f-2089-4fcd-83ed-34d6ad631008-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
