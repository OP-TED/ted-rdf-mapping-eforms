  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/Procedure/Identifier/Modernizace%20syst%C3%A9mu%20elektronick%C3%A9ho%20odbavov%C3%A1n%C3%AD%20cestuj%C3%ADc%C3%ADch%20v%20MAD%20D%C4%9B%C4%8D%C3%ADn>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasLegalBasisDescription "134/2016 Sb. / Zákon o zadávání veřejných zakázek"@cs,
    "32014L0025 / Směrnice Evropského parlamentu a Rady 2014/25/EU ze dne 26. února 2014 o zadávání zakázek subjekty působícími v odvětví vodního hospodářství, energetiky, dopravy a poštovních služeb a o zrušení směrnice 2004/17/ES"@cs;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  dct:description """Předmětem veřejné zakázky bude dodávka díla „Modernizace systému elektronického odbavování cestujících v MAD Děčín“ za podmínek vymezených v závazném návrhu smlouvy o dílo a navazující poskytování služeb za podmínek vymezených v závazném návrhu servisní smlouvy. Dílo bude blíže specifikováno v technické specifikaci (včetně vlastních příloh této technické specifikace). Předmětem veřejné zakázky budou dále související dodávky a služby, u kterých povinnost dodat či poskytnout je vyplývá ze smlouvy o dílo anebo ze servisní smlouvy. Hlavním předmětem této veřejné zakázky bude dodávka díla. Veřejná zakázka bude proto zadávána v souladu s pravidly platnými pro druh veřejné zakázky odpovídající hlavnímu předmětu této veřejné zakázky, tedy jako veřejná zakázka na dodávky.
"""@cs;
  dct:title "Modernizace systému elektronického odbavování cestujících v MAD Děčín"@cs;
  adms:identifier <http://data.europa.eu/a4g/resource/7d50f9f5-9ef9-4511-ae99-97f5830f0ec1-01/Procedure/Identifier/> .

