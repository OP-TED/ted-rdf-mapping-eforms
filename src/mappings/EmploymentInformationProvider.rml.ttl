tedm:MG-ProcessPlanningTerm-foreseesTerm-PlannedProcurement-announcesPlannedProcurement-PlanningNotice_ND-Root a rr:TriplesMap ;
    rdfs:label "MG-ProcessPlanningTerm-foreseesTerm-PlannedProcurement-announcesPlannedProcurement-PlanningNotice" ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cbc:PlannedDate[exists(/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeSubType/cbc:SubTypeCode[contains('4 5 6 E2', text())])]" ;
        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-Root" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/ProcessPlanningTerm" ;
        rr:class epo:ProcessPlanningTerm
    ] ;
    rr:predicateObjectMap [
        rdfs:label "BT-127" ;
        rdfs:comment "Estimated Contract Notice Publication Date for PlannedProcurement" ;
        rr:predicate epo:hasEstimatedContractNoticePublicationDate ;
        rr:objectMap [
            rml:reference "." ;
            rr:datatype xsd:date
        ] ;
    ] .

tedm:MG-ProcessPlanningTerm-foreseesTerm-Procedure-announcesProcedure-PlanningNotice_ND-Root a rr:TriplesMap ;
    rdfs:label "MG-ProcessPlanningTerm-foreseesTerm-Procedure-announcesProcedure-PlanningNotice" ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cbc:PlannedDate[exists(/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeSubType/cbc:SubTypeCode[contains('7 8 9', text())])]" ;
        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-Root" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/ProcessPlanningTerm" ;
        rr:class epo:ProcessPlanningTerm
    ] ;
    rr:predicateObjectMap [
        rdfs:label "BT-127" ;
        rdfs:comment "Estimated Contract Notice Publication Date for Procedure" ;
        rr:predicate epo:hasEstimatedContractNoticePublicationDate ;
        rr:objectMap [
            rml:reference "." ;
            rr:datatype xsd:date
        ] ;
    ] .
