# Variant 7: From LocalLegalBasisWithID/cbc:DocumentDescription (multilingual)
tedm:MG-PlannedProcurement-hasLegalBasisDescription_BT01_v4 a rr:TriplesMap ;
    rdfs:label "MG-PlannedProcurement" ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cac:TenderingTerms/cac:ProcurementLegislationDocumentReference[not(cbc:ID/text()=('CrossBorderLaw','LocalLegalBasis'))]/cbc:DocumentDescription[exists(/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeSubType/cbc:SubTypeCode[contains('1 2 3 4 5 6 E2', text())])]" ;
        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-LocalLegalBasisWithID" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/PlannedProcurement" ;
        rr:class epo:PlannedProcurement
    ] ;
    rr:predicateObjectMap [
        rdfs:label "BT-01(d)-Procedure" ;
        rdfs:comment "Legal basis description (multilingual)" ;
        rr:predicate epo:hasLegalBasisDescription ;
        rr:objectMap [
            rml:reference "if(exists(@languageID)) then . else null" ;
            rml:languageMap [
                fnml:functionValue [
                    rr:predicateObjectMap [
                        rr:predicate idlab-fn:str ;
                        rr:objectMap [ rml:reference "./@languageID" ]
                    ] ,
                    tedm:idlab-fn_executes_lookup ,
                    tedm:idlab-fn_inputFile_language ,
                    tedm:idlab-fn_fromColumn_code ,
                    tedm:idlab-fn_toColumn_code
                ]
            ] ;
        ] ;
    ] .
