        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-IPILotResult" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/InternationalProcurementInstrumentMeasuresInformation${replace(translate(path(../../..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
        rr:class epo:InternationalProcurementInstrumentMeasuresInformation
    ] ;
