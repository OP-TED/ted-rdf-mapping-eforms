# BT-300: Additional Information for PlannedProcurement
tedm:MG-PlannedProcurement-hasAdditionalInformation_ND-ProcedureProcurementScope a rr:TriplesMap ;
    rdfs:label "MG-PlannedProcurement" ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cac:ProcurementProject/cbc:Note[exists(/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeSubType/cbc:SubTypeCode[contains('1 2 3 4 5 6 E2', text())])]" ;
        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-ProcedureProcurementScope" ;
        rml:reference "if (exists(/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeSubType/cbc:SubTypeCode[contains('1 2 3 4 5 6 E2', text())])) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/PlannedProcurement$' || replace(replace(replace(path(/*/cac:ProcurementProject), 'Q\\{[^}]+\\}', ''), '\\[([0-9]+)\\]', '$1'), '/', '_') else null" ;
        rr:class epo:PlannedProcurement
    ] ;
    rr:predicateObjectMap [
        rdfs:label "BT-300-Procedure" ;
        rdfs:comment "Additional information for PlannedProcurement" ;
        rr:predicate epo:hasAdditionalInformation ;
        rr:objectMap [
            rml:reference "if(exists(@languageID)) then . else null" ;
            rml:languageMap [
                fnml:functionValue [
                    rr:predicateObjectMap [
                        rr:predicate idlab-fn:str ;
                        rr:objectMap [ rml:reference "./@languageID" ]
                    ] ,
                    tedm:idlab-fn_executes_lookup ,
                    tedm:idlab-fn_inputFile_language ,
                    tedm:idlab-fn_fromColumn_code ,
                    tedm:idlab-fn_toColumn_code
                ]
            ] ;
        ] ;
    ] .

