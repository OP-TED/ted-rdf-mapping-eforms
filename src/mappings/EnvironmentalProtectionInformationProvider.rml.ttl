@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-not: <http://data.europa.eu/a4g/ontology#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix tedm: <http://data.europa.eu/a4g/mapping/rml/> .

tedm:MG-EnvironmentalProtectionInformationProvider_ND-LotEnvironmentalLegislation a rr:TriplesMap ;
    rdfs:label "MG-EnvironmentalProtectionInformationProvider" ;
    rml:logicalSource [
        rml:iterator "/*/cac:ProcurementProjectLot[cbc:ID/@schemeName='Lot']/cac:TenderingTerms/cac:EnvironmentalLegislationDocumentReference" ;
        rml:referenceFormulation ql:XPath ;
        rml:source "data/source.xml" ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-LotEnvironmentalLegislation" ;
        rr:class epo:EnvironmentalProtectionInformationProvider ;
        rml:reference "if(exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/EnvironmentalProtectionInformationProvider/' || encode-for-uri(concat(cac:IssuerParty/cac:PartyIdentification/cbc:ID, cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName)) else null";
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-301-Lot-EnvironLegis" ;
        rdfs:comment "Connection between AgentInRole and Organization OR ContactPoint" ;
        rr:objectMap [
            rdfs:label "TPO (playedBy)" ;
            rdfs:comment "Connection where IssuerParty is a TouchPoint" ;
            rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/Organization/{cac:IssuerParty/cac:PartyIdentification/cbc:ID}" ;
        ] ;
        rr:objectMap [
            rdfs:label "ORG (playedBy)" ;
            rdfs:comment "Connection where IssuerParty is an Organization" ;
            rr:joinCondition [
                rr:child "if(cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName='organization' or exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'ORG-')])) then cac:IssuerParty/cac:PartyIdentification/cbc:ID else null" ;
                rr:parent "cac:PartyIdentification/cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-Organization_ND-Company ;
        ] ;
        rr:predicate epo:playedBy ;
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-301-Lot-EnvironLegis TPO (hasContactPointInRole)" ;
        rdfs:comment "Connection where IssuerParty is a TouchPoint" ;
        rr:objectMap [
            rr:joinCondition [
                rr:child "if(cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName='touchpoint' or exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'TPO-')])) then cac:IssuerParty/cac:PartyIdentification/cbc:ID else null" ;
                rr:parent "cac:PartyIdentification/cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-ContactPoint_ND-Touchpoint ;
        ] ;
        rr:predicate epo:hasContactPointInRole ;
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-301-Lot-EnvironLegis (contextualisedBy)" ;
        rr:objectMap [
            rr:joinCondition [
                rr:child "../../cbc:ID" ;
                rr:parent "cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-Lot_ND-Lot ;
        ] ;
        rr:predicate epo:contextualisedBy ;
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-120-Lot-EnvironLegis" ;
        rdfs:comment "Connection of MG-EnvironmentalProtectionInformationProvider to MG-EnvironmentalDocumentation under ND-LotEnvironmentalLegislation" ;
        rr:predicate epo:providesDocumentation ;
        rr:objectMap [
            rr:parentTriplesMap tedm:MG-EnvironmentalDocumentation-providesDocumentation-EnvironmentalProtectionInformationProvider_ND-LotEnvironmentalLegislation ;
            rr:joinCondition [
                rr:child "path(.)" ;
                rr:parent "path(../../..)" ;
            ] ;
        ] ;
    ] ;
    tedm:minSDKVersion "1.5.12"
.

tedm:MG-EnvironmentalDocumentation-providesDocumentation-EnvironmentalProtectionInformationProvider_ND-LotEnvironmentalLegislation a rr:TriplesMap ;
    rdfs:label "MG-EnvironmentalDocumentation" ;
    rml:logicalSource [
        rml:source "data/source.xml" ;
        rml:iterator "/*/cac:ProcurementProjectLot[cbc:ID/@schemeName='Lot']/cac:TenderingTerms/cac:EnvironmentalLegislationDocumentReference/cac:Attachment/cac:ExternalReference/cbc:URI" ;
        rml:referenceFormulation ql:XPath
    ] ;
    rr:subjectMap [
        rdfs:label "ND-LotEnvironmentalLegislation" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/EnvironmentalDocumentation${replace(translate(path(../..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
        rr:class epo:EnvironmentalDocumentation
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-120-Lot-EnvironLegis" ;
        rdfs:comment "URL to Environmental Legislation of MG-EnvironmentalDocumentation-providesDocumentation-EnvironmentalProtectionInformationProvider under ND-LotEnvironmentalLegislation" ;
        rr:predicate epo:hasAddressURL ;
        rr:objectMap [
            rml:reference "." ;
            rr:datatype xsd:anyURI
        ] ;
    ] ;
.
