<http://data.europa.eu/a4g/resource/3e47fde5-edfe-4f4f-a130-3486214b23b2-01/Lot/LOT-0000>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/3e47fde5-edfe-4f4f-a130-3486214b23b2-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
