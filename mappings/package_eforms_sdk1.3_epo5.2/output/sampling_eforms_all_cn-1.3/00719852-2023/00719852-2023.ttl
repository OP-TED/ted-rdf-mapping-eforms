  epo:hasAcceleratedProcedureJustification "Hankija lühendab RHS § 93 lg 2 lg 2 alusel pakkumuse esitamise tähtaega. Hankijal ei ole võimalik pakkumuste esitamise miinimumtähtajast kinni pidada põhjendatud kiireloomuliste asjaolude tõttu. Kiireloomulised asjaolud antud hanke puhul on tingitud olukorrast, kus hankija on eelmise samasisulise hanke koostamisel ja menetlemisel olnud hoolas, kuid hange ebaõnnestus hankijast mittesõltuval põhjusel ning vajalik on sisustada juba kasutusele võetud klienditeeninduse ruumid."@et;
  epo:hasAdditionalInformation "."@et;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/d8f63b51-74e5-4a00-84ed-e50c42007bdf-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/d8f63b51-74e5-4a00-84ed-e50c42007bdf-01/Procedure/Identifier/272775>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Avatud hankemenetlus"@et;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/d8f63b51-74e5-4a00-84ed-e50c42007bdf-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/d8f63b51-74e5-4a00-84ed-e50c42007bdf-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/d8f63b51-74e5-4a00-84ed-e50c42007bdf-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
