  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/d8f63b51-74e5-4a00-84ed-e50c42007bdf-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
