<http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/Procedure/6a475368-b61f-4d90-8ac7-e0ef825b7160>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAcceleratedProcedureJustification "Hankija on lühendanud käesoleva avatud hankemenetluse puhul pakkumuste esitamise tähtaega RHS § 93 lg 2 p 2 alusel, sest hankijal ei ole võimalik pakkumuste esitamise miinimumtähtaegadest kinni pidada riigihanke alusdokumentides põhjendatud kiireloomuliste asjaolude tõttu. Arvestades asjaolu, et maagaasi laadimisvarre eeldatav saabumisaeg Paldiskisse on 22.12.2023, on oluline, et leping maagaasi laadimisvarre paigalduseks oleks sõlmitud enne maagaasi laadimisvarre eeldatavat saabumisaega, mistõttu on põhjendatud pakkumuste esitamise tähtaja lühendamine, et tagada õigeaegne hankelepingu sõlmimine ning teenuse osutamise aja algus."@et;
  epo:hasAdditionalInformation "Riigihange ei ole menetluse raames osadeks jaotatud põhjusel, et osadeks jaotamine muudaks Hankelepingu täitmise tehniliselt ülemäära keerukaks, tekiks oht Hankelepingu tähtajalisele ja nõuetekohasele täitmisele seoses vajadusega erinevate osade täitjate tegevuse kooskõlastamiseks"@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/Procedure/Identifier/271858>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasMainFeature "Avatud hankemenetlus"@et;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated true;
  epo:isSubjectToProcedureSpecificTerm <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description "Hanke eesmärgiks on hankelepingu sõlmimine maagaasi laadimisvarre paigaldustöödeks. Tegemist on Paldiskis Lahepera lahte FSRU laevade sildumise ja gaasi sisestusvõimekuse loomiseks rajatud haalamiskaile maagaasi laadimisvarre (koos hüdraulilise jõuseadmega) paigaldamine ning nende ühendamine FSRU kail asuvate paigaldistega."@et;
  dct:title "Maagaasi laadimisvarre (MLA) paigaldustööd II"@et;
  adms:identifier <http://data.europa.eu/a4g/resource/043be082-77c0-436a-a81f-0eefe21ab30f-01/Procedure/Identifier/6a475368-b61f-4d90-8ac7-e0ef825b7160> .

