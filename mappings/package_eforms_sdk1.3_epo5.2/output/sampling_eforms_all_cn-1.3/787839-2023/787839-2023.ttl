  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Sotsiaal- ja eriteenuste erimenetlus"@et;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/ef6f48d4-d242-4550-bc5e-1ecc9bcffb20-01/Lot/LOT-0000>;
