  epo:hasMainFeature "Avatud ideekonkurss"@et;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/05abf496-e2a2-429d-9e31-13adc258f8f2-02/Lot/LOT-0000>;
