  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/c90fbf18-a812-4484-b83e-d6eb26be8a8a-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  dct:description "Käesoleva hankemenetluse esemeks on instrumentide liidese Tartu Observatooriumi 1,5 meetrisele teleskoobile AZT-12. Liides koosneb 0,5x fookuskauguse lühendajast, mis muudab teleskoobi valguskimbu suhtelise ava F/16-st F/8-ks; vähemalt kolme ühendatava mõõteinstrumendi pesaga instrumendivalijast ja nende juurde kuuluvatest fokuseerijatest."@et;
  dct:title "Instrumentide liides 1.5 meetrisele teleskoobile"@et;
  adms:identifier <http://data.europa.eu/a4g/resource/c90fbf18-a812-4484-b83e-d6eb26be8a8a-01/Identifier/LOT-0000> .

