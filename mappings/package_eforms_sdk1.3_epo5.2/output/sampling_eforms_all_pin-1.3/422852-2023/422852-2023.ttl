  epo:foreseesTerm <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Käesolev hankemenetlus ei ole jagatud eraldi osadeks. Teenused ei ole üksteisest eraldatavad, väljatöötatud tarkvaralahendused peavad tagama nende koostoimimise."@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/Procedure/Identifier/267347>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Eelteade tähtaegade lühendamiseks"@et;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/ProcedureTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description "Detsentraliseerimisreformi tulemusena loodi Ukrainas 1439 kogukonda (välja arvatud ajutiselt okupeeritud alade kogukonnad). Vastavalt riigi poliitika prioriteetidele peaks ASC olema igas kogukonnas, sealhulgas nende territoriaalsetes üksustes/ASC administraatorite kaugtöökohtades. Tänase seisuga on haldusteenuste registrisse kantud 2236 haldusteenust. Seoses ASC arvukate pöördumiste ja huviga SC ASC-s töötada, samuti ksutajate arvu ja töökoormuse pideva kasvuga tekkis vajadus luua uue arhitektuuriga IS «Vulyk» (edaspidi Süsteem) tarkvara."@et;
  dct:title "\"Haldusteeninduskeskuse tegevuste automatiseerimise tarkvarakompleks (SC ASC)\" (Ukraina) funktsionaalsusel ja töökogemusel põhineva infosüsteemi „Vulyk“ tarkvara arendustööd"@et .

