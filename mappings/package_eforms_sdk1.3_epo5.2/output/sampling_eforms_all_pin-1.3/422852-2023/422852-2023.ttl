    <http://data.europa.eu/a4g/resource/09597ae2-b0f6-4ce7-b46e-3b52e7f56361-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
