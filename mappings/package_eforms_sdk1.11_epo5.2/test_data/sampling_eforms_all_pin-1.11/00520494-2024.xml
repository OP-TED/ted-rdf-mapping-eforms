                <cbc:Region>anyw-cou</cbc:Region>
                <cac:Country>
                    <cbc:IdentificationCode listName="country">NLD</cbc:IdentificationCode>
                </cac:Country>
            </cac:Address>
        </cac:RealizedLocation>
    </cac:ProcurementProject>
