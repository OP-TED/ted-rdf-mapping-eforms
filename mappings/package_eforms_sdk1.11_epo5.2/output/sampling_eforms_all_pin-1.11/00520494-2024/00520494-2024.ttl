  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/Procedure/Identifier/DJI-KASSASYSTEEM-24>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/ProcedureTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/aac511e2-68a0-4d8f-ade1-940b1de191bc-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description """Binnen DJI kunnen justitiabelen (gedetineerden) producten kopen als aanvulling op de door DJI verstrekte maaltijden, voor persoonlijke hygiëne (deo, zeep, tandpasta, etc.) en rookwaren. De bestellingen worden afgehandeld in 5 distributiecentra (DC) van DJI. De justitiabele gaat niet fysiek naar het DC toe. In deze DC's worden de bestellingen verzameld, verpakt, afgerekend en gedistribueerd naar de inrichtingen. 
Ter ondersteuning van het proces in de DC's wil DJI een nieuw systeem verwerven. Onderdeel van de aanbesteding is het systeem ter ondersteuning van het proces in de DC’s, benodigde hardware voor de DC’s en een webshop die kan worden aangeboden op kiosken om digitaal bestellen, door justitiabelen in penitentiaire inrichtingen, mogelijk te maken.
DJI verwacht dat voor de ondersteuning van het proces in de DC’s maatwerkaanpassingen op bestaande oplossingen nodig zijn in verband met een aantal voor DJI specifieke eisen. 5 distributiecentra en 500 bestelpunten"""@nl;
  dct:title "Boodschappensysteem ten behoeve van DJI"@nl .

