  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/0765fbbd-443f-44b5-ad3d-e3dc2221b8ce-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
