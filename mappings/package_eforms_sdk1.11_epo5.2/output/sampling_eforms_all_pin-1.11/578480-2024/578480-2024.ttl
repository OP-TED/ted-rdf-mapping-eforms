<http://data.europa.eu/a4g/resource/a3b56af7-d7f3-485d-bc0f-b900a91d5587-02/Procedure/0000000-0000-4000-8000-000000000000>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a3b56af7-d7f3-485d-bc0f-b900a91d5587-02/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
