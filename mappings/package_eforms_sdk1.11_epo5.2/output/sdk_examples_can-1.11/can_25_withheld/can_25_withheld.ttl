  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a1d155f6-11bf-4c32-83bf-87aec5457899-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
