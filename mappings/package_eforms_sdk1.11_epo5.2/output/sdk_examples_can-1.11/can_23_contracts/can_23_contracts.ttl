<http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/Lot/LOT-0000>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Pricing is as set out in the Taking Control of Goods (Fees) Regulations 2014. Prices for ancillary service requirements are as stated in the tender documents. Terms and conditions: the Council has opted to use its own terms and conditions. The terms and conditions are as stated in the tender documents."@en;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/Lot/Identifier/DPS%20%E2%80%94%20774>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  dct:description "Wakefield Council is looking to award two services concession contracts under this call-off from the YPO Enforcement Services DPS – 774 in compliance with CCR 16. Under the concession contracts the Council will entrust the provision of the enforcement agency services to concessionaires in relation to debts accruing regarding non-payment of the following: • Council, • Tax Business Rates, • BID Levy, • civil parking enforcement, • overpaid housing benefits debt recovery, • Sundry Income Debt Recovery including High Court Enforcement, • Miscellaneous Debt Recovery together with the following ancillary services, • tracing service. The Council is looking to appoint one supplier for first line referrals and a different supplier for second line referrals under services concession contracts. Successful suppliers must be able to provide all of the above-mentioned services which will be described in more detail in the tender documents to be published under the call for competition. All first line referrals will be awarded to the highest scoring bidder following the evaluation. All second line referrals will be awarded to the 2nd highest scoring bidder."@en;
  dct:title "Concession Contract for the Supply of Enforcement Agency Services (Call-off from the YPO Enforcement Services DPS — 774)"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/Identifier/LOT-0000> .

