  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f4308a76-5393-477c-ba91-f4c9fb8818a6-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
