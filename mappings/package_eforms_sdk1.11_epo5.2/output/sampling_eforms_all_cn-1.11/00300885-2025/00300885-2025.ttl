  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/8aa92d30-a1f6-4c54-ba4a-4a4e585c2f7e-01/ContractTerm$_ContractNotice1_ProcurementProjectLot2>,
    <http://data.europa.eu/a4g/resource/8aa92d30-a1f6-4c54-ba4a-4a4e585c2f7e-01/ContractTerm$_ContractNotice1_ProcurementProjectLot2_ProcurementProject1_RealizedLocation1>,
