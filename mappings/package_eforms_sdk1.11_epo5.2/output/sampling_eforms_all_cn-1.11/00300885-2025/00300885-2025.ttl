<http://data.europa.eu/a4g/resource/8aa92d30-a1f6-4c54-ba4a-4a4e585c2f7e-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesEstimatedContractDuration <http://data.europa.eu/a4g/resource/8aa92d30-a1f6-4c54-ba4a-4a4e585c2f7e-01/ContractDuration$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/works>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasLegalFormRequirement "En cas de réponse commune par constitution d'un groupement momentané d'entreprises (GME), sa forme n'est pas imposée au stade de la candidature mais dans la perspective de l'attribution, le GME retenu pour chaque lot devra privilégier la forme du groupement solidaire ; dans ce cas chacun des membres du GME est engagé financièrement pour la totalité du lot. À défaut sera admis un GME conjoint dont le mandataire est solidaire de chacun des membres du groupement pour ses obligations contractuelles pour l'exécution des travaux du lot considéré. Si nécessaire, une mise au point sera effectuée en préambule à la notification."@fr;
  epo:hasMaximumNumberOfRenewals 0;
  epo:hasPaymentArrangement "L'opération est financée sur le budget général de l'État au titre du Programme 178."@fr;
  epo:hasPerformanceConditions "obligation de résultat "@fr;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

<http://data.europa.eu/a4g/resource/8aa92d30-a1f6-4c54-ba4a-4a4e585c2f7e-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>
