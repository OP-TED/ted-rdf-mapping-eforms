<http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/ChangeInformation$_ContractNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Changes1_Change1>
  a epo:ChangeInformation;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/Notice>;
  epo:hasChangeDescription "The notice clarifies that the procurement documents are published at https://pirkimai.eviesiejipirkimai.lt and https://viesiejipirkimai.lt and that the address for submission of applications and tenders has changed from https://pirkimai.eviesiejipirkimai.lt to https://viesiejipirkimai.lt"@en,
    "Skelbime patikslinta, kad pirkimo dokumentai skelbiami adresu https://pirkimai.eviesiejipirkimai.lt ir https://viesiejipirkimai.lt bei pakeistas paraiškų ir pasiūlymų teikimo adresas iš https://pirkimai.eviesiejipirkimai.lt į https://viesiejipirkimai.lt"@lt;
  epo:hasProcurementDocumentChangeDate "2024-11-28Z"^^xsd:dateTime;
  epo:isProcurementDocumentChanged true;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/Notice/384ddceb-7f82-4185-9e54-d54830fdd0d9-01>;
  epo:relatesToEFormSectionIdentifier <http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/Notice/384ddceb-7f82-4185-9e54-d54830fdd0d9-01/Identifier/LOT-0000> .

<http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/ChangeInformation$_ContractNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Changes1_ChangeReason1>
  a epo:ChangeInformation;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/Notice>;
  epo:hasChangeJustification <http://publications.europa.eu/resource/authority/change-corrig-justification/update-add>;
  epo:hasChangeReasonDescription "The amendment is made taking into account the fact that from 1 December 2024 Lithuanian public procurement will be migrated to the new Central Public Procurement Information System, and also the information on the implementation of the new CPP IS system published by the Public Procurement Service, as well as the recommendations. "@en,
    "Pakeitimas atliekamas atsižvelgiant į tai, kad nuo 2024 m. gruodžio 1 d. Lietuvos viešųjų pirkimų vykdymas perkeliamas į naują Centrinę viešųjų pirkimų informacinę sistemą, taip pat į Viešųjų pirkimų tarnybos paskelbtą informaciją dėl naujosios CVP IS sistemos diegimo ir rekomendacijas. "@lt;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/af535a49-3514-4dcf-a83b-d32cbc424155-01/Notice/384ddceb-7f82-4185-9e54-d54830fdd0d9-01> .

