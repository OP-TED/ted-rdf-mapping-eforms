<http://data.europa.eu/a4g/resource/53c1f8bf-97f5-437b-80f9-2aa90884fc8e-02/ChangeInformation$_ContractNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Changes1>
  a epo:ChangeInformation;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/53c1f8bf-97f5-437b-80f9-2aa90884fc8e-02/Notice>;
  epo:hasChangeDescription """Doplnenie informácií k referenciám na II. časť predmetu zákazky:
Verejný obstarávateľ bude akceptovať aj predloženie referencií pre dodanie a servis emisných automatizovaných meracích systémov (AMS). Vzhľadom k tomu, že ide o stacionárne systémy, kde účel a technologické riešenia AMS sú z hľadiska merania koncentrácie a množstva prachových a plynných znečisťujúcich látok (PZL a TZL) porovnateľné s mobilnými meracími vozidlami. Obe technologické riešenia zabezpečujú presné merania emisií do veľkej miery založené na rovnakých princípoch a veľmi podobné sú aj stavebné úpravy, týkajúce sa inštalácie elektrických a plynových rozvodov preto možno považovať AMS za systém technicky a funkčne podobný mobilným meracím vozidlám. Z tohto dôvodu považuje verejný obstarávateľ uvedenie referencií na AMS za dostatočne preukazujúce odbornú spôsobilosť a technickú kapacitu uchádzača v rámci predmetu zákazky.
"""@sk;
  epo:hasChangeJustification <http://publications.europa.eu/resource/authority/change-corrig-justification/update-add>;
  epo:hasChangeReasonDescription """Doplnenie informácií k referenciám na II. časť predmetu zákazky na základe žiadosti o vysvetlenie súťažných podkladov.
"""@sk;
  epo:hasProcurementDocumentChangeDate "2025-06-23T00:00:00+02:00"^^xsd:dateTime;
  epo:isProcurementDocumentChanged true;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/53c1f8bf-97f5-437b-80f9-2aa90884fc8e-02/Notice/e473dc79-7844-49d6-8ae8-c49a45c5a468-01>;
  epo:relatesToEFormSectionIdentifier <http://data.europa.eu/a4g/resource/53c1f8bf-97f5-437b-80f9-2aa90884fc8e-02/Notice/e473dc79-7844-49d6-8ae8-c49a45c5a468-01/Identifier/LOT-0002> .

