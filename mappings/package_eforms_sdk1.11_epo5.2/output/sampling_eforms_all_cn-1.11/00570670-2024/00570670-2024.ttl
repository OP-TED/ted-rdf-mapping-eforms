    <http://data.europa.eu/a4g/resource/cc8d913e-0344-4cfd-bfdf-821b27b15006-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>;
