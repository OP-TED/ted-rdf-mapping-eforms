<http://data.europa.eu/a4g/resource/80d0ba1c-3b72-4b01-a35e-f493fc9ca731-02/ContractModificationInformation$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_ContractModification1>
  a epo:ContractModificationInformation;
  epo:concernsContractAmendment <http://data.europa.eu/a4g/resource/80d0ba1c-3b72-4b01-a35e-f493fc9ca731-02/ContractAmendment$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_ContractModification1>;
  epo:hasModificationDescription "Wydłużenie terminu realizacji zadania inwestycyjnego do 31.12.2025 r., przedłużenie terminu realizacji wsparcia technicznego do 15.12.2024 r.,"@pl;
  epo:hasModificationJustification <http://publications.europa.eu/resource/authority/modification-justification/mod-rev>;
  epo:hasModificationReasonDescription "W trakcie  realizacji  Umowy  stało  się  niemożliwe  wykonanie  zgodnie  z  uzgodnionym harmonogramem  realizacji  zakresu  Umowy,  migracji Systemu BSS Kontron do Systemu NSS Nokia i uruchomienie funkcjonalności A-flex i Gb-flex, z uwagi na okoliczności nadzwyczajne, których Zamawiający, działając z należytą starannością, nie mógł przewidzieć, tj. przedłużające się negocjacje w ramach powiązanego z  przedmiotowym  postępowaniem,  postępowania  zakupowego zmierzającego do zawarcia umowy na przełączenie posiadanych przez Zamawiającego Systemów BSS Kontron i BSS Nokia do Systemu NSS Nokia."@pl .

