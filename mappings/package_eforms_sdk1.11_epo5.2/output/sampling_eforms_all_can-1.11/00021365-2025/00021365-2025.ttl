<http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>,
    <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/ContractTerm$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_NoticeResult1_LotResult1_PayerParty1>;
  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/GreenProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType2>,
    <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/SocialProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType3>;
  epo:hasAdditionalInformation "En application de l'article L2112-2 du Code de la commande publique, le marché comporte une action permettant la formation d'un ou plusieurs jeunes à besoin spécifique, de 16 à 25 ans, suivie par un référent du ministère de !'Éducation nationale, de l'Enseignement supérieur et de la Recherche. Dans le cahier des charges, cette exigence se présente sous la forme d'un volume horaire minimal de 900 heures. Ce volume horaire minimal exigé est à réaliser pendant la période ferme du marché ou pendant la période de reconduction du marché. Dans le cadre de la politique d'achat responsable du ministère de !'Éducation nationale, de l'Enseignement supérieur et de la Recherche, le présent marché met en oeuvre une clause environnementale selon les modalités décrites dans le cahier des clauses administratives particulières. "@fr;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/MonetaryValueLot$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/Lot/Identifier/MEN-SG-AOO-24043-Extension%20DELL>;
  epo:hasLaunchFrameworkAgreementMaximumValue <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/LotValueEstimateExtension$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/ce11836b-0f2a-40f8-aed2-e2ed2ab05364-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
