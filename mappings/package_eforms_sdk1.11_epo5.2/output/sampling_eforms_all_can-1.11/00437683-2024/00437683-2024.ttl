  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/c5930a96-4853-49dc-b8cc-818a3ddc520a-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
