<http://data.europa.eu/a4g/resource/c5930a96-4853-49dc-b8cc-818a3ddc520a-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/c5930a96-4853-49dc-b8cc-818a3ddc520a-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/c5930a96-4853-49dc-b8cc-818a3ddc520a-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
