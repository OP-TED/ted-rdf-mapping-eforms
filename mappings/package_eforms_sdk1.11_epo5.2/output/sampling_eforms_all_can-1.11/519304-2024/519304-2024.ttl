    <http://data.europa.eu/a4g/resource/bbb94a16-00ba-4d7e-86d4-6cc4e6ceb986-01/Lot/LOT-0005>,
    <http://data.europa.eu/a4g/resource/bbb94a16-00ba-4d7e-86d4-6cc4e6ceb986-01/Lot/LOT-0006>,
