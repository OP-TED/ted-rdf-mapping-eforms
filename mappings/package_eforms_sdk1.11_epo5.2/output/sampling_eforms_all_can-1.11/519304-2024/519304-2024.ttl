  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/bbb94a16-00ba-4d7e-86d4-6cc4e6ceb986-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
