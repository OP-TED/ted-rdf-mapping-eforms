  a epo:LotGroup;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/83c256ae-0712-4788-8b59-668313769913-01/PurposeLotGroupEstimatedValue$_ContractAwardNotice1_ProcurementProjectLot3_ProcurementProject1_RequestedTenderTotal1>;
