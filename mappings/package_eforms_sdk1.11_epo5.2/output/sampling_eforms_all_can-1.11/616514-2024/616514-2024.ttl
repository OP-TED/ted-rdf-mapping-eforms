<http://data.europa.eu/a4g/resource/83c256ae-0712-4788-8b59-668313769913-01/LotGroupAwardCriterion$_ContractAwardNotice1_ProcurementProjectLot3_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
