  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/e4830aad-dd26-450b-9d5b-afe5c63b7c7c-01/MonetaryValueLot$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/e4830aad-dd26-450b-9d5b-afe5c63b7c7c-01/Lot/Identifier/n.v.t.>;
