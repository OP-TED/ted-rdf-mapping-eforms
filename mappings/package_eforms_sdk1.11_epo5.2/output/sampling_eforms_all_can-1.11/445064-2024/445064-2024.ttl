  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/db6baac8-6415-47c3-88a8-ef57e844a4f4-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
