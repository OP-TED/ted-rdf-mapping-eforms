<http://data.europa.eu/a4g/resource/afbff793-1041-4dba-8c17-de161191474e-01/Procedure/9bd37917-9b5e-4658-8055-6f6d5ba16d72>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/afbff793-1041-4dba-8c17-de161191474e-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/afbff793-1041-4dba-8c17-de161191474e-01/Procedure/Identifier/2020-605>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/afbff793-1041-4dba-8c17-de161191474e-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/afbff793-1041-4dba-8c17-de161191474e-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  dct:description "Les travaux s'inscrivent dans le cadre de la réalisation de l'opération de site pilote de la Bassée. L'aménagement hydraulique de l'opération du Site pilote se situe dans le sud du département de Seine-et-Marne, à la jonction des territoires de quatre communes : Balloy, Châtenay-sur-Seine, Egligny, et Gravon. Les travaux portent sur la réalisation de digues et des aménagements intérieurs du site pilote. Les travaux de ce lot consistent à : - créer une digue de 7 600 ml et d'une hauteur moyenne de 2,50 m, dont l'objectif est de former un espace de stockage temporaire des eaux de crues de la Seine ; - construire deux réseaux de drainage actif et un déversoir de sécurité ; - aménager les chemins situés à l'intérieur du site, les fossés de ressuyage nécessaires ainsi que les fossés de connexion inter-étangs."@fr;
  dct:title "OPERATION DE SITE PILOTE DE LA BASSEE Travaux portant sur la réalisation de digues et des aménagements intérieurs du site pilote"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/afbff793-1041-4dba-8c17-de161191474e-01/Procedure/Identifier/9bd37917-9b5e-4658-8055-6f6d5ba16d72> .

