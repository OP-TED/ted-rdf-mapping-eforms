    <http://data.europa.eu/a4g/resource/30fbcfbe-a372-4f70-9ecb-f786545fbc19-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/30fbcfbe-a372-4f70-9ecb-f786545fbc19-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/30fbcfbe-a372-4f70-9ecb-f786545fbc19-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/30fbcfbe-a372-4f70-9ecb-f786545fbc19-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """Predmetom zákazky bolo dodanie tovaru - mliečnych výrobkov a výrobkov z vajec pre potreby Fakultnej nemocnice Trenčín vrátane dopravy na miesto určenia. Kvalita tovaru musí zodpovedať príslušnej štátnej alebo vnútropodnikovej norme, tovar musí byť zdravotne a hygienicky nezávadný, v I. akostnej triede.
Zákazka bola vyhlásená v rámci zriadeného dynamického nákupného systému na Potraviny pre FN Trenčín. 
Podrobná špecifikácia predmetu zákazky, presný rozsah ako aj ostatné doplňujúce informácie boli uvedené vo výzve v rámci zriadeného DNS, ktorá bola zaslaná všetkým kvalifikovaným záujemcom."""@sk;
  dct:title "DNS- Potraviny pre Fakultnú nemocnicu Trenčín "@sk;
  adms:identifier <http://data.europa.eu/a4g/resource/30fbcfbe-a372-4f70-9ecb-f786545fbc19-01/Identifier/LOT-0001> .

