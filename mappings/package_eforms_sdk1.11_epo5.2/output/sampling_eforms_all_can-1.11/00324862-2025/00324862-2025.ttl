  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/30fbcfbe-a372-4f70-9ecb-f786545fbc19-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
