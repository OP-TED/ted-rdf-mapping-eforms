<http://data.europa.eu/a4g/resource/4d3e9af5-8896-4fcb-ab49-01061ec3d068-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/4d3e9af5-8896-4fcb-ab49-01061ec3d068-01/ReviewProcedureInformationProvider/ORG-0002>;
