<http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Procedure/9a77e721-2cb6-4cd1-8760-b004b23fe2c5>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Procedure/Identifier/EWP-3%2F23>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Das Verfahren wird als Bieterverfahren mit elektronischer Auktion auf Grundlage der Verordnung der Bundesministerin für Klimaschutz, Umwelt, Energie, Mobilität, Innovation und Technologie über das Pfand für Einweggetränkeverpackungen aus Kunststoff oder Metall (Pfandverordnung für Einweggetränkeverpackungen), BGBl. II Nr. 283/2023 idgF durchgeführt.Die EWP geht aufgrund ihrer Ausgestaltung und internen Organisation als Tochtergesellschaft der jeweiligen Interessenvertretungen davon aus, kein öffentlicher Auftraggeber im Sinne des Bundesvergabegesetz 2018 (BGBl I 65/2018 idgF) zu sein."@de;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-mult>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Lot/LOT-0002>,
    <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Lot/LOT-0003>,
    <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Lot/LOT-0004>,
    <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Lot/LOT-0005>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description "Strukturiertes Bestbieterverfahren mit elektronischer Auktion zur Beschaffung Leistungen im Bereich Rücknahmelogistik von Einwegpfandgebinden aufgrund bestehender Lieferlogistik. Die Vergabe im Bieterverfahren erfolgt in 5 Losen:- Los 1 „SPAR“- Los 2 „REWE I“- Los 3 „REWE II“- Los 4 „HOFER“- Los 5 „LIDL“"@de;
  dct:title "EWP - Rücknahmelogistik Einwegpfandgebinde aufgrund bestehender Lieferlogistik"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/1b3188cf-5a1c-4338-a6da-30ec1aaa76bc-01/Procedure/Identifier/9a77e721-2cb6-4cd1-8760-b004b23fe2c5> .

