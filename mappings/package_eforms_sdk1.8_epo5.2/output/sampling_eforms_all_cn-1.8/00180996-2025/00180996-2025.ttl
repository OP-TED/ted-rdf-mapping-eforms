  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/a4e83b61-4069-4b9c-b1b9-93174ed16e04-01/ReviewProcedureInformationProvider/ORG-0004>;
