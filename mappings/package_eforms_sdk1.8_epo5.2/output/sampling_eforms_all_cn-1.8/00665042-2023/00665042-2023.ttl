<http://data.europa.eu/a4g/resource/abf7f394-14e9-467a-b0a0-de78fa006d69-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering false;
  epo:hasEPayment false;
  epo:hasLegalFormRequirement "Pretendentam pēc savas izvēles jāizveido personālsabiedrība vai jāslēdz sabiedrības līgums"@lv;
  epo:hasPaymentArrangement "Saskaņā ar iepirkuma līguma projektu"@lv;
  epo:hasPerformanceConditions "Saskaņā ar iepirkuma tehnisko specifikāciju un iepirkuma līguma projektu. Gadījumā, ja norādītajā termiņā Pakalpojumu apmaksai nav izmantota Līguma kopējā summa pilnā apmērā, pēc Pasūtītāja ierosinājuma, Pusēm par to noslēdzot rakstisku vienošanos, Līguma darbības termiņš var tikt pagarināts par termiņu līdz 24 (divdesmit četriem), līdz brīdim, kad ir izlietota Līguma kopējā summa, ievērojot, ka kopējais Līguma izpildes termiņš nepārsniedz 60 (sešdesmit) mēnešus."@lv;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

