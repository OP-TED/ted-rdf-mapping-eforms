  epo:hasReceiptTenderDeadline "2023-11-09T10:00:00.0000000+02:00"^^xsd:dateTime;
  epo:hasTenderValidityDuration <http://data.europa.eu/a4g/resource/7b2c597d-9faf-424e-825f-589787f337e4-01/SpecificDuration$_ContractNotice1_ProcurementProjectLot2_TenderingTerms1_TenderValidityPeriod1>;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:isAdvancedElectronicSignatureRequired false;
  epo:isGuaranteeRequired true;
  epo:isMultipleTenderSubmissionAllowed false .

