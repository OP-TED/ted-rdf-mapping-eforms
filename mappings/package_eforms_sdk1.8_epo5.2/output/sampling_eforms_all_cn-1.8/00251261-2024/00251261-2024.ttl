<http://data.europa.eu/a4g/resource/cbaa672c-9544-4b40-8363-a8575ecf2fbe-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
  epo:hasFixedValue 40.0;
  epo:hasFixedValueType <http://publications.europa.eu/resource/authority/number-fixed/fix-unit>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/per-exa>;
  cccev:weight 40.0;
  dct:description """plan van aanpak volledige project (10 % - 4 punten)
- gebruiksvriendelijkheid van het geboden integratieplatform voor het interne IT Team (effort om zelf een aanbieder en afnemer te creëren op het platform) (15 % - 6 punten)
- beoordeling architectuur en meer bepaald hoe in de oplossing wordt omgegaan met volgende componenten (50 % - 20 punten)
- data opslag
- data model
- communicatie laag
- data verwerking
- authenticatie en autorisatie
- Rapportage
-Beoordeling van ontwikkelcapaciteit van de aanbieder aan de hand van de 2 POCS (25 % - 10 punten)
 TOTAAL 40 %
"""@nl;
  skos:prefLabel "Kwaliteit voorgestelde oplossing"@nl .

