  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/dba92d7e-5c09-4b7a-a480-0c779ee728d3-01/ReviewProcedureInformationProvider/ORG-0002>;
