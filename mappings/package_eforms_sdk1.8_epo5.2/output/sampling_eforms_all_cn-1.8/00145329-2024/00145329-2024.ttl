  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/960b6934-1e3f-4701-a50a-3305b0a74d99-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
