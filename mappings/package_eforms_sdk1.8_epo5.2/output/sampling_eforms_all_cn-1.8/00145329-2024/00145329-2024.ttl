  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/works>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering false;
  epo:hasEPayment false;
  epo:hasLegalFormRequirement """U skladu s točkom 8.1. DoN Dio A - Upute.
Postupak javne nabave uključuje sklapanje Ugovora o javnoj nabavi s rokom izvršenja od 27 mjeseci od potpisa Ugovora o javnoj nabavi (dalje u tekstu: Ugovor).
Prijedlog teksta Ugovora dan je u DoN Dio F.
Ugovor se sklapa u pisanom obliku u roku od 90 dana od izvršnosti Naručiteljeve Odluke o odabiru. 
Ugovor stupa na snagu kada istog potpišu obje ugovorne strane s datumom zadnjeg potpisa."""@hr;
  epo:hasMaximumNumberOfRenewals 0;
  epo:hasPaymentArrangement "Prema Dokumentaciji o nabavi"@hr;
  epo:hasPerformanceConditions "Prema Dokumentaciji o nabavi."@hr;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no> .

