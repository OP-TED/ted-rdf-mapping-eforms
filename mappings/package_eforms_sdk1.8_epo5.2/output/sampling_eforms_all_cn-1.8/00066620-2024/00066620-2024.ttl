<http://data.europa.eu/a4g/resource/70027ec7-6729-432f-82e2-18a5529b8fb0-01/ChangeInformation$_ContractNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Changes1>
  a epo:ChangeInformation;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/70027ec7-6729-432f-82e2-18a5529b8fb0-01/Notice>;
  epo:hasChangeDescription "Izmjena troškovnika - Naručitelj mijenja troškovnik za Grupu 2 zbog usklađivanja s nazivom stručnjaka u Dokumentaciji o nabavi."@hr,
    """Opis cjelokupnog predmeta nabave (na razini postupka) - Naručitelj mijenja odredbu o prisutstvu stručnjaka na lokaciji naručitelja. 
Stručnjaci traženi u Grupi 1 i Grupi 2 su dužni 80% vremena biti na lokaciji naručitelja u odnosu na procijenjeni broj sati rada pojedinog stručnjaka kako je definirano u Troškovniku za pojedinu grupu. U slučaju povećanja broja sati angažmana pojedinog stručnjaka u odnosu na definirane okvirne količine u trenutku objave ove Dokumentacije o nabavi, Naručitelj će traženi postotak rada na lokaciji naručitelja i dalje gledati u odnosu na prvotno definiran broj sati rada u Troškovniku za pojedinu grupu u trenutku objave Dokumentcije o nabavi."""@hr,
    "Ostalo - Naručitelj mijenja prilog Stručnjaci zbog dodatnog opisa profila traženih dodatnih stručnjaka."@hr,
    "Ostalo - Usklađivanje kriterija za kvalitativni odabir s dokumentom Stručnjaci."@hr;
  epo:hasChangeJustification <http://publications.europa.eu/resource/authority/change-corrig-justification/cor-buy>;
  epo:hasChangeReasonDescription "Usklađivanje kriterija za kvalitativni odabir s dokumentom Stručnjaci."@hr;
  epo:hasProcurementDocumentChangeDate "2024-02-01T00:00:00+01:00"^^xsd:dateTime;
  epo:isProcurementDocumentChanged true;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/70027ec7-6729-432f-82e2-18a5529b8fb0-01/Notice/36e7e1f8-47e2-4fab-9d18-61e2605fd2de-01>;
  epo:relatesToEFormSectionIdentifier <http://data.europa.eu/a4g/resource/70027ec7-6729-432f-82e2-18a5529b8fb0-01/Notice/36e7e1f8-47e2-4fab-9d18-61e2605fd2de-01/Identifier/PROCEDURE> .

