<http://data.europa.eu/a4g/resource/a5056258-aee9-4f00-afb3-071b3eb60aab-02/AccessTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>
  a epo:AccessTerm;
  epo:definesOfflineAccessProvider <http://data.europa.eu/a4g/resource/a5056258-aee9-4f00-afb3-071b3eb60aab-02/OfflineAccessProvider/ORG-0001organization>;
