<http://data.europa.eu/a4g/resource/aad6b79c-4be6-43d9-a6c7-2c735430e72c-01/Procedure/153f2445-69fd-4242-968c-66db257aeab7>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/aad6b79c-4be6-43d9-a6c7-2c735430e72c-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/aad6b79c-4be6-43d9-a6c7-2c735430e72c-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/aad6b79c-4be6-43d9-a6c7-2c735430e72c-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/aad6b79c-4be6-43d9-a6c7-2c735430e72c-01/Procedure/Identifier/11%2F25>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "134/2016 Sb. / Zákon o zadávání veřejných zakázek"@cs,
    "32014L0024 / Směrnice Evropského parlamentu a Rady 2014/24/EU ze dne 26. února 2014 o zadávání veřejných zakázek a o zrušení směrnice 2004/18/ES"@cs;
  epo:hasMainFeature """Užší řízení zahájené dle § 58 odst. 2 ZZVZ odesláním předběžného oznámení podle § 34 ZZVZ k uveřejnění způsobem podle § 212 ZZVZ, jimž zadavatel vyzývá k projevení předběžného zájmu dodavatelů. V tomto případě zadavatel předběžným oznámením splní povinnosti, pro jejichž splnění ZZVZ jinak vyžaduje odeslání oznámení o zahájení zadávacího řízení.
Zadavatel písemně vyzve všechny účastníky zadávacího řízení, kteří vyjádřili předběžný zájem, k podání žádostí o účast, a to všechny současně. Výzva k podání žádosti o účast bude obsahovat náležitosti stanovené v příloze č. 6 k ZZVZ. V den odeslání Výzvy k podání žádostí o účast zadavatel v souladu s § 96 odst. 1 ZZVZ uveřejní na profilu zadavatele Zadávací dokumentaci.
Výhrada zadavatele: Zadavatel stanovuje podmínku, že nepřipustí podání žádostí o účast těm dodavatelům, kteří nevyjádřili předběžný zájem podle § 58 odst. 5 ZZVZ. Vyjádření předběžného zájmu tedy představuje nezbytný předpoklad pro možnou účast dodavatele v zadávacím řízení."""@cs;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/aad6b79c-4be6-43d9-a6c7-2c735430e72c-01/Lot/LOT-0001>;
