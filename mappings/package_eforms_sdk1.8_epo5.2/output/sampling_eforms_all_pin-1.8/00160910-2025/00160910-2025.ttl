  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/fb27af6e-6af7-4054-9a42-24a126846762-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
