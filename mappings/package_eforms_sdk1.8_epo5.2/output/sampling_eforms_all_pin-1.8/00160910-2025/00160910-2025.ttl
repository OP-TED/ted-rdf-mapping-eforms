  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/fb27af6e-6af7-4054-9a42-24a126846762-01/Procedure/Identifier/CSN%201%2F2025>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "134/2016 Sb. / Zákon o zadávání veřejných zakázek"@cs,
    "32014L0024 / Směrnice Evropského parlamentu a Rady 2014/24/EU ze dne 26. února 2014 o zadávání veřejných zakázek a o zrušení směrnice 2004/18/ES"@cs;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/fb27af6e-6af7-4054-9a42-24a126846762-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/fb27af6e-6af7-4054-9a42-24a126846762-01/Lot/LOT-0002>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/fb27af6e-6af7-4054-9a42-24a126846762-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/fb27af6e-6af7-4054-9a42-24a126846762-01/ProcedureTerm$_PriorInformationNotice1_TenderingTerms1_LotDistribution1>;
  dct:description "Předmětem plnění zadávané veřejné zakázky bude uzavření dvou (2) rámcových dohod na zajištění komplexních dodávek kancelářského papíru s poskytnutím a bez poskytnutí náhradního plnění pro potřeby příspěvkových organizací HMP ve smyslu pověřujících zadavatelů, a to po dobu dvanácti (12) po sobě jdoucích měsíců. Plnění bude probíhat na základě aktuálních potřeb. Součástí předmětu plnění bude i doprava do místa plnění, balení zboží standardním způsobem a vykládka z dopravního prostředku, to vše dle zadávacích podmínek. Podrobnosti budou uvedeny v zadávací dokumentaci."@cs;
  dct:title "Dodávky kancelářského papíru pro potřeby příspěvkových organizací hl. m. Prahy"@cs .

