<http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/Procedure/0000000-0000-4000-8000-000000000000>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32009L0081>;
  epo:hasLegalBasisDescription "134/2016 Sb. / Zákon o zadávání veřejných zakázek"@cs,
    "32009L0081 / Směrnice Evropského parlamentu a Rady 2009/81/ES ze dne 13. července 2009 o koordinaci postupů při zadávání některých zakázek na stavební práce, dodávky a služby zadavateli v oblasti obrany a bezpečnosti a o změně směrnic 2004/17/ES a 2004/18/ES"@cs;
  epo:hasMainFeature "Dodavatelé v první fázi zadávacího řízení podávají žádosti o účast, ve kterých prokazují kvalifikaci. Kvalifikované dodavatele následně zadavatel vyzve k podání nabídek. "@cs;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/ProcedureTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/be8e3326-bd24-41f6-993a-767de2034290-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description "Předmětem je vývoj, implementace a provoz nového informačního systému elektronické lustrace v evidenci vězněných osob pro oprávněné žadatele. Cíle: elektronizace zpřístupnění údajů z evidencí vedených o vězněných osobách za splnění práv a podmínek poskytování údajů uvedených v právních předpisech, zefektivnit činnost Vězeňské služby a urychlení procesu poskytování údajů oprávněným subjektům. Dojde k propojení databáze údajů replikovaných, nikoliv přímých, z agendového informačního systému Vězeňské služby (VIS). Implementací systému se očekává schopnost informačního systému nabízet digitální služby v oblasti e-Justice pro organizace činné v oboru spravedlnosti. Klíčovou službou je elektronizovaná služba S15828 – Poskytování údajů z evidence vězněných osob. Služba bude také mimo jiné součástí Portálu občana pro řešení životní situace ve vhodné a uživatelsky přívětivé podobě."@cs;
  dct:title "IS LOSOOS – dodávka a vývoj informačního systému"@cs .

