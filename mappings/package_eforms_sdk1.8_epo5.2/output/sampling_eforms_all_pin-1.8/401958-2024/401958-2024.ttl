<http://data.europa.eu/a4g/resource/cb62a8a3-7050-48f2-b674-0eb2de06b727-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/cb62a8a3-7050-48f2-b674-0eb2de06b727-01/ReviewProcedureInformationProvider/ORG-0002>;
