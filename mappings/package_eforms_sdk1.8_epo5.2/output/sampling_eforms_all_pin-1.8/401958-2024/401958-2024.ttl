  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/cb62a8a3-7050-48f2-b674-0eb2de06b727-01/Interval$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering true;
  epo:hasEPayment true;
  epo:hasOptionsDescription "Zadavatel si v souladu s § 100 odst. 1 ZZVZ vyhradit změnu závazku ze smlouvy na veřejnou zakázku. Termín požadovaného zahájení služeb je v interakci s rozhodnutím zadavatele změnit své sídlo, tj. přestěhovat se do jiné lokality/budovy s výhledem do 1.2.2025. Začátek služby a nové sídlo zadavatele, tj. místo poskytování služby bude upřesněno před podpisem smlouvy. Zahájení plnění smlouvy připadne na termín v intervalu: 1.12.2024 - 1.2.2025. Z této změny/výhrady neplynou žádné více náklady spojené s poskytováním služby. "@cs;
  epo:hasPaymentArrangement "Budou definovány v závazných obchodních podmínkách"@cs;
  epo:hasRenewalDescription "termín ukončení smlouvy je neměnný"@cs;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/not-known> .

