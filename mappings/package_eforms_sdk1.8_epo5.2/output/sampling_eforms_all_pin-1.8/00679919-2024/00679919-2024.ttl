  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/73fa1018-cce2-4346-a974-c2721f0c1ead-01/ReviewProcedureInformationProvider/ORG-0002>;
