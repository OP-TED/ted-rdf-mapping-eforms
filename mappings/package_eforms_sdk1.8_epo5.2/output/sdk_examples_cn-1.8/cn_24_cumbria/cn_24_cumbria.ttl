    <http://data.europa.eu/a4g/resource/6bc75979-ce6c-46eb-81a6-eee543697dec-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/6bc75979-ce6c-46eb-81a6-eee543697dec-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>;
  epo:usesChannel <http://data.europa.eu/a4g/resource/6bc75979-ce6c-46eb-81a6-eee543697dec-01/Channel$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """The Council plans to establish a framework of suppliers who can offer an effective, timely and cost effective payroll and HR administration service to Non-Cheque Book Maintained Schools in Cumbria.
				Currently there are 180 schools who plan to initially use this framework which are predominantly primary schools and range in size of staffing numbers however numbers may change subject to individual school needs.
				It is envisaged that between four and six suppliers will be awarded onto the framework. Please note that any supplier scoring less than 50 % of the quality marks available will not be awarded a place on the framework.
				Further competitions will be conducted under the framework by individual schools (or by the Council on behalf of individual schools) and these will be awarded on price alone.
			"""@en;
  dct:title "School Payroll and HR Admin Services"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/6bc75979-ce6c-46eb-81a6-eee543697dec-01/Identifier/LOT-0000> .

