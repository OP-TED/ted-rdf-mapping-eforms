<http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/Procedure/57f65493-d11d-4ad4-8bbe-1ec0efb4b84b>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/Procedure/Identifier/284266>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description "В предмета на поръчка е предвидено да се извърши проектиране, изработка, доставка, монтаж, интегриране, осигуряване на качеството, настройка и въвеждане в експлоатация, изпитания, авторски надзор, обучение, документация гаранционно обслужване и други дейности, необходими за предоставяне на действащ  ПТК-ВУ на СВРК на 5ЕБ с лицензиран софтуер, осигуряващ безопасна работа на РИ (реакторната инсталация) при нива на мощност до 104% от номиналната, съгласно изискванията на Технологичния регламент."@bg;
  dct:title "Замяна на програмно-технически комплекс горно ниво (ПТК-ВУ) на системата за вътрешнореакторен контрол (СВРК) на 5 ЕБ и доставка на комплекса програми APA-H (ALPHA-H, PHOENIX-H, ANC-H)"@bg;
  adms:identifier <http://data.europa.eu/a4g/resource/f520ab0a-28d8-4970-84c9-1363d70e476d-01/Procedure/Identifier/57f65493-d11d-4ad4-8bbe-1ec0efb4b84b> .

