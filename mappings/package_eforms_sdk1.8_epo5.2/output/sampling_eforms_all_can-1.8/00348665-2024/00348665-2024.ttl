<http://data.europa.eu/a4g/resource/2c1b90d3-c06b-400c-8d99-90758cd206c1-01/Lot/LOT-0000>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/2c1b90d3-c06b-400c-8d99-90758cd206c1-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>;
