<http://data.europa.eu/a4g/resource/e3b233fd-3a74-484f-9f6c-eafa171e087b-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
  epo:hasFixedValue 286.0;
  epo:hasFixedValueType <http://publications.europa.eu/resource/authority/number-fixed/fix-unit>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/per-exa>;
  cccev:weight 50.0;
  dct:description "V rámci dílčího hodnotícího kritéria A. Zkušenosti účastníka budou hodnoceny účastníkem uvedené počty realizovaných školení v členění na vzdělávací aktivity tvořící předmět plnění této Veřejné zakázky. Blíže viz zadávací podmínky. "@cs;
  skos:prefLabel """A. Zkušenosti účastníka. váha 50%
"""@cs .

<http://data.europa.eu/a4g/resource/e3b233fd-3a74-484f-9f6c-eafa171e087b-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
  epo:hasFixedValue 286.0;
  epo:hasFixedValueType <http://publications.europa.eu/resource/authority/number-fixed/fix-unit>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/per-exa>;
  cccev:weight 50.0;
  dct:description "V rámci dílčího hodnotícího kritéria B. Flexibilita účastníka budou hodnoceny účastníkem uvedené počty školitelů/lektorů, které je účastník schopen nabídnout (minimálně zajistit/mít k dispozici) k jednotlivých vzdělávacím aktivitám, a které budou splňovat požadavky zadavatele na jejich zkušenosti – tj. zkušenost s realizací daného kurzu alespoň 1 rok.  Bližší informace viz zadávací podmínky. "@cs;
  skos:prefLabel "flexibilita účastníka - váha 50%"@cs .

<http://data.europa.eu/a4g/resource/e3b233fd-3a74-484f-9f6c-eafa171e087b-01/AwardDecision/2024-06-04%2B02%3A00>
  a epo:AwardDecision;
  epo:comprisesAwardOutcome <http://data.europa.eu/a4g/resource/e3b233fd-3a74-484f-9f6c-eafa171e087b-01/LotAwardOutcome/RES-0001>;
