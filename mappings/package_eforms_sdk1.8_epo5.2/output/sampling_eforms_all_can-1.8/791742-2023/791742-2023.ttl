    <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>,
    <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion3>,
    <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion4>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """Predmet nabave je pružanje javnih govornih, mješovitih i podatkovnih usluga te dopunske i pomoćne usluge u pokretnoj elektroničkoj komunikacijskoj mreži, u tuzemstvu i inozemstvu (roaming), zajedno s isporukom elektroničkih kartica (SIM kartice) za korištenje tih usluga, a kako je to detaljno specificirano u Tehničkoj specifikaciji.

Predmet nabave uključuje pretplatničke brojeve koje korisnik ima ugovorene sa (do)sadašnjim operatorom, a nastavit će ih koristiti, te nove pretplatničke brojeve potrebne korisniku tijekom trajanja okvirnog sporazuma.

U slučaju da ugovaratelj ne bude dosadašnji operator, ugovaratelj će sve pretplatničke brojeve ugovorene s dosadašnjim operatorom za koje pojedini korisnik to pisano zatraži, prenijeti u svoju pokretnu elektroničku komunikacijsku mrežu, sukladno Pravilniku o prenosivosti broja (Narodne novine, broj 24/15, 71/16, 124/19 i 76/22)."""@hr;
  dct:title "ELEKTRONIČKE KOMUNIKACIJSKE USLUGE U POKRETNOJ MREŽI - ZDRAVSTVENE USTANOVE"@hr;
  adms:identifier <http://data.europa.eu/a4g/resource/997eb73c-99ba-4015-a4aa-5e958947f608-01/Identifier/LOT-0000> .

