  epo:foreseesTerm <http://data.europa.eu/a4g/resource/9f3c1b2d-85f5-4ef6-8bf1-72e51bb7511d-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
