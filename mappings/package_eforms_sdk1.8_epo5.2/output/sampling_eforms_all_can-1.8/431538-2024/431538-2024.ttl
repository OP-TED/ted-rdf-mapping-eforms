  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
