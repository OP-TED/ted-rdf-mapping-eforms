  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/GreenProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType1>,
    <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/SocialProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType2>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/Lot/Identifier/T-PF-1423332>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/f5a89883-6350-4cbf-8c9d-4f4152fe4fc4-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  dct:description """Rénovation de l'éclairage public :
- renouvellement de lanternes vétustes,
- renouvellement de candélabres vétustes le cas échéant,
- suppression et remplacement des réseaux aériens (fils nus ou neutre commun Enedis) par un réseau en C.A.T,
- modification ou remplacement d'armoire d'éclairage public, suite aux modifications de puissances installées ou de problème d'appel de courant liées à la LED,
- renouvellement du réseau souterrain ou aérien en cas de non-conformité électrique ou de modification de schéma d'alimentation.
Il s'agit d'un accord-cadre mixte à bons de commande et à marchés subséquents multi-attributaires avec maxi.
Nombre maxi d'attributaires : 2
Maxi : 7 000 000 euro(s) HT/an pour les deux attributaires.
L'accord-cadre est conclu pour une durée de 1an, renouvelable 3 fois.
Le délai d'exécution des bons de commande est de 8 mois. Pour les marchés subséquents, les délais d'exécution seront définis lors de l'émission d'un bon de commande.
Les prestations sont réglées par des prix unitaires, et sont révisables"""@fr;
