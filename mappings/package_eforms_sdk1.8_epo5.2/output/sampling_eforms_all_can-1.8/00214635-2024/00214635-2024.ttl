  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/26fd4fad-71a1-41c3-9dda-7172e37250e9-01/ReviewProcedureInformationProvider/ORG-0002>;
