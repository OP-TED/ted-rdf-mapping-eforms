    <http://data.europa.eu/a4g/resource/b97cdd80-4437-4fa6-8668-702291c58a8e-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/b97cdd80-4437-4fa6-8668-702291c58a8e-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/b97cdd80-4437-4fa6-8668-702291c58a8e-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion2_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/b97cdd80-4437-4fa6-8668-702291c58a8e-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """The main project is to monitor the status and trends for a selection of the most important priority crest stocks in Norway. In addition the project shall, through the use of new technology, implement monitoring of the spreading of signal crayfish based on a fixed grid of surfaces. The project shall obtain stock density data on the sectional crayfish by using teins and electrical fishing in addition to individual data such as length, gender, maturation and shell replacement status. 

The monitoring programme applies for the period 2024- 2028 is estimated to NOK 480,000 excluding VAT per annum."""@en;
  dct:title "Monitoring of flashing crayfish and spreading of signal crayps 2024 - 2029"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/b97cdd80-4437-4fa6-8668-702291c58a8e-01/Identifier/LOT-0000> .

