  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/a37333b9-0ac8-43c2-b06d-c9989a9a8392-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a37333b9-0ac8-43c2-b06d-c9989a9a8392-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/a37333b9-0ac8-43c2-b06d-c9989a9a8392-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/a37333b9-0ac8-43c2-b06d-c9989a9a8392-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  dct:description """Предметът на поръчката включва доставка, монтаж, въвеждане в експлоатация и гаранционна поддръжка на специализирано оборудване, както следва:
1          Стенд за обучение с програмируем контролер със софтуер        бр.       1
2          Приложение за сортиране към стенд за обучение с програмируем контролер и софтуер      бр.            1
3          Апликация за трафик сигнализация към стенд за обучение с програмируем контролер и софтуер     бр.       1
4          Електромеханична апликация    бр.            1
5          Aпликация PID налягане       бр.      1
6          Специализиран софтуер за програмиране на контролера към стенд за обучение с програмируем контролер, постоянен лиценз за един потребител   бр.    1
7          Лиценз за софтуер за е-обучение (3 годишен)   бр.           1
