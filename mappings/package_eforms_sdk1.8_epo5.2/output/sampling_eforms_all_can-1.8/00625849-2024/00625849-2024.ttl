  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/b42cab84-fdbe-404c-8449-706d5c12988e-01/ReviewProcedureInformationProvider/ORG-0002>;
