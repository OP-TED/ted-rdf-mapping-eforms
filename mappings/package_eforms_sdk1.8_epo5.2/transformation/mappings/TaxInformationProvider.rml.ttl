#--- MG-TaxInformationProvider ---
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix tedm: <http://data.europa.eu/a4g/mapping/rml/> .
@prefix epd: <http://data.europa.eu/a4g/resource/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-not: <http://data.europa.eu/a4g/ontology#>.
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix cpov: <http://data.europa.eu/m8g/> .
@prefix	foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2006/time#>.
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix idlab-fn: <http://example.com/idlab/function/> .

# VERINFO: across versions only mapping-irrelevant changes and introduction of Scheme attribute from v1.9
tedm:MG-TaxInformationProvider_ND-LotFiscalLegislation a rr:TriplesMap ;
    rdfs:label "MG-TaxInformationProvider" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/cac:ProcurementProjectLot[cbc:ID/@schemeName='Lot']/cac:TenderingTerms/cac:FiscalLegislationDocumentReference" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-LotFiscalLegislation" ;
            rml:reference "if(exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/TaxInformationProvider/' || encode-for-uri(concat(cac:IssuerParty/cac:PartyIdentification/cbc:ID, cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName)) else null";
            rr:class epo:TaxInformationProvider
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "OPT-301-Lot-FiscalLegis" ;
            rdfs:comment "Connection between AgentInRole and Organization OR OrganizationalUnit" ;
            rr:predicate epo:playedBy ;
            rr:objectMap
                [
                    rdfs:label "ORG (playedBy)" ;
                    rdfs:comment "Connection where IssuerParty is an Organization" ;
                    rr:parentTriplesMap tedm:MG-Organization_ND-Company ;
                    rr:joinCondition [
                        rr:child "if(cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName='organization' or exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'ORG-')])) then cac:IssuerParty/cac:PartyIdentification/cbc:ID else null" ;
                        rr:parent "cac:PartyIdentification/cbc:ID" ;
                    ] ;
                ]
                ,
                [
                    rdfs:label "TPO (playedBy)" ;
                    rdfs:comment "Connection where IssuerParty is an OrganizationalUnit" ;
                    rr:joinCondition [
                        rr:child "if(cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName='touchpoint' or exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'TPO-')])) then cac:IssuerParty/cac:PartyIdentification/cbc:ID else null" ;
                        rr:parent "cac:PartyIdentification/cbc:ID" ;
                    ] ;
                    rr:parentTriplesMap tedm:MG-OrganizationalUnit_ND-Touchpoint ;
                ] ;
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "OPT-301-Lot-FiscalLegis TPO (hasContactPointInRole)" ;
            rdfs:comment "Connection where IssuerParty is an OrganizationalUnit" ;
            rr:predicate epo:hasContactPointInRole ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-ContactPoint_ND-Touchpoint ;
                    rr:joinCondition [
                        rr:child "if(cac:IssuerParty/cac:PartyIdentification/cbc:ID/@schemeName='touchpoint' or exists(cac:IssuerParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'TPO-')])) then cac:IssuerParty/cac:PartyIdentification/cbc:ID else null" ;
                        rr:parent "cac:PartyIdentification/cbc:ID" ;
                    ] ;
                ] ;
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "OPT-301-Lot-FiscalLegis (contextualisedBy)" ;
            rr:predicate epo:contextualisedBy ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-Lot_ND-Lot ;
                    rr:joinCondition [
                        rr:child "../../cbc:ID" ;
                        rr:parent "cbc:ID" ;
                    ] ;
                ] ;
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "OPT-110-Lot-FiscalLegis" ;
            rdfs:comment "Connection of MG-TaxInformationProvider to MG-TaxDocumentation under ND-LotFiscalLegislation" ;
            rr:predicate epo:providesDocumentation ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-TaxDocumentation-providesDocumentation-TaxInformationProvider_ND-LotFiscalLegislation ;
                    rr:joinCondition [
                        rr:child "path(.)" ;
                        rr:parent "path(../../..)" ;
                    ] ;
                ] ;
        ] ;
.

tedm:MG-TaxDocumentation-providesDocumentation-TaxInformationProvider_ND-LotFiscalLegislation a rr:TriplesMap ;
    rdfs:label "MG-TaxDocumentation" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/cac:ProcurementProjectLot[cbc:ID/@schemeName='Lot']/cac:TenderingTerms/cac:FiscalLegislationDocumentReference/cac:Attachment/cac:ExternalReference/cbc:URI" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-LotFiscalLegislation" ;
            rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/TaxDocumentation${replace(translate(path(../..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
            rr:class epo:TaxDocumentation
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "OPT-110-Lot-FiscalLegis" ;
            rdfs:comment "URL to Fiscal Legislation of MG-TaxDocumentation-providesDocumentation-TaxInformationProvider under ND-LotFiscalLegislation" ;
            rr:predicate epo:hasAddressURL ;
            rr:objectMap
                [
                    rml:reference "." ;
                    rr:datatype xsd:anyURI
                ] ;
        ] ;
.
