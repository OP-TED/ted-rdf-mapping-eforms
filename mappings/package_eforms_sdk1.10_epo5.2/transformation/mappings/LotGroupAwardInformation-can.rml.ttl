#--- MG-LotGroupAwardInformation ---
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix epd: <http://data.europa.eu/a4g/resource/> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-not: <http://data.europa.eu/a4g/ontology#>.
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix cpov: <http://data.europa.eu/m8g/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2006/time#>.
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fnml:   <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix idlab-fn: <http://example.com/idlab/function/> .
@prefix tedm: <http://data.europa.eu/a4g/mapping/rml/> .

tedm:MG-MonetaryValue-hasGroupFrameworkAgreementMaximumValue-LotGroupAwardInformation_ND-NoticeResultGroupFA  a rr:TriplesMap ;
  rdfs:label "MG-MonetaryValue";
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/efac:GroupFramework" ;
            rml:referenceFormulation ql:XPath
        ] ;
   rr:subjectMap
        [
            rdfs:label "ND-NoticeResultGroupFA";
            rml:reference "if (exists(efbc:GroupFrameworkMaximumValueAmount)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/GroupFrameworkAgreementMaximumMonetaryValue$' || replace(replace(replace(path(), 'Q\\{[^}]+\\}', ''), '\\[([0-9]+)\\]', '$1'), '/', '_') else null" ;
            rr:class epo:MonetaryValue
        ] ;
   rr:predicateObjectMap
        [
            rdfs:label "BT-156-NoticeResult (value)";
            rdfs:comment "Group Framework Maximum Value of MG-MonetaryValue under ND-NoticeResultGroupFA";
            rr:predicate epo:hasAmountValue ;
            rr:objectMap
                [
                    rml:reference "if(not(exists(efac:FieldsPrivacy[efbc:FieldIdentifierCode/text()='gro-max-val']) and efbc:GroupFrameworkMaximumValueAmount/text() = '-1' )) then efbc:GroupFrameworkMaximumValueAmount else null" ;
                    rr:datatype xsd:decimal ;
                ] ;
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-156-NoticeResult-Currency";
            rdfs:comment "Currency of Group Framework Maximum Value of MG-MonetaryValue under ND-NoticeResultGroupFA";
            rr:predicate epo:hasCurrency ;
            rr:objectMap
                [
                    rdfs:label "at-voc:currency" ;
                    rr:parentTriplesMap tedm:currency ;
                    rr:joinCondition [
                        rr:child "efbc:GroupFrameworkMaximumValueAmount/@currencyID" ;
                        rr:parent "code.value" ;
                    ] ;
                ] ;
        ] ;
.

tedm:MG-LotGroupAwardInformation_ND-NoticeResultGroupFA a rr:TriplesMap ;
    rdfs:label "MG-LotGroupAwardInformation";
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/efac:GroupFramework" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-LotsGroupFA";
            rml:reference "if (exists(efbc:GroupFrameworkMaximumValueAmount) or exists(efbc:GroupFrameworkReestimatedValueAmount) or exists(efac:TenderLot/cbc:ID)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/LotGroupAwardInformation$' || replace(replace(replace(path(.), 'Q\\{[^}]+\\}', ''), '\\[([0-9]+)\\]', '$1'), '/', '_') else null" ;
            rr:class epo:LotGroupAwardInformation
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-156-NoticeResult (object)";
            rr:predicate epo:hasGroupFrameworkAgreementMaximumValue    ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-MonetaryValue-hasGroupFrameworkAgreementMaximumValue-LotGroupAwardInformation_ND-NoticeResultGroupFA ;
                    rr:joinCondition [
                        rr:child "path(.)";
                        rr:parent "path(.)";
                    ];
                ] ;
        ]   ;
    rr:predicateObjectMap
         [
             rdfs:label "BT-556-NoticeResult";
             rdfs:comment "Group Framework Value Lot Identifier of MG-Lot under ND-NoticeResultGroupFA";
             rr:predicate epo:describesLotGroup ;
             rr:objectMap
                 [
                   rr:parentTriplesMap tedm:MG-LotGroup_ND-NoticeResultGroupFA ;
                     rr:joinCondition [
                         rr:child "if (not(exists(efac:FieldsPrivacy[efbc:FieldIdentifierCode/text()='gro-max-ide']))) then path(.) else null" ;
                         rr:parent "path(.)" ;
                     ];
                 ] ;
         ];
    rr:predicateObjectMap
        [
            rdfs:label "BT-1561-NoticeResult (object)" ;
            rdfs:comment "Group Framework Reestimated Value Amount of MG-MonetaryValue-hasApproximateGroupFrameworkAgreementValue-LotGroupAwardInformation under ND-NoticeResultGroupFA" ;
            rr:predicate epo:hasApproximateGroupFrameworkAgreementValue ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-MonetaryValue-hasApproximateGroupFrameworkAgreementValue-LotGroupAwardInformation-announcesLotGroupAwardInformation-ResultNotice_ND-NoticeResultGroupFA ;
                    rr:joinCondition [
                        rr:child "path(.)" ;
                        rr:parent "path(.)" ;
                    ] ;
                ]
        ] ;
.

tedm:MG-MonetaryValue-hasApproximateGroupFrameworkAgreementValue-LotGroupAwardInformation-announcesLotGroupAwardInformation-ResultNotice_ND-NoticeResultGroupFA a rr:TriplesMap ;
    rdfs:label "MG-MonetaryValue" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/efac:GroupFramework" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-NoticeResultGroupFA" ;
            rml:reference "if (exists(efbc:GroupFrameworkReestimatedValueAmount)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/ApproximateGroupFrameworkAgreementMonetaryValue$' || replace(replace(replace(path(), 'Q\\{[^}]+\\}', ''), '\\[([0-9]+)\\]', '$1'), '/', '_') else null" ;
            rr:class epo:MonetaryValue
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-1561-NoticeResult (value)" ;
            rdfs:comment "Group Framework Reestimated Value Amount of MG-MonetaryValue under ND-NoticeResultGroupFA" ;
            rr:predicate epo:hasAmountValue ;
            rr:objectMap
                [
                    rml:reference "if(not(exists(efac:FieldsPrivacy[efbc:FieldIdentifierCode/text()='not-ree-val']) and text() = '-1') and not(exists(efac:FieldsPrivacy[efbc:FieldIdentifierCode/text()='gro-ree-val']) and text() = '-1')) then efbc:GroupFrameworkReestimatedValueAmount else null" ;
                    rr:datatype xsd:decimal
                ]
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-1561-NoticeResult-Currency" ;
            rdfs:comment "Currency of Group Framework Reestimated Value Amount of MG-MonetaryValue under ND-NoticeResultGroupFA" ;
            rr:predicate epo:hasCurrency ;
            rr:objectMap
                [
                    rdfs:label "at-voc:currency" ;
                    rr:parentTriplesMap tedm:currency ;
                    rr:joinCondition [
                        rr:child "efbc:GroupFrameworkReestimatedValueAmount/@currencyID" ;
                        rr:parent "code.value" ;
                    ] ;
                ]
        ] ;
.

tedm:MG-LotGroupAwardInformation-refersToLotGroupAwardInformation-CompletionNotice_ND-NoticeResultGroupFA a rr:TriplesMap ;
    rdfs:label "MG-LotGroupAwardInformation";
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/efac:GroupFramework" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-LotsGroupFA";
            rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/LotGroupAwardInformation${replace(translate(path(), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
            rr:class epo:LotGroupAwardInformation
        ] ;
.

tedm:MG-LotGroupAwardInformation-refersToLotGroupAwardInformation-ContractModificationNotice_ND-NoticeResultGroupFA a rr:TriplesMap ;
    rdfs:label "MG-LotGroupAwardInformation";
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeResult/efac:GroupFramework" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-LotsGroupFA";
            rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/LotGroupAwardInformation${replace(translate(path(), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
            rr:class epo:LotGroupAwardInformation
        ] ;
.
