  epo:concernsContractAmendment <http://data.europa.eu/a4g/resource/1f8687c9-8cca-493a-b0ee-553ed23d8402-01/ContractAmendment$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_ContractModification1>;
  epo:hasModificationDescription "Extension of six (6) months and increased contract value from GBP 95 000 000 to GBP 105 000 000."@en;
  epo:hasModificationJustification <http://publications.europa.eu/resource/authority/modification-justification/mod-cir>;
  epo:hasModificationReasonDescription "The above contract is due to expire between 1 May 2020 and 31 December 2020. Due to the on-going COVID-19 outbreak and associated restrictions we are unable to implement the new ALMS Contract as anticipated. In line with Regulation 72(1)(c) of the PCR 2015 it is proposed to extend the above contract based on the following trust specific dates: Belfast Health & Social Care Trust – 31 October 2020 Western Health & Social Care Trust – 31 January 2021 Southern Health & Social Care Trust – 31 January 2021 Northern Health & Social Care Trust – 30 June 2021 (prices, terms & conditions to remain the same)."@en;
  epo:relatesToEFormSectionIdentifier <http://data.europa.eu/a4g/resource/1f8687c9-8cca-493a-b0ee-553ed23d8402-01/ContractModificationInformation/Identifier/CON-0001>,
