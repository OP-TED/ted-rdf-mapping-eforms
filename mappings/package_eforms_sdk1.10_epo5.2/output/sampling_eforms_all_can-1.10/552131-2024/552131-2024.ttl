  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/supplies>;
  epo:hasMaximumNumberOfRenewals 2;
  epo:hasOptionsDescription """•	OPTION 1 : Possibilité d’acquérir une application qui permet le téléchargement d’une offre de divertissement avant le voyage et identifier la durée d’accès à laquelle le client aura droit.

•	OPTION 2 : Possibilité d'acquérir une application en marque blanche dédiée au divertissement à bord qui reprenne l’ensemble des contenus et services proposés sur le Portail Wifi par TGV Lyria. 

•	OPTION 3 : Réversibilité sortante en fin de maché"""@fr;
  epo:hasRenewalDescription "Le marché peut être reconduit deux fois douze (12) mois. La durée totale du marché ne pourra pas dépasser quarante-huit (48) mois."@fr .

