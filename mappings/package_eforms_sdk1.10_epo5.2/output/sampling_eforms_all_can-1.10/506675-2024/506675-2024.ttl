<http://data.europa.eu/a4g/resource/172ee420-d501-418b-bb43-68a420ed5a0d-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
