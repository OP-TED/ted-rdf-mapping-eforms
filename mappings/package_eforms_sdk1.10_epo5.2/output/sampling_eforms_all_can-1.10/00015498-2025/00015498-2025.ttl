  a epo:NonPublishedInformation;
  epo:concernsMaskedObject <http://data.europa.eu/a4g/resource/9a11faf5-6701-48e9-b751-ad5943985c0b-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/9a11faf5-6701-48e9-b751-ad5943985c0b-01/Notice>;
  epo:hasAccessibilityDate "2035-01-08+01:00"^^xsd:date;
  epo:hasConfidentialityJustification "Es handelt sich um eine Sammelbekanntmachung für die Vertragsschlüsse in Open-House-/Zulassungsverfahren über Arzneimittelrabattverträge. Die TK nutzt den Vorgaben der Rechtsprechung des OLG Düsseldorfs und des EuGH aus Transparenzgründen entsprechend die Bekanntmachungsformulare für \"Offene Verfahren\" im TED. Da bei Open-House-Verfahren keine Auswahlentscheidung getroffen wird, sondern jeder geeignete Wirtschaftsteilnehmer zu gleichen Bedingungen einen Vertrag schließen kann, gibt es hier keine Zuschlagskriterien."@de;
  epo:hasMaskableProperty epo:hasWeightValueType;
  epo:hasNonPublicationJustification <http://publications.europa.eu/resource/authority/non-publication-justification/oth-int> .

