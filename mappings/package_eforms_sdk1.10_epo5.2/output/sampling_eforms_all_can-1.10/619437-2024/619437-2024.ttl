  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/MonetaryValueLot$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/Lot/Identifier/EVV%20230%2F115-2024>;
