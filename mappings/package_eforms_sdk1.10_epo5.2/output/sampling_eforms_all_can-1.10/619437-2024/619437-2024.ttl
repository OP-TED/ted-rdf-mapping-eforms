  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  dct:description """Predmet nabave su rezervni dijelovi, usluge održavanja (servisi) i rekonstrukcije HVAC sustava, na brodovima u floti Jadrolinije, sukladno uvjetima propisanim ovom DoN.
Brodski HVAC sustavi ugrađeni na brodovima flote Jadrolinije Rijeka sastoje se od niza uređaja i elemenata od različitih proizvođača (popis uređaja po brodovima nalazi se u jednom od listova (sheets) Troškovnika).
Gospodarski subjekti su prije dostave ponuda obvezni izvršiti pregled HVAC sustava na svim brodovima, radi snimanja postojećeg stanja i veličine sustava, a kao dokaz da je sustav pregledan, uz ponudu obvezno dostavljaju ˝SERVISNO IZVJEŠĆE\" za sve brodove, ovjereno od strane svakog pojedinog broda.
Osim toga, gospodarski subjekti uz ponudu obvezno dostavljaju i Izjavu (u slobodnoj formi) o raspolaganju potrebnim znanjem i resursima za održavanje pregledanih brodskih HVAC sustava.
Za potrebe pregleda HVAC sustava pojedinog broda, potreban je dogovor s nadležnim inspektorom broda radi organiziranja posjeta brodu (popis nadležnih inspektora s brojevima telefona nalazi se u jednom od listova (sheets) Troškovnika).
Na slijedećem linku, moguće je vidjeti karakteristike brodova po kategorijama:
https://www.jadrolinija.hr/hr/flota-kategorije
"""@hr;
  dct:title """Rezervni dijelovi, usluge održavanja (servisi)  i rekonstrukcije HVAC sustava na brodovima u floti Jadrolinije 
"""@hr;
  adms:identifier <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/Identifier/LOT-0000> .

