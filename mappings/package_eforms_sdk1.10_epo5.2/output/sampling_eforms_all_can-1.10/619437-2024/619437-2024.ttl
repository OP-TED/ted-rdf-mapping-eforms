  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/Procedure/Identifier/EVV%20230%2F115-2024>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Pregovarački postupak bez prethodne objave poziva na nadmetanje"@hr;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-wo-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/DirectAwardTerm$_ContractAwardNotice1_TenderingProcess1_ProcessJustification1>;
  dct:description """Predmet nabave su rezervni dijelovi, usluge održavanja (servisi) i rekonstrukcije HVAC sustava, na brodovima u floti Jadrolinije, sukladno uvjetima propisanim ovom DoN.
Brodski HVAC sustavi ugrađeni na brodovima flote Jadrolinije Rijeka sastoje se od niza uređaja i elemenata od različitih proizvođača (popis uređaja po brodovima nalazi se u jednom od listova (sheets) Troškovnika).
Gospodarski subjekti su prije dostave ponuda obvezni izvršiti pregled HVAC sustava na svim brodovima, radi snimanja postojećeg stanja i veličine sustava, a kao dokaz da je sustav pregledan, uz ponudu obvezno dostavljaju ˝SERVISNO IZVJEŠĆE\" za sve brodove, ovjereno od strane svakog pojedinog broda.
Osim toga, gospodarski subjekti uz ponudu obvezno dostavljaju i Izjavu (u slobodnoj formi) o raspolaganju potrebnim znanjem i resursima za održavanje pregledanih brodskih HVAC sustava.
Za potrebe pregleda HVAC sustava pojedinog broda, potreban je dogovor s nadležnim inspektorom broda radi organiziranja posjeta brodu (popis nadležnih inspektora s brojevima telefona nalazi se u jednom od listova (sheets) Troškovnika).
Na slijedećem linku, moguće je vidjeti karakteristike brodova po kategorijama:
https://www.jadrolinija.hr/hr/flota-kategorije
"""@hr;
  dct:title """Rezervni dijelovi, usluge održavanja (servisi)  i rekonstrukcije HVAC sustava na brodovima u floti Jadrolinije 
"""@hr;
  adms:identifier <http://data.europa.eu/a4g/resource/e58951b3-2d58-423e-a51c-24c250fe61c5-01/Procedure/Identifier/a50c58ae-e34e-4894-9999-0f15e3ddd6c8> .

