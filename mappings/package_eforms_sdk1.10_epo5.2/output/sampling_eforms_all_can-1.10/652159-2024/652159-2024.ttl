<http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/Procedure/a729a7fb-1926-4a04-a15f-7bd2f7d82b01>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Der Bieter hat anzugeben inwieweit sein Unternehmen einen Bezug zu Russland hat. Dafür ist die “Eigenerklärung Bezug Russland“ (FB 127/L127/III.127) auszufüllen und als Teil des Angebotes abzugeben. Diese Erklärung ist auch für Unterauftragnehmer, Lieferanten oder Eignungsverleiher gem. den Bedingungen der Erklärung abzugeben."@de;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/Procedure/Identifier/50240022>;
  epo:hasLaunchFrameworkAgreementMaximumValue <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/ProcedureValueEstimateExtension$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "vgv";
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description "Der Auftragnehmer führt im Jahr 2025 die Leerung von Kleinkläranlagen und abflusslosen Gruben für den Auftraggeber durch und transportiert den anfallenden Fäkalschlamm sowie das anfallende Schmutzwasser zur Kläranlage in Gera oder Weida. Bei den zu entleerenden Kleinkläranlagen handelt es sich sowohl um voll- als auch teilbiologische und mechanische Kleinkläranlagen.Die Dienstleistung umfasst die turnusmäßige Fäkalschlammabfuhr von ca. 2.800 Kleinkläranlagen (mit insgesamt ca. 4.600 m³) in den Monaten März bis einschließlich November, sowie die außerplanmäßige Fäkalschlammabfuhr (unregelmäßige Abfuhr nach Abforderung) von ca. 500 (mit insgesamt ca. 1.200 m³) Kleinkläranlagen in den Monaten Januar bis Dezember. Ebenso erfolgt die Abfuhr des Schmutzwassers aus abflusslosen Gruben. Die Anzahl der zu entsorgenden Kleinkläranlagen stellt eine ungefähre Größe dar, die abhängig von der Entwicklung im Verbandsgebiet ist. Mehr- oder Mindermengen sind daher in die Einheitspreise einzukalkulieren. Eventuelle Änderungen führen nicht zu Preisänderungen."@de;
  dct:title "Fäkalschlammtransport 2025"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/Procedure/Identifier/a729a7fb-1926-4a04-a15f-7bd2f7d82b01> .

<http://data.europa.eu/a4g/resource/b1f19e90-0ad4-469d-bfd8-a8cde546d967-01/ProcedurePlacePerformance$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1_Address1>
  a locn:Address;
  epo:hasCountryCode <http://publications.europa.eu/resource/authority/country/DEU>;
  epo:hasNutsCode <http://data.europa.eu/nuts/code/DEG02>;
  locn:postCode "07545";
  locn:postName "Gera" .

