  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/ba547c52-e216-4df5-8e3f-db302732f80b-01/MonetaryValueLot$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
