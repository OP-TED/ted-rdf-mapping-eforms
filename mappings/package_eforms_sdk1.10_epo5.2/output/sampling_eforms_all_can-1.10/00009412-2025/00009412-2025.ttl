  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f5e2798c-8a90-49f0-8b90-d7c9f7197edb-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
