<http://data.europa.eu/a4g/resource/c9b04fb5-5bfa-4fa3-9916-e815a3f853d2-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
