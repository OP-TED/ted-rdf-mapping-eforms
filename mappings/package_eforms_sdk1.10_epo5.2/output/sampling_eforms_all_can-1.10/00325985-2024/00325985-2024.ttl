<http://data.europa.eu/a4g/resource/e8ad1bad-4fd6-43a2-a156-04579e3d75e7-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/e8ad1bad-4fd6-43a2-a156-04579e3d75e7-01/ReviewProcedureInformationProvider/ORG-0002>;
