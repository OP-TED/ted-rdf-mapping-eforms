<http://data.europa.eu/a4g/resource/e8ad1bad-4fd6-43a2-a156-04579e3d75e7-01/Lot/LOT-0000>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/e8ad1bad-4fd6-43a2-a156-04579e3d75e7-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
