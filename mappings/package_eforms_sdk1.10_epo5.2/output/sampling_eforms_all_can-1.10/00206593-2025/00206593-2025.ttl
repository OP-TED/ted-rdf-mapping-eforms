    <http://data.europa.eu/a4g/resource/58a7d2c8-abd5-4a4f-98cf-3348fe95c3a3-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/58a7d2c8-abd5-4a4f-98cf-3348fe95c3a3-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/58a7d2c8-abd5-4a4f-98cf-3348fe95c3a3-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Hankinnan kohteena on Klaritromysiini 250 mg, Levofloksasiini 500 mg ja Moksifloksasiini 400 mg tabletit/kapselit. Kyseessä on kertahankinta ja tuotteet tulevat Suomen rescEU Medical -varastointihankkeen käyttöön. Arvioidun määrän lisäksi THL:lla on oikeus ostaa tuotteita 100 % arvioitujen määrien lisäksi (\"Optio\"). Hankinnan kokonaisarvo on 677 600 euroa Optiot mukaan lukien. Hankintayksikkö hankkii lääkevalmisteita hankintalain mukaisena suorahankintana valitulta toimittajalta. Avoimessa menettelyssä ei ole saatu lainkaan tarjouksia kyseisille tuotteille ja alkuperäisiä tarjouspyynnön ehtoja ei olennaisesti muuteta."@fi;
  dct:title "Klaritromysiini 250 mg, Levofloksasiini 500 mg ja Moksifloksasiini 400 mg tabletit/kapselit"@fi;
  adms:identifier <http://data.europa.eu/a4g/resource/58a7d2c8-abd5-4a4f-98cf-3348fe95c3a3-01/Identifier/LOT-0000> .

