    <http://data.europa.eu/a4g/resource/b1856f5f-2905-44e0-8f26-857af70252eb-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/b1856f5f-2905-44e0-8f26-857af70252eb-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
