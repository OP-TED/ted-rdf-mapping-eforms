<http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/Procedure/7996b28e-c95b-4011-9714-69f2a9293733>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "S'agissant d'un accord à bons de commande, le montant d'attribution indiqué est estimatif (Dqe) et a servi au jugement des offres"@fr;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/Procedure/Identifier/24SIR009>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  dct:description """Le présent marché a pour objet la constitution des dossiers loi sur l'eau (déclaration ou autorisation) au titre des articles L181-1 et suivants L214-1 et suivant du code de l'Environnement.
A ce titre le bureau d'études sera amené à réaliser :
- l'état des lieux initial du milieu physique et naturel avec notamment des inventaires spécifiques faune flore, de recherches bibliographiques …,
- une étude hydraulique basée sur une étude hydrologique pour le pré dimensionnement des ouvrages et l'évaluation de leurs incidences,
- la rédaction du dossier loi sur l'Eau et du document d'incidences ainsi que la proposition de mesures d'insertion,
- l'évaluation des incidences Natura 2000 simplifiée ou complète"""@fr;
  dct:title "Etudes hydrauliques et élaboration de dossiers Loi sur l'Eau dans le département"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/f3226e73-b8cc-43ea-a3ea-124fc6770ee0-01/Procedure/Identifier/7996b28e-c95b-4011-9714-69f2a9293733> .

