  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot2_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot3_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot4_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/ProcedureTerm$_ContractNotice1_TenderingTerms1_LotDistribution1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description """Les opérations portent sur des travaux de voiries, réseaux divers et terrassement (VRD) sur les sites du Département de la Réunion.
La consultation est décomposée en quatre lots dont les lieux d'exécution des travaux sont répartis par zone géographique.
Il s'agit de travaux de réfection, construction et aménagement de voirie correspondant à des travaux d'entretien de faible ampleur ou des travaux plus conséquent, mais aussi de petits aménagements ou réfection/réparation de réseaux divers AEP nécessitant une mise en oeuvre rapide. Il s'agit également de travaux classiques de remise en l'état ou de mises aux normes du patrimoine réseaux divers et voirie du Département afin de pallier à son vieillissement et sa dégradation"""@fr;
  dct:title "Accords-Cadres relatifs à des travaux de voiries, réseaux divers et terrassement (VRD) sur les sites du Département de la Réunion"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/edf0a497-bf54-4a97-881a-cac917bc8502-01/Procedure/Identifier/d97ade65-146f-4b16-8b3b-967fdf587be3> .

