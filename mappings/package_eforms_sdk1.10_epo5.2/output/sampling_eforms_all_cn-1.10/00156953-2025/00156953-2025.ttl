    <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
    <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>,
    <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria4>,
    <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria5>;
  epo:usesChannel <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/Channel$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/DynamicPurchaseSystemTechnicalUsage$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "KulturIT AS intends to enter into at least three parallel framework agreements for future procurements of new ICT equipment. The contracts shall be valid for 2 years, with an option for a further 2 one year extensions (2+1+1) so that the maximum contract period can be up to 4 years. The procurement is for the delivery of IT equipment as well as periphery equipment. The procurement concerns KulturIT AS and museums that are connected to the cooperation and other museums that can be connected to the cooperation at a later date."@en;
  dct:title "Framework agreement IT equipment"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/Identifier/LOT-0001> .

<http://data.europa.eu/a4g/resource/1140148f-2a7d-4ee9-a2a0-a595c0a43f54-01/LotPurpose$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1>
