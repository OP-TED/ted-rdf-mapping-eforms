  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/da38e311-c448-4637-91ad-49aad9f0d625-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/da38e311-c448-4637-91ad-49aad9f0d625-01/Procedure/Identifier/1365-2024-EVV>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Otvoreni postupak za projektni natječaj"@hr;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/da38e311-c448-4637-91ad-49aad9f0d625-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/da38e311-c448-4637-91ad-49aad9f0d625-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  dct:description """PREDMET NATJEČAJA je izrada arhitektonsko-urbanističkog idejnog rješenja za izgradnju Dječjeg vrtića Jarun sukladno „Programu za provedbu javnog natječaja za izradu idejnog rješenja Dječjeg vrtića Jarun“ izrađenom od Zavoda za prostorno uređenje Grada Zagreba u listopadu 2023. godine, stručni tim:  Dubravka-Petra Lubin, ovlaštena arhitektica urbanistica, Mirela Bokulić – Zubac, ovlaštena arhitektica, Jasmina Doko, dipl. ing. agr., Dinko Brdarić, dipl. ing. prom. i Ivan Lončarić, prof. geog. i pov.

Novooblikovana građevna čestica u funkciji Dječjeg vrtića Jarun, formirati će se od čestice k.č.br. 6432/5 i dijela čestice k.č.br. 6435/1 obje k.o. Rudeš, ukupne površine približno 4.835 m2.
"""@hr;
  dct:title "PROJEKTNI NATJEČAJ ZA IZRADU IDEJNOG RJEŠENJA DJEČJEG VRTIĆA \"JARUN\""@hr;
