    <http://data.europa.eu/a4g/resource/c481ec34-c47b-4c1a-9040-c86a3438e47f-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/c481ec34-c47b-4c1a-9040-c86a3438e47f-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>;
