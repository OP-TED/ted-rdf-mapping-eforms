    <http://data.europa.eu/a4g/resource/1dd12a2b-3eff-4e59-b7cb-4231f1e9f7b9-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>,
    <http://data.europa.eu/a4g/resource/1dd12a2b-3eff-4e59-b7cb-4231f1e9f7b9-01/SubmissionTerm$_ContractNotice1_ProcurementProjectLot1>;
