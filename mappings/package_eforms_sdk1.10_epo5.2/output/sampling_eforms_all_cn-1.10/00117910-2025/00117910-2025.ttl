  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/1dd12a2b-3eff-4e59-b7cb-4231f1e9f7b9-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/1dd12a2b-3eff-4e59-b7cb-4231f1e9f7b9-01/Procedure/Identifier/CW30248>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasMainFeature "Ce marché de fourniture conclut sous la forme d’un accord-cadre comporte 2 lots : • Lot 1 : La livraison d'huiles pour moteurs diesel, boîtes de vitesse, directions, ponts et essieux d'autobus ainsi que des graisses à destination des bandes de roulement et de portes de la flotte de trams. • Lot 2 : Des prestations d’analyse d’huile ANAC."@fr,
    "Deze leveringsopdracht, afgesloten in de vorm van een raamovereenkomst, omvat twee percelen:  - Perceel 1: De levering van oliën voor dieselmotoren, versnellingsbakken, stuursystemen, bruggen en assen van bussen, evenals vetten voor loopvlakken en deuren van de tramvloot. - Perceel 2: Olieanalysediensten ANAC."@nl;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/1dd12a2b-3eff-4e59-b7cb-4231f1e9f7b9-01/Lot/LOT-0001>,
