<http://data.europa.eu/a4g/resource/c0b63aaf-4849-4adb-bd05-632ae51b29f9-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/c0b63aaf-4849-4adb-bd05-632ae51b29f9-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>,
