  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/b771d662-61a3-4aef-8f34-10f641443a75-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:definesEstimatedContractDuration <http://data.europa.eu/a4g/resource/b771d662-61a3-4aef-8f34-10f641443a75-01/ContractDuration$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
