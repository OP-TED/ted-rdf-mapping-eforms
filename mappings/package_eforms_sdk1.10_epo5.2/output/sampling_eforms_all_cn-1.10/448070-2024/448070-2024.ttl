  epo:isProcurementDocumentChanged true;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/e5359141-91ed-49e5-a939-ad4992468ecd-01/Notice/f2c823d2-3828-4940-822c-32de6a868282-01>;
