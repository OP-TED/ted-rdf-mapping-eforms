<http://data.europa.eu/a4g/resource/e5359141-91ed-49e5-a939-ad4992468ecd-01/ChangeInformation$_ContractNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Changes1_ChangeReason1>
  a epo:ChangeInformation;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/e5359141-91ed-49e5-a939-ad4992468ecd-01/Notice>;
  epo:hasChangeJustification <http://publications.europa.eu/resource/authority/change-corrig-justification/update-add>;
  epo:hasChangeReasonDescription "Naručitelj  je sukladno čl. 200. st. 6. Zakona o javnoj nabavi (Narodne novine 120/2016, 114/2022) putem internetskih stranica Elektroničkog oglasnika javne nabave Republike Hrvatske objavio i stavio na raspolaganje svim zainteresiranim natjecateljima izmijenjene i nove priloge - dio vezano uz iskaz površine podzemne garaže (izmijenjena tablica i dwg za grafički prilog), a dio jer je objavljena dwg podloga bila bez ucrtanog obuhvata."@hr;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/e5359141-91ed-49e5-a939-ad4992468ecd-01/Notice/f2c823d2-3828-4940-822c-32de6a868282-01> .

