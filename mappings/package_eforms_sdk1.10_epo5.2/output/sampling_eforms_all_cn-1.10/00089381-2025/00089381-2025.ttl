<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on kansalliseen lainsäädäntöön ja kansallisiin määräyksiin perustuen yllämainittuja tilanteita vastaavassa samankaltaisessa menettelyssä."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/bankr-nat> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement10>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle itselleen tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen tai jolla on siinä päätös-, edustus- tai valvontavaltaa, on annettu lapsityövoiman käytöstä tai muista ihmiskaupan muodoista lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/human-traffic> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement11>
  a epo:ExclusionGround;
  dct:description "Tarjoajan osalta on käynnistetty maksukyvyttömyys- tai likvidaatiomenettely."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/insolvency> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement12>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut työlainsäädännön mukaisia velvoitteitaan."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/labour-law> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement13>
  a epo:ExclusionGround;
  dct:description "Tarjoajan varat ovat selvitysmiehen tai tuomioistuimen hallinnassa."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/liq-admin> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement14>
  a epo:ExclusionGround;
  dct:description "Tarjoajaa koskee jokin seuraavista tilanteista. a) on syyllistynyt väärän tiedon antamiseen poissulkemis- tai valintaperusteiden osalta, b) on jättänyt antamatta tällaisia tietoja, c) on toimittanut viiveellä tai ei lainkaan ostajan vaatimia tietoja, tai d) on yrittänyt vaikuttaa ostajan päätöksentekoprosessiin asiattomalla tavalla tai hankkinut luottamuksellista tietoa, joista voisi olla sille hankintamenettelyssä asiaankuulumatonta etua, taikka on toimittanut harhaanjohtavia tietoja, joilla voi olla merkittävä vaikutus poissulkemista, tarjoajan valintaa tai hankintaa koskeviin päätöksiin."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/misrepresent> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement15>
  a epo:ExclusionGround;
  dct:description "Tarjoajan hallinto-, johto- tai valvontaelimen jäsen tai edustus-,päätös- tai valvontavaltaa käyttävä henkilö on rikosrekisteristä ilmenevällä lainvoimaisella tuomiolla tuomittu työturvallisuusrikoksesta, työaikasuojelurikoksesta, työsyrjinnästä, kiskonnantapaisesta työsyrjinnästä, työntekijöiden järjestäytymisvapauden loukkaamisesta tai luvattoman ulkomaisen työvoiman käytöstä."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/nati-ground> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement16>
  a epo:ExclusionGround;
  dct:description "Tarjoajan osallistumisesta hankintamenettelyyn aiheutuu eturistiriitoja."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/partic-confl> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement17>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on syyllistynyt ammatin harjoittamiseen liittyvään vakavaan virheeseen."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/prof-misconduct> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement18>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut sosiaalilainsäädännön mukaisia velvoitteitaan."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/socsec-law> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement19>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut sosiaaliturvamaksujen maksamiseen liittyviä velvoitteitaan sijoittumismaassaan tai ostajan maassa."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/socsec-pay> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement2>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on konkurssissa."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/bankruptcy> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement20>
  a epo:ExclusionGround;
  dct:description "Tarjoajan liiketoiminta on keskeytetty."@fi;
  dct:type <http://publications.europa.eu/resource/authority/criterion/susp-act> .

<http://data.europa.eu/a4g/resource/408fb0b7-0f1e-486c-bbc9-3ca5b7532878-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement21>
