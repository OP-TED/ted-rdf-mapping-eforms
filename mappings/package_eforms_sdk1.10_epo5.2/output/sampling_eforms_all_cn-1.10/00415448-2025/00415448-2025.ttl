<http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/Procedure/3ee3de3e-2ada-4e83-a317-46bcb53e3f53>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation """The city of Reykjavík is divided into a total of 19 areas (areas will be defined and demarcated before the start of the contract period). Areas are similar in size and it is assumed that one device can handle snow removal and anti-icing in each area.
The buyer allocates area/areas to the seller, but attention is drawn to the fact that the division of areas may change during the contract period, but the buyer will ensure that the size and scope of the areas are as equal as possible. Attention is also drawn to the fact that more than one seller may be working simultaneously within the same area, this is especially true where bicycle routes (service category 1a) pass through areas."""@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/Procedure/Identifier/16169>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/21471d14-dcdb-45e8-81b0-67399db375c2-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description """Umhverfis- og skipulagssviðs Reykjavíkurborgar (USK) óskar eftir tilboðum í vetrarþjónustu göngu- og hjólaleiða.
Verkið felst í snjóhreinsun og hálkueyðingu göngu- og hjólaleiða í Reykjavík. Reykjavíkurborg er skipt upp í 19 svæði. Svæði eru svipuð að stærð og gengið út frá því að eitt tæki geti annað snjóhreinsun og hálkueyðingu á hverju svæði.
"""@en;
  dct:title "16169 - Vetrarþjónusta göngu- og hjólaleiða í Reykjavík"@en;
