  a epo:SubmissionTerm;
  epo:definesTenderProcessor <http://data.europa.eu/a4g/resource/a53471f2-135b-4bb3-86de-f10e787f4f70-01/TenderProcessor/ORG-0002>;
  epo:definesTenderReceiver <http://data.europa.eu/a4g/resource/a53471f2-135b-4bb3-86de-f10e787f4f70-01/TenderReceiver/ORG-0002>;
  epo:hasESubmissionPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasLanguage <http://publications.europa.eu/resource/authority/language/DEU>;
  epo:hasLateSubmissionInformationDescription "Die Auftraggeberin behält sich das Recht vor, ggf. weitere Nachweise von den Bewerbern abzufordern. Die Abforderung erfolgt durch Mitteilung über das Vergabeportal. Nach Abschluss des Teilnahmewettbewerbs sind weitere Erklärungen, u.a. zum Mindestlohn, der RUS Sanktionen etc. als Teilnahmevoraussetzung abzugeben. Die ausgewählten Büros werden über das Vergabeportal zu gegebener Zeit informiert."@de;
  epo:hasLateSubmissionPermission <http://publications.europa.eu/resource/authority/missing-info-submission/late-all>;
  epo:hasNonElectronicSubmissionDescription "Sämtliche Kommunikation erfolgt über die Plattform Aumass, die eine Registrierung erfordert. Innerhalb des Wettbewerbs sind neben digitalen Unterlagen Pläne in Papierform einzureichen."@de;
  epo:hasReceiptParticipationRequestDeadline "2025-02-07T15:00:00+01:00"^^xsd:dateTime;
  epo:hasSubmissionURL "https://plattform.aumass.de/Veroeffentlichung/av242257-eu"^^xsd:anyURI;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:isAdvancedElectronicSignatureRequired false;
  epo:isMultipleTenderSubmissionAllowed false .

