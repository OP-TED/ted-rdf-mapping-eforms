  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/a53471f2-135b-4bb3-86de-f10e787f4f70-01/ReviewProcedureInformationProvider/ORG-0003>;
