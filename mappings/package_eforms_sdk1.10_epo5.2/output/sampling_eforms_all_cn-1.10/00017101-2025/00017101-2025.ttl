<http://data.europa.eu/a4g/resource/a53471f2-135b-4bb3-86de-f10e787f4f70-01/Procedure/fdb75aa9-a537-4034-8d01-00542064401b>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a53471f2-135b-4bb3-86de-f10e787f4f70-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/a53471f2-135b-4bb3-86de-f10e787f4f70-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "vgv / § 78 VGV und RPW 2015 FHH"@de;
  epo:hasMainFeature """Im Rahmenplan Innenstadt Harburg 2040 stellt die Stärkung der zentralen Achse, Harburgs historische Ader vom Bahnhof bis zum Harburger Schloss, ein Hauptziel dar.
Das Plangebiet befindet sich in einem seit 2016 festgelegten RISE Gebiet, die allgemeinen Ziele dieses Programms sind zu beachten. Ziel ist die Erarbeitung eines Gestaltungskonzepts für die Haupteinkaufsstraße Lüneburger Straße und die direkt daran angrenzenden Straßen in der Harburger Innenstadt, die eine Grundinstandsetzung benötigen. Die Aufenthaltsqualität im öffentlichen Raum wird aktuell durch Defizite beeinträchtigt. Die notwendige Neugestaltung bietet die Chance, die Aufenthalts- und Nutzungsqualität unter Berücksichtigung der funktionalen und klimatischen Anforderungen sowie vorhandener räumlicher Strukturen durch eine zeitgemäße gestalterische Gesamtkonzeption zu verbessern. Hierfür wird ein nicht-offener zweiphasiger freiraumplanerischer Realisierungswettbewerb mit nachfolgender Verhandlungsphase durchgeführt. Vorab findet ein Teilnahmewettbewerb zur Auswahl qualifizierter Teilnehmer:innen statt."""@de;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-mult>;
