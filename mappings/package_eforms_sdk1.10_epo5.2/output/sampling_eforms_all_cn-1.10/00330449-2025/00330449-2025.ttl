<http://data.europa.eu/a4g/resource/b3ce1b4f-8343-47a0-ba45-294fd296ffe6-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
