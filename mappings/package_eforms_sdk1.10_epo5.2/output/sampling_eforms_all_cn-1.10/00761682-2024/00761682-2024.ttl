  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/33d3b80f-f98c-461c-b431-84d3958ab9ff-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/33d3b80f-f98c-461c-b431-84d3958ab9ff-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
