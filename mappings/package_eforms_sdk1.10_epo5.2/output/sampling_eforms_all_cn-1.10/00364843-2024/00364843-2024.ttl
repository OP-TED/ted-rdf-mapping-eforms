<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/Interval$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering true;
  epo:hasEPayment true;
  epo:hasOptionsDescription """Perussopimuskauden jälkeen Tilaajalla on oikeus jatkaa sopimuskautta kahden erillisen optiovuoden (1v + 1v) mittaisen optiokauden ajan.
Tilaaja tekee päätöksen option käytöstä erikseen. Option käyttö on ainoastaan Tilaajan harkinnassa. Tilaaja ilmoittaa Toimittajalle option käyttämisestä viimeistään kuusi (6) kuukautta ennen optiovuoden alkua."""@fi;
  epo:hasPaymentArrangement "Tarkempi kuvaus sopimusluonnoksessa."@fi;
  epo:hasPerformanceConditions "Tarkemmat tiedot sopimusluonnoksessa."@fi;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>
  a epo:ContractTerm;
  epo:definesSpecificPlaceOfPerformance <http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ContractLocation$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1_Address1>;
  epo:hasPlaceOfPerformanceAdditionalInformation "Valtioneuvoston kanslia (hankintayksikkö/tilaaja) kilpailuttaa valtioneuvoston yhteiseksi palveluksi valtioneuvoston edustustilojen palvelut yhtenä kokonaisuutena käyttöoikeussopimuksella. Käyttöoikeussopimuksessa toimintaan liittyvä taloudellinen riski siirretään täysimääräisesti tarjoajalle (toimittaja). Valtioneuvoston edustustiloja ovat: Valtioneuvoston juhlahuoneisto, Säätytalo (parhaillaan remontissa, arvioidaan valmistuvan alkuvuodesta 2026), Kesäranta, Königstedtin kartano, Vartiotupa ja Vierasmaja. Edustustiloihin saattaa sopimusaikana tulla remontteja tai muutoksia ja valtioneuvostolle voi tulla tarve ottaa väliaikaisesti jokin toinen tila edustuskäyttöön tai poistaa jokin tila käytöstä. Tällä sopimuksella tuotetaan palvelut myös väliaikaisiin kohteisiin."@fi .

