<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on kansalliseen lainsäädäntöön ja kansallisiin määräyksiin perustuen yllämainittuja tilanteita vastaavassa samankaltaisessa menettelyssä."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement10>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle itselleen tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen tai jolla on siinä päätös-, edustus- tai valvontavaltaa, on annettu lapsityövoiman käytöstä tai muista ihmiskaupan muodoista lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement11>
  a epo:ExclusionGround;
  dct:description "Tarjoajan osalta on käynnistetty maksukyvyttömyys- tai likvidaatiomenettely."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement12>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut työlainsäädännön mukaisia velvoitteitaan."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement13>
  a epo:ExclusionGround;
  dct:description "Tarjoajan varat ovat selvitysmiehen tai tuomioistuimen hallinnassa."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement14>
  a epo:ExclusionGround;
  dct:description """Tarjoajaa koskee jokin seuraavista tilanteista.
        a) on syyllistynyt väärän tiedon antamiseen poissulkemis- tai valintaperusteiden osalta, 
        b) on jättänyt antamatta tällaisia tietoja,
        c) on toimittanut viiveellä tai ei lainkaan ostajan vaatimia tietoja, tai
        d) on yrittänyt vaikuttaa ostajan päätöksentekoprosessiin asiattomalla tavalla tai hankkinut luottamuksellista tietoa, joista voisi olla sille hankintamenettelyssä asiaankuulumatonta etua, taikka on toimittanut harhaanjohtavia tietoja, joilla voi olla merkittävä vaikutus poissulkemista, tarjoajan valintaa tai hankintaa koskeviin päätöksiin."""@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement15>
  a epo:ExclusionGround;
  dct:description "Tarjoajan hallinto-, johto- tai valvontaelimen jäsen tai edustus-,päätös- tai valvontavaltaa käyttävä henkilö on rikosrekisteristä ilmenevällä lainvoimaisella tuomiolla tuomittu työturvallisuusrikoksesta, työaikasuojelurikoksesta, työsyrjinnästä, kiskonnantapaisesta työsyrjinnästä, työntekijöiden järjestäytymisvapauden loukkaamisesta tai luvattoman ulkomaisen työvoiman käytöstä."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement16>
  a epo:ExclusionGround;
  dct:description "Tarjoajan osallistumisesta hankintamenettelyyn aiheutuu eturistiriitoja."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement17>
  a epo:ExclusionGround;
  dct:description "Tarjoaja tai tarjoajaan liittyvä yritys on antanut ostajalle neuvoja tai muulla tavoin osallistunut hankintamenettelyn valmisteluun."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement18>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on syyllistynyt ammatin harjoittamiseen liittyvään vakavaan virheeseen."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement19>
  a epo:ExclusionGround;
  dct:description "Tarjoajan aikaisempia hankintasopimuksia tai käyttöoikeussopimuksia on irtisanottu ennenaikaisesti tai kyseisen aikaisemman sopimuksen yhteydessä on vaadittu vahingonkorvauksia tai määrätty muita vastaavia seuraamuksia."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement2>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on konkurssissa."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement20>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut sosiaalilainsäädännön mukaisia velvoitteitaan."@fi .

<http://data.europa.eu/a4g/resource/aed3fcec-955c-49e5-b717-67085b505e77-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement21>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut sosiaaliturvamaksujen maksamiseen liittyviä velvoitteitaan sijoittumismaassaan tai ostajan maassa."@fi .

