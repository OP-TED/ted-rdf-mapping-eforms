<http://data.europa.eu/a4g/resource/d30d1a44-4872-44af-a9a5-fef0634255f3-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
