<http://data.europa.eu/a4g/resource/6af7b066-e258-4bad-82aa-922198a332b1-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/6af7b066-e258-4bad-82aa-922198a332b1-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
