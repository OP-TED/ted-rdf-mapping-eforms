<http://data.europa.eu/a4g/resource/ea02bfcd-ab05-42bb-8fa2-621016c46376-01/Procedure/634f5619-e2b1-48ae-b666-b9b568deb89e>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/ea02bfcd-ab05-42bb-8fa2-621016c46376-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
