    <http://data.europa.eu/a4g/resource/518ffe66-e19d-42dc-9e1c-ce283420f4c2-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement9>,
    <http://data.europa.eu/a4g/resource/518ffe66-e19d-42dc-9e1c-ce283420f4c2-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>;
