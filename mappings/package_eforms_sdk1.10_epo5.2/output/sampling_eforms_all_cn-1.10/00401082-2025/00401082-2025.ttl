<http://data.europa.eu/a4g/resource/c76c426c-d271-4952-8676-b41ac3c0853e-01/AwardCriterion$_ContractNotice1_ProcurementProjectLot4_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
