  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/27709acb-8ba9-4f5d-9dba-4cf3057ff94d-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
