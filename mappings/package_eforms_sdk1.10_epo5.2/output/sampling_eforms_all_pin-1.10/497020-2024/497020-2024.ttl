  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/3cbd588e-2074-4d1d-873b-7fcaa0a26b0a-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>;
  epo:usesChannel <http://data.europa.eu/a4g/resource/3cbd588e-2074-4d1d-873b-7fcaa0a26b0a-01/Channel$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Die Stiftung Hamburger Öffentliche Bücherhallen beabsichtigt, ab dem 01.01.2025 einen Rahmenvertrag über die Lieferung und die technische Bearbeitung von Kinder- und Jugendmedien für die Fachabteilung der Stiftung Hamburger Öffentliche Bücherhallen auszuschreiben. Die Fachabteilung Schule der Bücherhallen Hamburg bedient in Kooperation mit der Behörde für Schule und Berufsbildung mehrere Leseförderungsprojekte. Dazu zählen Medienbedarfe für die sogenannten \"Leasing-Bibliotheken\" als Unterstützung bei Aufbau und Betrieb von Schulbibliotheken, Lesekisten und Lese-Hörkisten, die unterstützend bei der Leseförderung für unterschiedliche Altersstufen eingesetzt werden.  Das Kooperationsprogramm Leasingbibliotheken bietet Schulen Unterstützung beim Aufbau einer Schulbibliothek. Ein Teil des Medienbestands wird von der Fachabteilung Schule regelmäßig erworben und anschließend den Schulen ausleihfertig in der internen \"Leasingbibliothek\" bereitgestellt. So ist gewährleistet, dass die Partnerschulen ihren Schülerinnen und Schülern einen wechselnden, attraktiven Medienbestand vorhalten können.  Das Leseförderprojekt \"Lesekisten\" richtet sich an 1. und 2. Klassen und beinhaltet 35 unterschiedliche Medien für Erstleser. Jedes Jahr werden neue Kisten generiert und Titellisten hierfür erstellt.  Das Projekt \"Lese-Hör-Kisten\" richtet sich an Vorschulklassen und soll den Zugang zur Schriftlichkeit vereinfachen und erste Leseerfahrungen ermöglichen. In insgesamt 300 Lese-Hör-Kisten sind 10 Medienkombinationen aus (Sach-)Bilderbuch und textgleicher Audiodatei enthalten.   Die Medienprogramme \"Lesekisten\" und \"Lese-Hörkisten\" benötigen ebenfalls jährlich Medienersatz für die Vervollständigung der bereits genutzten Kisten."@de;
  dct:title "Vorabinformation zur Beschaffung: Medien für Schulbibliotheken"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/3cbd588e-2074-4d1d-873b-7fcaa0a26b0a-01/Identifier/LOT-0001> .

