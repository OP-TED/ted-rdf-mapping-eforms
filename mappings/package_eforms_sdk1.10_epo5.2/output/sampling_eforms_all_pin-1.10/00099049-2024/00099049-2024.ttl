  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/7271aedb-4fa2-420f-b5ad-fea4629a04df-01/ReviewProcedureInformationProvider/ORG-0002>;
