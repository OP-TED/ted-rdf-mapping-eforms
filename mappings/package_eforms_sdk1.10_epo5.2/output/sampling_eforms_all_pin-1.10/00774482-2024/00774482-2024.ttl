  epo:hasLateSubmissionInformationDescription "Die Nachforderung von Unterlagen erfolgt gemäß den Angaben in den Formblättern 211EU/211VS und 216."@de;
  epo:hasLateSubmissionPermission <http://publications.europa.eu/resource/authority/missing-info-submission/late-all>;
  epo:hasReceiptTenderDeadline "2025-01-31T23:59:00+01:00"^^xsd:dateTime;
