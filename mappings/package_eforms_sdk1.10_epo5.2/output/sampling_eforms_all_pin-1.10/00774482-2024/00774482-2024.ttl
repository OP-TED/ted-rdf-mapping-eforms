<http://data.europa.eu/a4g/resource/29c52e0b-5085-420d-904b-c6398afb0f2f-01/ChangeInformation$_PriorInformationNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Changes1_Change1>
  a epo:ChangeInformation;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/29c52e0b-5085-420d-904b-c6398afb0f2f-01/Notice>;
  epo:hasChangeDescription "Beschreibung der Beschaffung: Errichtung der Energieversorgung  Umfang der Auftragsvergabe:  Einbau von 8  Erdkollektoren (Kollektorrohr Cu 10 mm), Tiefe 1,2m/1,7m, 2 Lagen, Fläche je 210 m, Kältemittel R290, Erdarbeiten (Bett/Abdeckung) 8 Stück Erdwärmepumpe (R290) 15 KW als Direktverdampfer, geschaltet in Kaskade 3 Luft-Wärmepumpe (R290) 15 kW, Heizen/ Kühlen Nah-Wärme/ Kälte-Netz zum Technikgebäude und zu den 3 Gebäuden In Technikzentrale 2 Pufferspeicher Heizung und 1 Pufferspeicher Kälte, Ausdehnungsgefäße, Pumpen,  Wasseraufbereitung  Laufzeit des Vertrages:  24 Monate  Zusätzliche Angaben:  Beginn/Ende: 04/25 - 04/27 Einzelfristen 04/2025 - 05/2025  Erdkollektoren und Nahwärmenetz  10/2025 - 01/2026  Technikzentrale und Wärmepumpen  12/2025                   prov. Heizbetrieb 04/27                       Übergabe  Voraussichtlicher Tag der Veröffentlichung der Auftragsbekanntmachung:  15.03.2025"@de;
  epo:isProcurementDocumentChanged false;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/29c52e0b-5085-420d-904b-c6398afb0f2f-01/Notice/133949ef-dbd3-48c3-8d66-684167f87f9a-01>;
  epo:relatesToEFormSectionIdentifier <http://data.europa.eu/a4g/resource/29c52e0b-5085-420d-904b-c6398afb0f2f-01/Notice/133949ef-dbd3-48c3-8d66-684167f87f9a-01/Identifier/PROCEDURE> .

