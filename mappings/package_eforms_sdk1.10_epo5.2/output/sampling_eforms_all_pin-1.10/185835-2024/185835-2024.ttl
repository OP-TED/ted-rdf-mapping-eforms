<http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation """Der Beitritt muss spätestens bis 30.04.24 erfolgen. Danach ist ein Beitritt nicht mehr möglich (befristetes Beitrittsrecht).
Es handelt sich bei diesen Verträgen nicht um einen öffentlichen Auftrag im Sinne von § 103 Absatz 1 des Gesetzes gegeben Wettbewerbsbeschränkungen (GWB), da keinem Wirtschaftsteilnehmer ein exklusiver Status im Wege einer vergaberechtlich relevanten Auswahlentscheidung eingeräumt wird. Der 4. Teil des GWB sowie die Vergabeverordnung finden keine Anwendung."""@de;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/MonetaryValueLot$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/Lot/Identifier/->;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/LotPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA false;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/AccessTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/FrameworkAgreementTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/SubmissionTerm$_PriorInformationNotice1_ProcurementProjectLot1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/ParticipationCondition$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1>,
    <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/DynamicPurchaseSystemTechnicalUsage$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """Die KKH bietet ab dem 01.04.2024 ihren Versicherten auf der Basis einer Satzungsleistung bei bestehender BOT-Therapie (basal-unterstützende orale Therapie) bei Diabetes mellitus Typ 2 zeitlich befristet eine Versorgung mit einem rtCGM-System an. Mit der Bekanntmachung 693115-2023 - Wettbewerb - TED (europa.eu) sowie der Aktualisierung 121540-2024 wurde die Beabsichtigung von Vertragsabschlüssen bekannt gegeben. 
Die KKH hat diesbezüglich mehrere bundesweit gültige Verträge über die die Versorgung ihrer Versicherten mit rtCGM-Systemen nach § 53 SGB X geschlossen.
Leistungserbringer mit der Absicht, einem der Verträge beizutreten, gewährt die KKH (wie in der Bekanntmachung 121540-2024 beschrieben) ein zeitlich befristetes Beitrittsrecht bis zum 30.04.2024. Diese Leistungserbringer erhalten die Unterlagen auf Anfrage unter folgender E-Mail-Adresse: versorgungsvertraege@kkh.de. Voraussetzungen für die Anforderung der Vertragsunterlagen, sowie des Beitrittes ist die Vorlage einer gültigen Präqualifizierungsurkunde."""@de;
  dct:title "Bekanntmachung des Abschlusses von Verträgen über die Versorgung mit rtCGM-Systemen nach § 53 SGB X "@de;
  adms:identifier <http://data.europa.eu/a4g/resource/46f2daf1-d466-47f5-9d08-848608485408-01/Identifier/LOT-0001> .

