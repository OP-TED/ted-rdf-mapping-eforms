<http://data.europa.eu/a4g/resource/6a2984a5-248b-438b-8798-39d11ff9ef65-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot10_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/price>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/ord-imp>;
  cccev:weight 1.0;
  dct:description "Die einzelnen Anforderungen, die in den Leistungsverzeichnissen kommuniziert werden, stellen einen fixen Leistungskatalog dar, der zu erfüllen ist. Dementsprechend konkurrieren die Bieter einzig und allein über den Preis um einen Zuschlag. Die eingehenden Angebote werden dementsprechend anhand des Preises in eine Rangfolge eingeordnet."@de;
  skos:prefLabel "einziges Kriterium"@de .

