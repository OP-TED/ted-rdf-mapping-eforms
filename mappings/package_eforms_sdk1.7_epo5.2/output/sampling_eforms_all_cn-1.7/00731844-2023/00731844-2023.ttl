  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/aec5077a-8bfa-4fc3-ad6f-a04e0930c8ee-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/aec5077a-8bfa-4fc3-ad6f-a04e0930c8ee-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/aec5077a-8bfa-4fc3-ad6f-a04e0930c8ee-01/GreenProcurement$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType2>,
