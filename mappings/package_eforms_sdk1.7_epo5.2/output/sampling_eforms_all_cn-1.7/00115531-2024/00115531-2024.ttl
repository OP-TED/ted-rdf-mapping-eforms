    <http://data.europa.eu/a4g/resource/82b22c51-a5e2-48c1-beb7-4d115a505357-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria6>,
    <http://data.europa.eu/a4g/resource/82b22c51-a5e2-48c1-beb7-4d115a505357-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria7>,
    <http://data.europa.eu/a4g/resource/82b22c51-a5e2-48c1-beb7-4d115a505357-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria8>,
    <http://data.europa.eu/a4g/resource/82b22c51-a5e2-48c1-beb7-4d115a505357-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria9>;
  dct:description "El objeto de esta licitación es la explotación por un lado, del servicio de las cafeterías de la Gerencia de Atención Integrada de Albacete situadas en el Hospital General Universitario de Albacete y en el Hospital Universitario Nuestra Señora del Perpetuo Socorro, ofreciendo el servicio fijo de menús al personal de guardia del Hospital (y personal autorizado), pacientes, usuarios y resto de personal, y por otro lado, la explotación de las máquinas expendedoras situadas tanto en el Hospital General Universitario de Albacete , como en el Hospital Universitario Nuestra Señora del Perpetuo Socorro y en los Centros de Salud ."@es;
  dct:title "Concesón servicio de Cafetería GAIAB"@es;
  adms:identifier <http://data.europa.eu/a4g/resource/82b22c51-a5e2-48c1-beb7-4d115a505357-01/Identifier/LOT-0000> .

