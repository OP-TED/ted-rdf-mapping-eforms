  epo:concernsNotice <http://data.europa.eu/a4g/resource/45a5094d-9637-4b24-a517-f7455aa68c32-01/Notice>;
  epo:hasChangeDescription "Aufgrund einer eingegangenen Rüge haben wir gemeinsam mit der zuständigen Fachabteilung die Bedingungen hinsichtlich der Forderung zur Benennung der Firma Binz als Unterauftragnehmer für den Austausch der zulassungspflichtigen Teile geprüft und angepasst. Die Teilnahmefrist wurde auf den 08.05.2025 12 Uhr verlängert und die Bieter wurden informiert."@de;
  epo:hasChangeJustification <http://publications.europa.eu/resource/authority/change-corrig-justification/update-add>;
  epo:hasChangeReasonDescription "Aufgrund einer eingegangenen Rüge wurde die Eignung in der Anlage 1b und Anlage 1d angepasst und die Teilnahmefrist verlängert."@de;
  epo:hasProcurementDocumentChangeDate "2025-04-01T00:00:00+02:00"^^xsd:dateTime;
  epo:isProcurementDocumentChanged true;
  epo:refersToPreviousNotice <http://data.europa.eu/a4g/resource/45a5094d-9637-4b24-a517-f7455aa68c32-01/Notice/1a5a3867-ae43-4965-8469-9cf539ddaf2a-01>;
