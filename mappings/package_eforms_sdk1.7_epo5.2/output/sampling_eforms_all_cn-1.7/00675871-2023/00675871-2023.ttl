<http://data.europa.eu/a4g/resource/0ca2c81a-4f7d-4005-8313-018269ed169d-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/0ca2c81a-4f7d-4005-8313-018269ed169d-01/ReviewProcedureInformationProvider/ORG-0003>;
