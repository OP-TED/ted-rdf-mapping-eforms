  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/bdfb3932-bc87-4c2e-a504-5ef259909c0b-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
    <http://data.europa.eu/a4g/resource/bdfb3932-bc87-4c2e-a504-5ef259909c0b-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>;
  epo:usesChannel <http://data.europa.eu/a4g/resource/bdfb3932-bc87-4c2e-a504-5ef259909c0b-01/Channel$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Gegenstand dieses Verfahrens ist die Beschaffung von Hard-und Software für die Einsatzdokumentation für Rettungsdienste einschließlich der Pflege für den beauftragten Zeitraum. Die Vergabe wird im Rahmen der gemeinsamen Beschaffung durch die Gemeinnützige Rettungsdienst Märkisch-Oderland GmbH stellvertretend auch für die weiteren Auftraggeber durchgeführt. Mit dem Zuschlag kommt ein Vertrag mit dem jeweiligen Auftraggeber zustande. Weiter Details können den Vergabeunterlagen entnommen werden."@de;
  dct:title "Mobile Einsatzdokumentation Rettungsdienst"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/bdfb3932-bc87-4c2e-a504-5ef259909c0b-01/Identifier/LOT-0001> .

