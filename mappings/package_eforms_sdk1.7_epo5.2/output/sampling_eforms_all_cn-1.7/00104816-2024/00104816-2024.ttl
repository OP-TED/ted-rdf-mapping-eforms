<http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/Procedure/1ef6245c-9fdb-485e-9149-f77068379899>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/Procedure/Identifier/Fachanwendung%20Personalwesen>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-single>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  dct:description """Gesucht wird eine integrierte Softwarelösung, welche als Software as a Service (SaaS) sämtliche Prozesse des Personalwesens in einer homogenen Fachanwendung abdeckt. Die Fachanwendung Personalwesen inklusive Gehaltsabrechnung muss alle gesetzlichen Anforderungen sowie die Anforderungen des öffentlichen Dienstes für die Abrechnung erfüllen und automatisch auf dem aktuellen Stand sein, auch beim Thema Datenschutz. Außerdem muss besonders beim Cloudsystem gewährleistet sein, dass sämtliche Dokumente und Daten sicher und verschlüsselt gespeichert werden.

Erforderlich sind:

- Cloudlösung
- Support und Administration
- Personalabrechnung für den öffentlichen Dienst
- GKV zertifiziertes Abrechnungssystem
-  Möglichkeit der Abrechnung mehrerer Unternehmen
- Schnittstelle zur Finanzbuchhaltung (Kameralistik)
- Stellenplan öffentlicher Dienst
- Integriertes Personalmanagement
- Aus- und Fortbildungsmanagement
- Personalentwicklung und Bewerber-Management
- Personalkostenplanung
- Personalcontrolling
- Zeitwirtschaft inklusive Schichtplan
- Reisekostenabrechnung auf der Grundlage des Bayerischen Reisekostenrechts
- Zeit-/Reise-/Urlaubs-Management
- Betriebliches Eingliederungsmanagement (BEM)
- Mitarbeiterportal
- Digitale Personalakte
- Doku – Korrespondenzmanagement
- Datenübernahme aus Altsystem
- Data-Management und DSGVO-Selbstauskunft"""@de;
  dct:title "Fachanwendung Personalwesen"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/7e8e367f-18cc-487b-972d-d47bf91b3839-01/Procedure/Identifier/1ef6245c-9fdb-485e-9149-f77068379899> .

