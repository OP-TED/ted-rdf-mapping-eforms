<http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/Procedure/4b10d727-809f-45ea-a2b8-ddb0282f4142>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "In case of unavailability or disruptions in the functioning of the electronic means of communication provided in Section 5.1.11 in the last 5 calendar days before the time limit for receipt indicated in Section 5.1.12, the main buyer reserves the right to extend this time limit and publish the extension at the Internet address provided in Section 5.1.11, without a preceding publication of a change notice to this notice. Economic operators interested in this procurement are invited to subscribe to the call for tenders at the address in Section 5.1.11 in order to get notified when new information or documents are published."@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/Procedure/Identifier/GROW%2F2023%2FOP%2F0042>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description """The aim of the study is to identify and evaluate options to better address complex substitution processes in chemicals legislation, in particular in the context of REACH restrictions and authorisations, or as a complement to chemicals legislation, through co-operative planning approaches such as substitution plans. 

These options have multiple objectives:
-	fostering substitution of harmful substances to increase the protection of human health and the environment and reducing societal costs of chemical pollution, 
-	minimise business risks associated with harmful substances contained in products and their substitution,
-	promote innovation for safer alternatives in the EU;
-	enhance regulatory efficiency by enabling a better interplay between regulation and collaborative industry action, building upon expert and stakeholder driven planning of substitution processes as well as front-runner’s initiatives, and taking inspiration from the Transition Pathway for the Chemicals Industry."""@en;
  dct:title "Study on strengthening the role of substitution planning in the context of REACH and other EU chemicals legislation"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/20f46c01-6969-4d62-ae3f-f3b3b683bff0-01/Procedure/Identifier/4b10d727-809f-45ea-a2b8-ddb0282f4142> .

