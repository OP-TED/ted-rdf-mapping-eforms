  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/poi-exa>;
  cccev:weight 20.0;
  dct:description """•	Is het een realistisch en haalbaar concept?
•	Is het gefaseerd uitvoerbaar – en over welke periode?"""@nl;
  skos:prefLabel "Ontwikkelstrategie"@nl .

