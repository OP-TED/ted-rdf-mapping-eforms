  epo:hasSubcontractorsProposedAboveObligation 0.0 .

<http://data.europa.eu/a4g/resource/7120963d-aae8-460b-9cf5-d75cf86a8e7c-01/SubmissionTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:SubmissionTerm;
  epo:definesTenderReceiver <http://data.europa.eu/a4g/resource/7120963d-aae8-460b-9cf5-d75cf86a8e7c-01/TenderReceiver/ORG-0001organization>;
  epo:hasECataloguePermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:hasESubmissionPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasGuaranteeDescription "Sicherheitsleistung für die Vertragserfüllung (§ 17 VOB/B): Soweit die Auftragssumme mindestens 250.000 Euro ohne Umsatzsteuer beträgt, ist Sicherheit für die Vertragserfüllung in Höhe von fünf Prozent der Auftragssumme (inkl. Umsatzsteuer, ohne Nachträge) zu leisten. Sicherheitsleistung für Mängelansprüche (§ 17 VOB/B): Die Sicherheit für Mängelansprüche beträgt drei Prozent der Summe der Abschlagszahlungen zum Zeitpunkt der Abnahme (vorläufige Abrechnungssumme)."@de;
  epo:hasLanguage <http://publications.europa.eu/resource/authority/language/DEU>;
  epo:hasLateSubmissionInformationDescription "Die unter den Punkten der Eignungskriterien zu 1. Eignung zur Berufsausübung; zu 2. Wirtschaftliche und finanzielle Leistungsfähigkeit; zu 3. Technische und berufliche Leistungsfähigkeit genannten Eignungsunterlagen sind nach gesonderter Aufforderung durch die Vergabestelle zu vervollständigen."@de;
  epo:hasLateSubmissionPermission <http://publications.europa.eu/resource/authority/missing-info-submission/late-all>;
  epo:hasReceiptParticipationRequestDeadline "2024-04-10T09:00:00+02:00"^^xsd:dateTime;
  epo:hasSubmissionURL "https://www.evergabe-online.de/tenderdetails.html?id=615191"^^xsd:anyURI;
  epo:hasTenderSubcontractingInformation <http://publications.europa.eu/resource/authority/subcontracting-indication/none>;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:isAdvancedElectronicSignatureRequired false;
  epo:isGuaranteeRequired true;
  epo:isMultipleTenderSubmissionAllowed true .

