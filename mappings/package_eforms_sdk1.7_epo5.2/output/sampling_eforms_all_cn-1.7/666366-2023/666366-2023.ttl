  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/3e9414c1-f716-4130-9c0f-3c0d3c308087-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/3e9414c1-f716-4130-9c0f-3c0d3c308087-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/3e9414c1-f716-4130-9c0f-3c0d3c308087-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/3e9414c1-f716-4130-9c0f-3c0d3c308087-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>,
