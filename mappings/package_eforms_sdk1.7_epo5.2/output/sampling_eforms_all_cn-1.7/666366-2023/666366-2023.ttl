  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/3e9414c1-f716-4130-9c0f-3c0d3c308087-01/ReviewProcedureInformationProvider/ORG-0003>;
