<http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation """This is a framework agreement for entire Vygruppen.

The primary delivery is expected to be foiling of new and older trains. There will also be a smaller volume related to signs and other services. It is essential that suppliers are prepared to foil trains where they are available, when they are available. This will require flexibility and planning from all parties, and logistics and further descriptions will be defined in mini-competitions"""@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/MonetaryValueLot$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/Lot/Identifier/BPM000214>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/LotPurpose$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:hasRecurrenceDescription "N/A"@en;
  epo:isCoveredByGPA true;
  epo:isRecurrent false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/AccessTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/FrameworkAgreementTerm$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/MultipleStageProcedureTerm$_ContractNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/SubmissionTerm$_ContractNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01AccessTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1Doc1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/ParticipationCondition$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>;
  dct:description """Vygruppen AS aims enter a parallel framework agreement with up to 3 suppliers for the production and delivery of signs and foil for Vgruppen's vehicles and buildings. By vehicle is mainly meant trains. Buses have a small amount of foiling, as new buses are mostly delivered fully foiled. Deliveries will mainly take place in Norway, but deliveries to other Nordic countries may also be relevant. 

The procurement includes the delivery of signs and brands, foiling services and other services.  

A more detailed description of the procurement can be found in Appendix A - Delivery description, with associated annexes."""@en;
  dct:title "Signs and foilingsservices"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/00ec54d7-6117-4515-af56-5a4a06b70cc9-01/Identifier/LOT-0001> .

