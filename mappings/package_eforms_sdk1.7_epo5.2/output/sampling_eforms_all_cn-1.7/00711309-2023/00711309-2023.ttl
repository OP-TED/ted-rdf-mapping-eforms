<http://data.europa.eu/a4g/resource/6f330254-8a06-4f6e-b20c-a9938d3ae76d-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
