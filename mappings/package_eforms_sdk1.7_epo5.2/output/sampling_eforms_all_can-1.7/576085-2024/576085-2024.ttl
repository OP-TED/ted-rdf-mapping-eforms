  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/6f29ad0d-c3a6-40bd-b8d0-2d8711c50228-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/6f29ad0d-c3a6-40bd-b8d0-2d8711c50228-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  dct:description "Ziel dieser Beschaffung ist die Beauftragung eines Unternehmens mit der Wartung der Gebäudeautomationsanlagen Fabrikat Honeywell (DDC bis Feld) und sowie der Wartung der darauf aufbauenden Gebäudeleittechnik / Servertechnik."@de;
  dct:title "Rahmenvereinbarung zur Wartung und Instandhaltung der Gebäudeleittechnik der Universität Potsdam"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/6f29ad0d-c3a6-40bd-b8d0-2d8711c50228-01/Procedure/Identifier/8d0ad054-1c07-4348-9304-fa2b1ee664c9> .

