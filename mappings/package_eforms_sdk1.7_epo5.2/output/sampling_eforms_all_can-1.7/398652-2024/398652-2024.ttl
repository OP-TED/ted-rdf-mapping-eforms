<http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/Procedure/5bb3d155-b5fc-4bd9-bc00-7179dcd5822e>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Gegunde opdracht."@nl;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/Procedure/Identifier/INCS70051>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0023>;
  epo:hasMainFeature """De opdracht betreft het leveren, plaatsen en onderhouden van billboards op . De concessiehouder verkrijgt het exclusieve recht billboards te exploiteren. 

In de gemeente Purmerend staan momenteel op vijf locaties billboards. Deze locaties blijven beschikbaar. Naast deze vijf locaties worden er twee locaties toegevoegd.  Van de in totaal zeven billboards mogen er zes dubbelzijdig worden gebruikt en één enkelzijdig. De locaties van de billboards zijn op drukke punten waar veel verkeer dagelijks passeert. Openbare procedure, twee rondes nota van inlichtingen"""@nl;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  dct:description "De opdracht betreft het leveren, plaatsen en onderhouden van billboards. De concessiehouder verkrijgt het exclusieve recht billboards te exploiteren. De gemeente wil een concessieovereenkomst aangaan met één exploitant. Onbekend"@nl;
  dct:title "Concessieovereenkomst voor levering, plaatsing, onderhoud en exploitatie van billboards"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/Procedure/Identifier/5bb3d155-b5fc-4bd9-bc00-7179dcd5822e> .

