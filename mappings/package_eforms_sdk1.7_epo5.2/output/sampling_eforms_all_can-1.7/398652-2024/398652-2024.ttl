  epo:isCoveredByGPA false;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  dct:description """De opdracht betreft het leveren, plaatsen en onderhouden van billboards. De concessiehouder verkrijgt het exclusieve recht billboards te exploiteren. 

In de gemeente Purmerend staan momenteel op vijf locaties billboards. Deze locaties blijven beschikbaar. Naast deze vijf locaties worden er twee locaties toegevoegd.  Van de in totaal zeven billboards mogen er zes dubbelzijdig worden gebruikt en één enkelzijdig. De locaties van de billboards zijn op drukke punten waar veel verkeer dagelijks passeert. Onbekend"""@nl;
  dct:title "Perceel 1 billboards"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/da0d859a-1ebb-4ec3-b90d-627b47c309e5-01/Identifier/LOT-0000> .

