  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/df3fdcaf-2c77-43c4-bdf1-5541b22b54bf-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
