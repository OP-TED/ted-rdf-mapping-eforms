  epo:hasLegalBasisDescription "vgv";
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/46c2741f-4a58-4574-991c-a80a0169b45a-01/Lot/LOT-0001>;
