  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/5c35a3e3-f292-4ac8-b94b-1f48bcd4532b-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
