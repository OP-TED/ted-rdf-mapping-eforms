  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
