  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/GreenProcurement$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_StrategicProcurement1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/Lot/Identifier/2024_64_0024>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/AwardEvaluationTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Dem DFG geförderten Projekt \"West German Genome Center (WGGC)\" als eines von vier Kompetenzzentren werden jährlich Drittmittel für die Umsetzung von Sequenzierprojekten zur Verfügung gestellt. Für die Bearbeitung dieser Projekte werden Produkte des Lieferanten und Herstellers Illumina benötigt. Die Lieferung dieser Produkte erfolgt in Form von Abrufen aktuell bis zum Laufzeitende (31.12.2025) des WGGC. Bei der Parallelsequenzierung werden Millionen in Adapter eingefasste DNA-Fragmente genutzt. Illumina ist auf die SBS Technologie hochspezialisiertes Unternehmen, das die parallele und gleichzeitige Sequenzierung vieler Proben durch die Nutzung der entsprechenden Geräte und Verbrauchsmaterialien des gleichnamigen Herstellers ermöglicht."@de;
  dct:title "Universität zu Köln - Verbrauchsmaterialien für Parallelsequenzierungen"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/6708a41f-6736-4b60-9d3f-43e28aad9158-01/Identifier/LOT-0001> .

