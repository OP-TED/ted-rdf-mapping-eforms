  epo:hasLaunchFrameworkAgreementMaximumValue <http://data.europa.eu/a4g/resource/9a804d06-7c96-409f-a27b-40c2496226ab-01/ProcedureValueEstimateExtension$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "vgv";
  epo:hasMainFeature "Vgl. Vergabeunterlagen, insb. Verfahrensbrief"@de;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/9a804d06-7c96-409f-a27b-40c2496226ab-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/9a804d06-7c96-409f-a27b-40c2496226ab-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/9a804d06-7c96-409f-a27b-40c2496226ab-01/ProcedureTerm$_ContractAwardNotice1_TenderingTerms1_ProcurementLegislationDocumentReference2>;
  dct:description "Die Auftraggeber sind Sachaufwandsträger Ihrer staatlichen Gesundheitsämter als untere Gesundheitsbehörde. Um die im Zuge der Corona-Pandemie aufgedeckten Mängel in der Digitalisierung des öffentlichen Gesundheitswesens zu beheben, hat der Bund das umfangreiche Förderprogramm \"Digitales Gesundheitsamt 2025\" aus Mitteln der europäischen Resilienz-Faszilität aufgelegt.   Im März 2023 startete der Bund einen sog. zweiten Förderaufruf. Die Auftraggeber haben jeweils abgestimmte Förderanträge für ein Verbundprojekt gestellt. Gegenstand des Förderantrags sind Maßnahmen zur SOLL-Standardisierung von Prozessen in staatlichen Gesundheitsämtern mit einhergehender Automatisierung und Schaffung interoperabler Schnittstellen. Das Projekt mit dem Namen \"Datengestützte Zusammenarbeit und anwendungsübergreifende Prozessautomatisierung im ÖGD (\"VPro4ÖGD\", im Folgenden \"das Projekt\") ist genehmigt. Auf die Förderanträge zum Verbundprojekt hin hat jeder Auftraggeber einen individuellen Zuwendungsbescheid erhalten.  Die Auftraggeber suchen einen Partner zur Begleitung und Umsetzung des Projekts \"VPro4ÖGD\". Der Partner soll z.B. Digitalisierungsstrategien für die Auftraggeber erarbeiten, IST-Prozesse erfassen, eine möglichst homogene SOLL-Prozess-Standardisierung und den Aufbau eines Netzwerkes zwischen den beteiligten Gesundheitsämtern durchführen. Dabei fallen auch Beratungsleistungen aus den Bereichen Change Management und Mitarbeiterbeteiligung an."@de;
  dct:title "Landkreis Lindau et.al. - Ex-Post - Verbundprojekt Digitales Gesundheitsamt \"VPro4ÖGD\" - Rahmenvereinbarung"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/9a804d06-7c96-409f-a27b-40c2496226ab-01/Procedure/Identifier/168c96f7-167e-4397-b2b8-2fdafe8e0a57> .

