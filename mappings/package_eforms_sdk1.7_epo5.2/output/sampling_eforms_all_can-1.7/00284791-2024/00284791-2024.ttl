<http://data.europa.eu/a4g/resource/5551568a-6150-4c95-a663-91a968189d05-01/Procedure/4c0e9c85-2e8d-4b7b-bfab-2e44fd27be30>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/5551568a-6150-4c95-a663-91a968189d05-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
