  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/08f620b7-ff03-4f52-84d3-9cabc97d7c60-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
