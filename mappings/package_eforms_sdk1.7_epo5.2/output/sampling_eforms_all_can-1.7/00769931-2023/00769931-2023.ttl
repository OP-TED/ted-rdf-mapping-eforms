  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/Lot/Identifier/1>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  dct:description "Aufgrund der gewonnenen Erkenntnisse aus dem SAP-Roadmap Projekt sollen vor der technischen Migration auf S/4HANA/ H4S4/ BW4HANA zunächst die fachlichen Voraussetzungen in den von den Hochschulen betriebenen SAP Modulen geschaffen werden. Es handelt sich im Rahmen dieser Ausschreibung um die Einführung der Geschäftspartner, die Einführung des neuen Hauptbuchs und die Einführung des BCS. Die Fachkonzepterarbeitung, Implementierung im Hochschulreferenzmodell mit Roll-out in die Hochschulsysteme und die Unterstützung bei der Produktivsetzung inkl. der entsprechend notwendigen Migrationstätigkeiten sind Gegenstand der vorliegenden Ausschreibung. Für die Hochschule Darmstadt (h_da) und eventuell weitere interessierte Hochschulen soll die Erarbeitung einer Konzeption zur Nutzung des SAP-PS angeboten werden. Das Projekt soll im Januar 2024 starten und muss zum 31.12.2025 abgeschlossen sein. Die Vergabe erfolgt in 2 Losen: - Los 1: Einführung der Geschäftspartner, Einführung des Neuen Hauptbuchs - Los 2: Einführung des PSM-BCS, Konzeption des SAP-PS"@de;
  dct:title "Einführung der Geschäftspartner, Einführung des Neuen Hauptbuchs"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/Identifier/LOT-0002> .

<http://data.europa.eu/a4g/resource/fee7379d-b90c-43bb-ac67-3563c2e80a75-01/Lot/LOT-0003>
