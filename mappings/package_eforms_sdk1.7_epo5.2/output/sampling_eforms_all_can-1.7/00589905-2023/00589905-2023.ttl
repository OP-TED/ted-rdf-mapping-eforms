  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/Lot/Identifier/JRC%2FKRU%2F2023%2FRP%2F0270>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """The JRC Karlsruhe plans to purchase a criticality alarm system. 
In rooms in which a critical mass of fissile nuclides cannot be ruled or in rooms where 
larger quantities of fissile material are handled, criticality measurement chambers shall be 
installed. These measure the gamma dose rate occurring in the event of a criticality and 
trigger a criticality alarm if a limit value is exceeded. The alarm is signalled visually and 
acoustically on site (also displayed before access to the monitored rooms) and transmitted 
to the control room (optical and acoustic signaling)."""@en;
  dct:title "Supply of a criticality alarm system for the JRC Karlsruhe"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/Identifier/LOT-0001> .

