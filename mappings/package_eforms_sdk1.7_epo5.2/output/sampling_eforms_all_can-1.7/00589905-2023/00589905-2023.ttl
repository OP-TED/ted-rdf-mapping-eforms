  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/Procedure/Identifier/JRC%2FKRU%2F2023%2FRP%2F0270>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  dct:description """The JRC Karlsruhe plans to purchase a criticality alarm system. 
In rooms in which a critical mass of fissile nuclides cannot be ruled or in rooms where 
larger quantities of fissile material are handled, criticality measurement chambers shall be 
installed. These measure the gamma dose rate occurring in the event of a criticality and 
trigger a criticality alarm if a limit value is exceeded. The alarm is signalled visually and 
acoustically on site (also displayed before access to the monitored rooms) and transmitted 
to the control room (optical and acoustic signaling)."""@en;
  dct:title "Supply of a criticality alarm system for the JRC Karlsruhe"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/76a1e6de-408b-4d24-ab1b-3380a94a37db-01/Procedure/Identifier/339b0cb4-0450-4f56-8967-539ee580927e> .

