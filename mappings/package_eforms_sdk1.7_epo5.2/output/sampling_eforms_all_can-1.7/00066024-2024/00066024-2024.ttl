  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/054ca2f9-25c7-4209-ba6c-d3f4a0f31bd4-01/ReviewProcedureInformationProvider/ORG-0003>;
