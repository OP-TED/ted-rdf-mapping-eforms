  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/624b79a5-53e3-4fb4-a08b-b0e7927c6b72-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
