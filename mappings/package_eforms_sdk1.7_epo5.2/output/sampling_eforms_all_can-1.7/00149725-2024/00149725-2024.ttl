<http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/Procedure/5d3d2711-c293-48ed-ac88-453e903c6102>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/Procedure/Identifier/AD23185>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0023>;
  epo:hasMainFeature "Prijs-kwaliteit"@nl;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/DirectAwardTerm$_ContractAwardNotice1_TenderingProcess1_ProcessJustification1>;
  dct:description """De gemeente Meppel wil een overeenkomst aangaan om een collectieve aanvullende zorgverzekering (gemeentepolis) aan de doelgroep minima aan te kunnen bieden. De gemeente wil met deze voorziening inwoners met een laag inkomen en een gemiddelde tot hoge zorgvraag goede toegang bieden tot uitgebreide en betaalbare zorg. De totale groep minima die in aanmerking komt voor de Gemeentepolis bestaat, op basis van een berekening van BS&F, uit circa 2.400 inwoners. Het geschatte aantal inwoners dat gebruik maakt of gebruik gaat maken van de Gemeentepolis is circa 550. Genoemde aantallen zijn gebaseerd op het totaal van inwoners boven de achttien (18) jaar oud die voldoen aan de door de gemeente Meppel gestelde inkomensgrens. Voor inwoners van de gemeente Meppel ligt deze inkomensgrens op 120% van de bijstandsnorm.
Op basis van het huidige deelnamepercentage – en aantal is de omvang van de opdracht ca.€ 1.265.000,- per jaar."""@nl;
  dct:title "Collectieve zorgverzekering Minima (Gemeentepolis)"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/Procedure/Identifier/5d3d2711-c293-48ed-ac88-453e903c6102> .

