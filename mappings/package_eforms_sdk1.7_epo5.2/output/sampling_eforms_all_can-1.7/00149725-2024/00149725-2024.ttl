  epo:isCoveredByGPA false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  dct:description "Collectieve zorgverzekering Minima (Gemeentepolis) De totale groep minima die in aanmerking komt voor de Gemeentepolis bestaat, op basis van een berekening van BS&F, uit circa 2.400 inwoners. Het geschatte aantal inwoners dat gebruik maakt of gebruik gaat maken van de Gemeentepolis is circa 550. Genoemde aantallen zijn gebaseerd op het totaal van inwoners boven de achttien (18) jaar oud die voldoen aan de door de gemeente Meppel gestelde inkomensgrens. Voor inwoners van de gemeente Meppel ligt deze inkomensgrens op 120% van de bijstandsnorm. Op basis van het huidige deelnamepercentage – en aantal is de omvang van de opdracht ca. € 1.265.000,- per jaar."@nl;
  dct:title "Collectieve zorgverzekering Minima (Gemeentepolis)"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/f6d4d570-d1fb-47a1-8cee-ec5534bb1601-01/Identifier/LOT-0000> .

