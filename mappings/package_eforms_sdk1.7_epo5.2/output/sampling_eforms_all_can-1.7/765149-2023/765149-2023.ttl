  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/e9a9c7a3-1be6-42a1-a7ad-acf82fe411f3-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/e9a9c7a3-1be6-42a1-a7ad-acf82fe411f3-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/e9a9c7a3-1be6-42a1-a7ad-acf82fe411f3-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/e9a9c7a3-1be6-42a1-a7ad-acf82fe411f3-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  dct:description """Dovre, Lesja, Lom, Sel, Skjåk and Vågå municipalities intend to enter into a framework agreement for the purchase of new vehicles for use in the municipalities. The driveline is mainly electricity, but it can also include hybrid, petrol and diesel. Cf. requirements for, among other things, public vehicle maintenance. The municipalities have partly procured electric vehicles and electric drivelines will be preferred where possible. Fossil drivelines will only be procured exceptionally. Tenderers shall enclose CO2 emission figures for any fossile vehicles based on the information given in the Norwegian Public Roads Administration's \"New Vehicle Selector\". SVV - New vehicle selector as well as equivalent emission figures for relevant alternatives.

Sel, Skjåk, Lom and Vågå will participate in the contract when they are signed. Dovre and Lesja shall have an option to join the agreement.

See part II Annex 1 the Contracting Authority's requirement specifications for further information on the contents of the procurement."""@en;
  dct:title "2023 - 6K - Procurement of vehicles "@en;
  adms:identifier <http://data.europa.eu/a4g/resource/e9a9c7a3-1be6-42a1-a7ad-acf82fe411f3-01/Identifier/LOT-0000> .

