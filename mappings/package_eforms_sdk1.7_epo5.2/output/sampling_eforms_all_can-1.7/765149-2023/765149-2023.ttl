  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/e9a9c7a3-1be6-42a1-a7ad-acf82fe411f3-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
