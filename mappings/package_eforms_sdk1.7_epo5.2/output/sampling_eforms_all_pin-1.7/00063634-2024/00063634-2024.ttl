<http://data.europa.eu/a4g/resource/590d507a-0101-4e8c-a060-e8d198048f65-01/PlannedProcurementPart/PAR-0001>
  a epo:PlannedProcurementPart;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/590d507a-0101-4e8c-a060-e8d198048f65-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
