<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement13>
  a epo:ExclusionGround;
  dct:description "Tarjoajan osallistumisesta hankintamenettelyyn aiheutuu eturistiriitoja."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement14>
  a epo:ExclusionGround;
  dct:description "Tarjoaja tai tarjoajaan liittyvä yritys on antanut ostajalle neuvoja tai muulla tavoin osallistunut hankintamenettelyn valmisteluun."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement15>
  a epo:ExclusionGround;
  dct:description "Tarjoajan aikaisempia hankintasopimuksia tai käyttöoikeussopimuksia on irtisanottu ennenaikaisesti tai kyseisen aikaisemman sopimuksen yhteydessä on vaadittu vahingonkorvauksia tai määrätty muita vastaavia seuraamuksia."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement16>
  a epo:ExclusionGround;
  dct:description """Tarjoajaa koskee jokin seuraavista tilanteista. 
a) on syyllistynyt väärän tiedon antamiseen poissulkemis- tai valintaperusteiden osalta,
b) on jättänyt antamatta tällaisia tietoja,
c) on toimittanut viiveellä tai ei lainkaan ostajan vaatimia tietoja, tai
d) on yrittänyt vaikuttaa ostajan päätöksentekoprosessiin asiattomalla tavalla tai hankkinut luottamuksellista tietoa, joista voisi olla sille hankintamenettelyssä asiaankuulumatonta etua, taikka on toimittanut harhaanjohtavia tietoja, joilla voi olla merkittävä vaikutus poissulkemista, tarjoajan valintaa tai hankintaa koskeviin päätöksiin."""@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement17>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on konkurssissa."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement18>
  a epo:ExclusionGround;
  dct:description "Tarjoajan osalta on käynnistetty maksukyvyttömyys- tai likvidaatiomenettely."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement19>
  a epo:ExclusionGround;
  dct:description "Tarjoajalla on järjestelyjä velkojien kanssa."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement2>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen tai jolla on siinä päätös-, edustus- tai valvontavaltaa, annettu lahjonnasta lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa"@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement20>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on kansalliseen lainsäädäntöön ja kansallisiin määräyksiin perustuen yllämainittuja tilanteita vastaavassa samankaltaisessa menettelyssä."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement21>
  a epo:ExclusionGround;
  dct:description "Tarjoajan varat ovat selvitysmiehen tai tuomioistuimen hallinnassa."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement22>
  a epo:ExclusionGround;
  dct:description "Tarjoajan liiketoiminta on keskeytetty."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement23>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on syyllistynyt ammatin harjoittamiseen liittyvään vakavaan virheeseen."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement24>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on tehnyt muiden kanssa sopimuksia, joilla pyritään vääristämään kilpailua."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement3>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen, on annettu petoksesta lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa"@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement4>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle itselleen tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen tai jolla on siinä päätös-, edustus- tai valvontavaltaa, annettu terrorismirikoksesta tai terroritoimintaan liittyvästä rikoksesta lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa"@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement5>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle itselleen tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen tai jolla on siinä päätös-, edustus- tai valvontavaltaa, on annettu rahanpesusta tai terrorismin rahoituksesta lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement6>
  a epo:ExclusionGround;
  dct:description "Tarjoajalle itselleen tai mille tahansa henkilölle, joka on sen hallinto-, johto- tai valvontaelimen jäsen tai jolla on siinä päätös-, edustus- tai valvontavaltaa, on annettu lapsityövoiman käytöstä tai muista ihmiskaupan muodoista lainvoimainen tuomio, joka on annettu enintään viisi vuotta sitten tai jolla suoraan vahvistettu poissulkeminen on edelleen voimassa"@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement7>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut verojen maksamiseen liittyviä velvoitteitaan sijoittumismaassaan tai ostajan maassa."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement8>
  a epo:ExclusionGround;
  dct:description "Tarjoaja on rikkonut sosiaaliturvamaksujen maksamiseen liittyviä velvoitteitaan sijoittumismaassaan tai ostajan maassa."@fi .

<http://data.europa.eu/a4g/resource/d3d2f6c0-d97c-4b46-8f2b-86516b3ee9de-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement9>
  a epo:ExclusionGround;
  dct:description "Tarjoajan hallinto-, johto- tai valvontaelimen jäsen tai edustus-,päätös- tai valvontavaltaa käyttävä henkilö on rikosrekisteristä ilmenevällä lainvoimaisella tuomiolla tuomittu työturvallisuusrikoksesta, työaikasuojelurikoksesta, työsyrjinnästä, kiskonnantapaisesta työsyrjinnästä, työntekijöiden järjestäytymisvapauden loukkaamisesta tai luvattoman ulkomaisen työvoiman käytöstä."@fi .

