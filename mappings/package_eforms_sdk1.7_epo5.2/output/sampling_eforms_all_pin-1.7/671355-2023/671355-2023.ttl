  epo:hasSelectionCriterionType <http://publications.europa.eu/resource/authority/selection-criterion/sui-act>;
  epo:isUsedForCandidateRestriction false;
  dct:description "De inschrijver of gegadigde heeft voldaan aan verplichtingen op grond van op hem van toepassing zijnde wettelijke bepalingen met betrekking tot betaling van sociale zekerheidspremies of belastingen."@nl;
  skos:prefLabel "E3 Betalingen belastingen en premies"@nl .

