  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/e02f0faa-6b48-407f-aa51-5c6131380e03-01/Procedure/Identifier/2024-0002-23>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "vob-a-eu";
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/e02f0faa-6b48-407f-aa51-5c6131380e03-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/e02f0faa-6b48-407f-aa51-5c6131380e03-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/e02f0faa-6b48-407f-aa51-5c6131380e03-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description "Bauleistungen (Gebäude und Außenanlagen inkl. Grundleitungen) für die Sanierung und Erweiterung einer vierzügigen Grundschule (BGF ca. 4.600qm) mit Mensa in Roxel"@de;
  dct:title "Vorinformation zur Verkürzung der Frist für den Eingang der Angebote - Erweiterung der Marienschule Roxel zur 4-Zügigkeit und Errichtung einer Mensa"@de .

