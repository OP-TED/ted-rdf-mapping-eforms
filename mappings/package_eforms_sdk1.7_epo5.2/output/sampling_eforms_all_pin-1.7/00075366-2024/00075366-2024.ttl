  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/cf9b721d-7331-4708-930f-2be1d4418647-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
