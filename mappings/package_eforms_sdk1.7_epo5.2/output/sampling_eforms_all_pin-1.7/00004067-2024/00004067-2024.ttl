<http://data.europa.eu/a4g/resource/729a1c83-7286-44f9-85e7-b2d701ff1eae-01/Procedure/0000000-0000-4000-8000-000000000000>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/729a1c83-7286-44f9-85e7-b2d701ff1eae-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
