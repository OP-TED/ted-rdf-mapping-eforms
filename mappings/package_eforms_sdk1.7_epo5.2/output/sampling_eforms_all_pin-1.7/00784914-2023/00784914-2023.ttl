  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/7377a246-e4aa-4caf-a227-43094ab1e85c-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "This prior information notice announces the intention of the contracting authority to publish a future call for tenders. No other information or documents are available at this stage. Interested economic operators are invited to subscribe at the link https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/tender-details/164af767-c843-4367-bff5-ec687b7253e3-PIN in order to get notified when the contract notice and all the procurement documents, including the tender specifications, are published."@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/7377a246-e4aa-4caf-a227-43094ab1e85c-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/7377a246-e4aa-4caf-a227-43094ab1e85c-01/PlannedProcurement/Identifier/NEAR%2FANK%2F2023%2FEA-RP%2F0268-PIN>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasLegalBasisDescription "Procurement award procedure applying to European Union external actions financed from the general budget of the European Union and the European Development Fund (EDF)"@en,
    "LocalLaw";
  epo:hasPurpose <http://data.europa.eu/a4g/resource/7377a246-e4aa-4caf-a227-43094ab1e85c-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/7377a246-e4aa-4caf-a227-43094ab1e85c-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description """This project aims to increase the capacity of various stakeholders, including all relevant national
institutions, to access and utilize climate finance. The project has 5 components:
1. Inception activities;
2. Drafting of a National Climate Finance Strategy;
3. Sustainable Finance Ecosystem and Taxonomy;
4. Institutional Capacity Building;
5. Visibility Activities.
Taking international and national sustainable finance context and development into account, the project will improve national capacity to mobilise and effectively manage climate finance flows to support Türkiye's national climate change targets."""@en;
  dct:title "Strengthening the National Capacity of Climate Finance"@en .

