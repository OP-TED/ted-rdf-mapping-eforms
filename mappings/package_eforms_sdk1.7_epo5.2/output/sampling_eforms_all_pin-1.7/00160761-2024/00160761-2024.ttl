  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/1017bc9c-2a29-4477-a9ce-ab4f405adae5-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
