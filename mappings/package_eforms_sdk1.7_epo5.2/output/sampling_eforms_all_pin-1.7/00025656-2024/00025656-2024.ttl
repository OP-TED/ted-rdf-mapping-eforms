<http://data.europa.eu/a4g/resource/7d9a9f69-8672-45fb-9c74-f421f260c939-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>
  a epo:SelectionCriterion;
