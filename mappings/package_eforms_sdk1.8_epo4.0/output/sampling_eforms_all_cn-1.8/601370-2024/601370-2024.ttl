<http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/Procedure/33da2b8f-c097-4d31-862a-84246a42cde3>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Architektonická, otevřená, jednofázová, projektová, anonymní soutěž o návrh."@cs;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/Procedure/Identifier/%E2%80%9ED%C5%AFm%20p%C5%99%C3%ADrody%20Jesen%C3%ADk%C5%AF%E2%80%9C%2C%20n%C3%A1v%C5%A1t%C4%9Bvnick%C3%A9%20st%C5%99edisko%20chr%C3%A1n%C4%9Bn%C3%A9%20krajinn%C3%A9%20oblasti%20Jesen%C3%ADky>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "134/2016 Sb. / Zákon o zadávání veřejných zakázek"@cs,
    "32014L0024 / Směrnice Evropského parlamentu a Rady 2014/24/EU ze dne 26. února 2014 o zadávání veřejných zakázek a o zrušení směrnice 2004/18/ES"@cs;
  epo:hasMainFeature "Veřejná zakázka je zadávána v otevřené soutěži o návrh dle ustanovení § 143 a násl. zákona č. 134/2016 Sb., o zadávání veřejných zakázek (dále v zadávací dokumentaci „zákon“ nebo „ZZVZ“), a dále v souladu se Soutěžním řádem České komory architektů ze dne 24. dubna 1993, v platném znění (dále „soutěžní řád“), v souladu se zákonem č. 283/2021 Sb., stavební zákon, v platném znění, v souladu se zákonem č. 360/1992 Sb., o výkonu povolání autorizovaných architektů a o výkonu povolání autorizovaných inženýrů a techniků činných ve výstavbě, v platném znění (dále „zákon o výkonu povolání“)."@cs;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-single>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  dct:description """Předmětem soutěže je zpracování architektonického návrhu novostavby návštěvnického střediska chráněné krajinné oblasti Jeseníky „Dům přírody Jeseníků“ (dále jen DPJ) v k. ú. Karlova Studánka na pozemku p. č. 53/6 a jeho propojení se stávající geologickou expozicí. DPJ bude samostatným objektem umístěným ve zvláště chráněném území, v území soustavy Natura 2000 (Evropsky významná lokalita Karlova Studánka) a v památkové zóně Karlova Studánka včetně návrhu výchovně vzdělávací a interaktivní expozice o přírodě, krajině, historii osídlení a lázeňství v CHKO. V Domě přírody se budou podávat komplexní informace o chráněné krajinné oblasti Jeseníky, o ochraně přírody a krajiny, o místě samém s důrazem na historii lázeňství, o možnostech pohybu a pobytu v chráněném území, a který bude poskytovat další informace nezbytné pro bezpečný pohyb návštěvníků a jejich směrování s cílem zachování biodiverzity v území. DPJ bude součástí sítě v programu AOPK ČR Dům přírody a musí splňovat jednotící prvky definované Jednotným architektonickým konceptem, manuálem pro navrhování návštěvnických středisek AOPK ČR. 
Podrobnější požadavky jsou specifikovány v příloze P.01 soutěžních podmínek."""@cs;
  dct:title "„Dům přírody Jeseníků“, návštěvnické středisko chráněné krajinné oblasti Jeseníky"@cs;
  adms:identifier <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/Procedure/Identifier/33da2b8f-c097-4d31-862a-84246a42cde3> .

