<http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/3fb449e2-bde4-4c46-8103-bde8d92f434d-01/ReviewProcedureInformationProvider/ORG-0002>;
