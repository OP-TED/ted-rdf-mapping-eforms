<http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/Procedure/17f86ec2-f263-4745-8bde-eb49eae8b5a7>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Der Bieter hat anzugeben inwieweit sein Unternehmen einen Bezug zu Russland hat. Dafür ist die “Eigenerklärung Bezug Russland“ (FB 127/L127/III.127) auszufüllen und als Teil des Angebotes abzugeben. Diese Erklärung ist auch für Unterauftragnehmer, Lieferanten oder Eignungsverleiher gem. den Bedingungen der Erklärung abzugeben.Angebote können ausschließlich von registrierten Bewerbern über die Vergabeplattform (www.staatsanzeiger-eservices.de) in Textform eingereicht werden.Die Kommunikation (Fragen, Auskünfte) erfolgt ausschließlich über die Vergabeplattform. Dabei ist das Tool Frage stellen bzw. Fragen/Antworten zu verwenden."@de;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/Procedure/Identifier/334>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "vob-a-eu";
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToProcedureSpecificTerm <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/ProcedureTerm$_ContractNotice1_TenderingTerms1_LotDistribution1>,
    <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/ProcedureTerm$_ContractNotice1_TenderingTerms1_ProcurementLegislationDocumentReference2>;
  dct:description "Die Stadt Penzberg errichtet in der Nonnenwaldstraße in 82377 Penzberg ein Kinderhaus mit 8 Gruppen in Holzbauweise. Das Gebäude entspricht der Gebäudeklasse 3 und ist ein zweigeschossiger Sonderbau, der in 4 Finger gegliedert ist. Die Gründung erfolgt mit duktilen Rammpfählen, der Keller und die Bodenplatten werden in Stahlbetonbauweise, das Erdgeschoss und das Obergeschoss in Massivholzbauweise mit einem begrünten Flachdach auf Brettsperrholz ausgeführt.Auf dem Dach werden PV-Module installiert, die Heizung erfolgt mit Fußbodenheizung mit einem Fernwärmeanschluss, das Warmwasser wird über Boiler oder Durchlauferhitzer bereitet.Bruttogeschossfläche 3.128 m²Grundstück: 16.297 m²Das LV beinhaltet:95 Fensterelemente18 Außentürelemente4 PfostenriegelfassadenVerschattungenWartungsarbeiten"@de;
  dct:title "Fenster und Außentüren"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/bbca5c27-a9c2-4923-af60-448a7c21e34c-01/Procedure/Identifier/17f86ec2-f263-4745-8bde-eb49eae8b5a7> .

