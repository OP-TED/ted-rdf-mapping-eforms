<http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/Procedure/a175868d-ca5a-457d-8fd0-f7e73536f2da>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation """In case of unavailability or disruptions in the functioning of the electronic means of communication provided in Section 5.1.11 in the last 5 calendar days before the time limit for receipt indicated in Section 5.1.12, the contracting authority reserves the right to extend this time limit and publish the extension at the Internet address provided in Section 5.1.11, without a preceding publication of a corrigendum to this notice. Economic operators interested in this procurement are invited to subscribe to the call for tenders at the address in Section 5.1.11 in order to get notified when new information or documents are published.
The framework contract ceiling will be the financial offer of the awarded tenderer.
An estimated contract value is indicated in Section II.2.6 of the contract notice. It is only an indication. Financial offers exceeding the estimated contract value will not be rejected, they will be evaluated."""@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/Procedure/Identifier/EBA%2F2023%2FOP%2F0010>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  dct:description """The subject of this call for tenders is mobile telephony services:
1.	supply of SIM cards for mobile phones and tablets;
2.	portability of current mobile phone numbers and provision of new numbers;
3.	communications network (voice and SMS);
4.	mobile internet data; and,
5.	very good coverage and quality of the voice and SMS services and a high speed mobile internet data service at the EBA’s headquarters located at Paris La Défense, Tour Europlaza, Floors 24 to 27, 20 avenue André Prothin, 92400 Courbevoie."""@en;
  dct:title "Mobile telephony services II"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/468afa65-c24a-4a88-8a20-57199e54057a-01/Procedure/Identifier/a175868d-ca5a-457d-8fd0-f7e73536f2da> .

