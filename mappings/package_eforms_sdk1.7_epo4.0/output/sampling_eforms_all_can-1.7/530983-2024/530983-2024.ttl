  epo:isCoveredByGPA true;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "SySIKT KO joint agreement for the operation of the municipalities' ERP solution. The municipalities participating in the collaboration are Askvoll, Hyllestad, Fjaler, Høyanger, Solund, Sunnfjord, Vik, and Luster. The current solution is operated in collaboration with Visma. The new agreement for Visma Enterprise Plus will be operated by Visma alone.>"@en;
  dct:title "Intention notice: ERP Software"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/Identifier/LOT-0001> .

