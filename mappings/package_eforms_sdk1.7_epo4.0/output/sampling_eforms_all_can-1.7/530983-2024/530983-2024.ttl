  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "Forskrift om offentlige anskaffelser § 13-4 (1) b og c [ELI] / The procurement is carried out as a direct award without competition as only one supplier can deliver due to technical reasons and to protect exclusive rights. SySIKT intends to enter into an agreement with Visma AS for the transition from Visma Enterprise on-premise to Visma cloud solution due to the \"end-of-life\" of the current solution and the need for service continuity."@en,
    "Anskaffelsesforskriften";
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-wo-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/5f1b1802-6462-455a-9999-0a11cc519e46-01/Lot/LOT-0001>;
