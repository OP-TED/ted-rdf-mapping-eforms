<http://data.europa.eu/a4g/resource/7527a7a3-273a-42b8-b25e-f65a3f47444e-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/cost>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/poi-exa>;
  cccev:weight 90.0;
  dct:description "Kopējā preces summa tiek savstarpēji salīdzināta ar citiem piedāvājumiem, izmantojot šādu formulu:A=Ax/Ay*90A – pretendenta iegūtais punktu skaits;Ax – zemākā piedāvātā kopējā summa;Ay – vērtējamā piedāvājuma kopējā summa."@lv;
  skos:prefLabel "Kopējā preces summa"@lv .

<http://data.europa.eu/a4g/resource/7527a7a3-273a-42b8-b25e-f65a3f47444e-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion2_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/poi-exa>;
  cccev:weight 10.0;
  dct:description """Preces kombinētais garantijas laiks tiks aprēķināts šādi:                                 B= (Bx + By) * 10B – pretendenta iegūtais punktu skaits;Bx – Preces noliktavas garantijas laiks ne mazāk kā 36 (trīsdesmit seši) mēneši no piegādes brīža ;By – Preces lietošanas garantijas laiks ne mazāk kā 24 (divdesmit četri) mēneši no komplekta sastāvdaļu izsniegšanas individuālā lietošanā brīža.	Ja tiks piedāvāts  Preces noliktavas un lietošans garantijas laiks, tad tiek iegūti 10 punkti.Ja tiks piedāvāts  tikai Preces lietošans garantijas laiks, tad tiek iegūti 0 punkti."""@lv;
  skos:prefLabel "Kombinētais garantijas laiks"@lv .

