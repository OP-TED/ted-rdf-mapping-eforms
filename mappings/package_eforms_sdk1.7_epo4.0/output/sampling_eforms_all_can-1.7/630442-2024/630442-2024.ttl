  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription """FOA § 13-4 b) nr. 3. [ELI] / Direct procurement is justified by the Public Procurement Regulations § 13-4 b) no. 3, as SAP Norway AS has sole rights and intellectual property rights for Licences  the NDMA requires. 
A tender contest has been tried (c.f. 2024-109128) and there are no reasonable alternatives to implementing this procurement without a competition. The procurement documents are not adapted to the tenderer."""@en,
    "Anskaffelsesforskriften";
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-wo-call>;
