    <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/StrategicProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:hasAdditionalInformation "Es ist beabsichtigt den Auftrag an die Fa.   Westenergie Netzservice GmbH Florianstraße 15-21 44139 Dortmund  zu vergeben."@de;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/Lot/Identifier/24.027>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/AwardEvaluationTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/AuctionTerms$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1_AuctionTerms1>,
    <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Die Hauptstromversorgung der Uniklinik wird aufgrund fehlender Ressourcen technisch erweitert. Durch den Versorger wird bauseitig die neue Einspeisung über 2 x 110 kV Netzzuleitungen erstellt.   Durch den Bieter sind die hier anzuschließenden Leistungstransformatoren, jeweils 50 MVA, zu liefern und in betriebsfertig zu installieren. Die Aufstellung erfolgt unterirdisch, die Einbringung mittels Autokran durch entsprechende, Einbringschächte, die Aufstellung erfolgt ca. 11.50 m unter Geländeoberfläche = Niveau der Einbringöffnung. Das Isoliermedium ist synthetischer Ester, wassergekühlt, Schnittstelle bildet der Wärmetauscher zum bauseitigen Rückkühlwerk. Sämtliche Genehmigungsverfahren zur An- und Einbringung unterliegen dem Bieter. Der Bieter unterstützt aktiv den Planungsprozess um dem Baukörper optimal auszulegen. Aufgrund der Komplexität des Vorhabens ist eine engmaschige Betreuung vor Ort notwendig. Abgewickelt wird das Projekt nach der Planungsmethode BIM"@de;
  dct:title "Ex-ante Transparenz | Neubau HS Transformator - 2 Stück Leistungstransformatoren - Beschaffung/ Lagerung/ Lieferung/ Verortung und Einbringung"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/2fe5e716-aca4-43db-9127-a435bee1cf8d-01/Identifier/LOT-0001> .

