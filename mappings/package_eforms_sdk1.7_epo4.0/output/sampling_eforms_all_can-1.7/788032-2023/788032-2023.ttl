    <http://data.europa.eu/a4g/resource/1461090b-4be6-4f4a-ba90-752943c1927d-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/1461090b-4be6-4f4a-ba90-752943c1927d-01/AuctionTerms$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1_AuctionTerms1>,
