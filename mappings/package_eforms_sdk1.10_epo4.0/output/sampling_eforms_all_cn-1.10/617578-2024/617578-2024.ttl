<http://data.europa.eu/a4g/resource/220d0f4b-b702-47b4-b1bd-d19b90dfe5fe-01/Procedure/74484656-acf0-49c3-bf7e-1fc29076dd70>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/220d0f4b-b702-47b4-b1bd-d19b90dfe5fe-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasAcceleratedProcedureJustification "Naručitelj je u ovom postupku sukladno odredbi članka 234. stavak 1. a u vezi s člankom 236. stavak 2. Zakona, a uslijed žurne situacije (vantroškovničke stavke za predstojeće remonte brodova u floti Jadrolinije), koja čini nepraktičnim rok iz članka 228. ovoga Zakona, odredio kraći rok za dostavu (15 dana od dana slanja poziva na sudjelovanje)."@hr;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/220d0f4b-b702-47b4-b1bd-d19b90dfe5fe-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
