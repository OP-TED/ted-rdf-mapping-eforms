<http://data.europa.eu/a4g/resource/641234a7-f84d-4b20-94db-1db9798a2aa6-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
