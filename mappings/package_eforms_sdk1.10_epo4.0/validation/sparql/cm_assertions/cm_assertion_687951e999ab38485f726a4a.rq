#title: BT-105-Procedure-List
#description: The corresponding XML element is /*/cac:TenderingProcess/cbc:ProcedureCode/@listName. 
#xpath: /*/cac:TenderingProcess/cbc:ProcedureCode/@listName

PREFIX epo: <http://data.europa.eu/a4g/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

ASK WHERE { 
	?this rdf:type epo:Procedure .
	?this epo:hasProcedureType ?value .   FILTER ( ISIRI(?value) && CONTAINS(str(?value), 'europa.eu/') ) 
}