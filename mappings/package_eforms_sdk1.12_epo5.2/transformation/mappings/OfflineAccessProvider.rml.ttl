@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix epo-not: <http://data.europa.eu/a4g/ontology#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix tedm: <http://data.europa.eu/a4g/mapping/rml/> .

tedm:MG-OfflineAccessProvider_ND-LotTenderingTerms a rr:TriplesMap ;
    rdfs:label "MG-OfflineAccessProvider" ;
    rml:logicalSource [
        rml:iterator "/*/cac:ProcurementProjectLot[cbc:ID/@schemeName='Lot']/cac:TenderingTerms" ;
        rml:referenceFormulation ql:XPath ;
        rml:source "data/source.xml" ;
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-301-Lot-DocProvider TPO (hasContactPointInRole)" ;
        rdfs:comment "Connection where DocumentProviderParty is an OrganizationalUnit" ;
        rr:objectMap [
            rr:joinCondition [
                rr:child "if(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID/@schemeName='touchpoint' or exists(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'TPO-')])) then cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID else null" ;
                rr:parent "cac:PartyIdentification/cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-ContactPoint_ND-Touchpoint ;
        ] ;
        rr:predicate epo:hasContactPointInRole ;
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-301-Lot-DocProvider" ;
        rdfs:comment "Connection between AgentInRole and Organization OR OrganizationalUnit" ;
        rr:objectMap [
            rdfs:label "TPO (playedBy)" ;
            rdfs:comment "Connection where DocumentProviderParty is an OrganizationalUnit" ;
            rr:joinCondition [
                rr:child "if(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID/@schemeName='touchpoint' or exists(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'TPO-')])) then cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID else null" ;
                rr:parent "cac:PartyIdentification/cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-OrganizationalUnit_ND-Touchpoint ;
        ] ;
        rr:objectMap [
            rdfs:label "ORG (playedBy)" ;
            rdfs:comment "Connection where DocumentProviderParty is an Organization" ;
            rr:joinCondition [
                rr:child "if(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID/@schemeName='organization' or exists(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID[starts-with(text(), 'ORG-')])) then cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID else null" ;
                rr:parent "cac:PartyIdentification/cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-Organization_ND-Company ;
        ] ;
        rr:predicate epo:playedBy ;
    ] ;
    rr:predicateObjectMap [
        rdfs:label "OPT-301-Lot-DocProvider (contextualisedBy)" ;
        rr:objectMap [
            rr:joinCondition [
                rr:child "../cbc:ID" ;
                rr:parent "cbc:ID" ;
            ] ;
            rr:parentTriplesMap tedm:MG-Lot_ND-Lot ;
        ] ;
        rr:predicate epo:contextualisedBy ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-LotTenderingTerms" ;
        rr:class epo:OfflineAccessProvider ;
        rml:reference "if(exists(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID)) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/OfflineAccessProvider/' || encode-for-uri(concat(cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID, cac:DocumentProviderParty/cac:PartyIdentification/cbc:ID/@schemeName)) else null";
    ]
.
