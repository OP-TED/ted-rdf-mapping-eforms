<http://data.europa.eu/a4g/resource/6f04adbc-ae17-4d7a-b7ca-935ae9481058-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
