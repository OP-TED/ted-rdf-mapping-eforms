  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/17dee04e-2b4a-4369-bbf3-b22fb15dd754-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
