<http://data.europa.eu/a4g/resource/392a69bc-70ef-425e-b7bc-557fa27de990-01/Procedure/5c025493-37e7-44f6-b16b-9168dcb2a203>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/392a69bc-70ef-425e-b7bc-557fa27de990-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
