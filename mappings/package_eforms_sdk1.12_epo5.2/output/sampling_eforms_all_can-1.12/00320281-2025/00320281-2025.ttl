  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/036a3201-c78f-402a-9955-c35eae99470f-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/036a3201-c78f-402a-9955-c35eae99470f-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  dct:description """Réhabilitation des deux Ponts de franchissement de la Sarthe et du Canal sur la rue d'Eichthal :
-Démolition de la superstructure et de l'étanchéité.
-Réfection de l'étanchéité.
-Réhabilitation des structures.
-Récupération des eaux de ruissellement, traitement avant rejet dans le milieu naturel.
-Réalisation des traitements de surfaces et des couches de roulement.
Les prestations comprennent :
-Base vie particulière.
-Barrières de chantier, échafaudage, nacelle et engins de levage.
-Travaux préparatoires et démolition.
-Travaux sur les appuis.
-Travaux de réfection des structures.
-Travaux de superstructures.
-Travaux d'assainissement.
-Travaux de voirie"""@fr;
  dct:title """Aménagement de Chronolignes sur le réseau urbain de transport public de LE MANS MÉTROPOLE
Lot n°9 Réhabilitation des Ponts d'Eichthal (RPE)
Réhabilitation des deux Ponts de franchissement de la Sarthe et du Canal sur la rue d'Eichthal dans le cadre de la réalisation du projet de l'aménagement de trois Chronolignes sur le territoire de LE MANS METROPOLE"""@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/036a3201-c78f-402a-9955-c35eae99470f-01/Procedure/Identifier/a8d93fdc-51d3-45d2-b515-9cb9a675a270> .

