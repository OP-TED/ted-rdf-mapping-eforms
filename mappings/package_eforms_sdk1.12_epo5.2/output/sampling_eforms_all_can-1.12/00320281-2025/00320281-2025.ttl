<http://data.europa.eu/a4g/resource/036a3201-c78f-402a-9955-c35eae99470f-01/Procedure/a8d93fdc-51d3-45d2-b515-9cb9a675a270>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/036a3201-c78f-402a-9955-c35eae99470f-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
