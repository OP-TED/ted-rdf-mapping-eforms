  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/da33c577-16a2-42f0-96f2-c74ce26b45bc-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
