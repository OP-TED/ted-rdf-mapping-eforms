<http://data.europa.eu/a4g/resource/6275a3ef-ba47-407d-a3fe-c1de33093a1a-01/NonPublishedInformation$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_NoticeResult1_LotResult2_AppealRequestsStatistics1_FieldsPrivacy1>
  a epo:NonPublishedInformation;
  epo:concernsMaskedObject <http://data.europa.eu/a4g/resource/6275a3ef-ba47-407d-a3fe-c1de33093a1a-01/ReviewIrregularitySummary$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_NoticeResult1_LotResult2_AppealRequestsStatistics1>;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/6275a3ef-ba47-407d-a3fe-c1de33093a1a-01/Notice>;
  epo:hasConfidentialityJustification "Wykonawca EVER CLEANING Sp. z o o., ul. Arkuszowa 39, 01-934 Warszawa – 31/05/2024 r. wniósł odwołanie. Zamawiający po rozpatrzeniu odwołania (sygnatura sprawy KIO 1906/24), w dniu 17/06/2024 r., uznał w całości odwołanie. Uczestnik postępowania odwoławczego (ALEKSANDRA HACUŚ ZAKŁAD USŁUGOWY ,,SAGITTA\"), który przystąpił do tego postępowania po stronie Zamawiającego, w dniu 19/06/2024 r. wniósł sprzeciw co do uwzględnienia w całości zarzutów przedstawionych w odwołaniu. W dniu 20/06/2024 r. – przed otwarciem rozprawy – Odwołujący (EVER CLEANING Sp. z o o.) złożył Prezesowi Krajowej Izby Odwoławczej oświadczenie o cofnięciu odwołania. Zgodnie z art. 568 pkt 1 ustawy, Krajowa Izba Odwoławcza, w dniu 21/06/2024 r. umorzyła postępowanie odwoławcze."@pl;
  epo:hasMaskableProperty epo:hasIrregularityType;
  epo:hasNonPublicationJustification <http://publications.europa.eu/resource/authority/non-publication-justification/fair-comp> .

