<http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/Procedure/f7790950-d16c-4379-8f74-579c6b069292>
  a epo:LocalLegalBasisInformation, epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Nel contesto della presente procedura la Direttiva 2014/24/UE ed il Decreto Legislativo  36/2023 saranno applicati solo se richiamati nei documenti di gara (bando, capitolato tecnico e relativi allegati), ai  sensi del Regolamento (EU) N.1144/2014 e s.m.i., e degli orientamenti sulla procedura di gara presenti all'interno del Decreto del Direttore generale MASAF ­ Dipartimento della sovranità alimentare e dell'ippica ­ DG degli Affari Generali e del bilancio ­ n.0532478 del 10/10/2024 ­ \"Criteri che le organizzazioni non pubbliche devono rispettare  nella selezione degli Organismi di Esecuzione\"."@it;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/Procedure/Identifier/aUthEntico>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "Nel contesto della presente procedura la Direttiva 2014/24/UE ed il Decreto Legislativo 36/2023 saranno applicati solo se richiamati nei documenti di gara (bando, capitolato tecnico e relativi allegati), ai sensi del Regolamento (EU) N.1144/2014 e s. m.i., e degli orientamenti sulla procedura di gara presenti all'interno del Decreto del Direttore generale MASAF Dipartimento della sovranità alimentare e dell'ippica DG degli Affari Generali e del bilancio n.0532478 del 10/10/2024 \"Criteri che le organizzazioni non pubbliche devono rispettare nella selezione degli Organismi di Esecuzione\". / Decreto Legislativo 36/2023"@it;
  epo:hasMainFeature "CAPITOLATO TECNICO E PROCEDURA DI SELEZIONE DELL'ORGANISMO DI ESECUZIONE DEL PROGRAMMA DI INFORMAZIONE E PROMOZIONE DEI PRODOTTI AGRICOLI SUL MERCATO INTERNO - Proposal number: 101194328 Proposal acronym: aUthEntico Il bando di gara riguarda la selezione di un organismo di esecuzione incaricato della realizzazione delle azioni rivolte al raggiungimento degli obiettivi previsti nell'ambito del Programma di informazione e promozione presentato a valere sul Regolamento UE n.1144/2014 del Parlamento Europeo e del Consiglio Call 2024, “Autentiche opere d’arte dell’ UE” – ACRONIMO aUthEntico N. 101194328, e che si svolgerà nel seguente paese target: Italia. Gli enti proponenti dovranno presentare un corpus di attività e iniziative (informative e promozionali) che si sviluppa intorno a una chiara e precisa strategia orientata ai mercati e ai gruppi target, finalizzata al raggiungimento degli obiettivi sopra esposti e coerente con il messaggio unionale presentato in fase di candidatura del progetto con la durata prevista e le risorse finanziarie messe a disposizione. I Pacchetti di lavoro (Work Package WP) e le attività dovranno essere presenti all’interno delle proposte, secondo le modalità descritte in dettaglio all’interno del capitolato tecnico."@it;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/ProcedureTerm$_ContractAwardNotice1_TenderingTerms1_ProcurementLegislationDocumentReference3>;
  dct:description "Decreto Legislativo 36/2023"@it, "Il bando di gara riguarda la selezione di un organismo di esecuzione incaricato della realizzazione delle azioni rivolte al raggiungimento degli obiettivi previsti nell'ambito del Programma di informazione e promozione presentato a valere sul Regolamento UE n.1144/2014 del Parlamento Europeo e del Consiglio Call 2024, “Autentiche opere d’arte dell’ UE” – ACRONIMO aUthEntico N. 101194328, e che si svolgerà nel seguente paese target: Italia. Gli enti proponenti dovranno presentare un corpus di attività e iniziative (informative e promozionali) che si sviluppa intorno a una chiara e precisa strategia orientata ai mercati e ai gruppi target, finalizzata al raggiungimento  degli obiettivi sopra esposti e coerente con il messaggio unionale presentato in fase di candidatura del progetto con la durata prevista e le risorse finanziarie messe a disposizione. I Pacchetti di lavoro (Work Package ­ WP) e le attività dovranno essere presenti all’interno delle proposte, secondo le modalità descritte in dettaglio all’interno  del capitolato tecnico."@it;
  dct:title """CAPITOLATO TECNICO E PROCEDURA DI SELEZIONE DELL'ORGANISMO DI ESECUZIONE DEL PROGRAMMA DI INFORMAZIONE E PROMOZIONE DEI PRODOTTI AGRICOLI SUL MERCATO INTERNO - Proposal number: 101194328
Proposal acronym: aUthEntico"""@it;
  adms:identifier <http://data.europa.eu/a4g/resource/450eb5fc-c3a1-41dc-9186-72888d6aff18-01/Procedure/Identifier/f7790950-d16c-4379-8f74-579c6b069292> .

