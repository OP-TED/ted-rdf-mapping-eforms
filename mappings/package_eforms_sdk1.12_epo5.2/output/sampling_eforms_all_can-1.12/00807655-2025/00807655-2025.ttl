<http://data.europa.eu/a4g/resource/76495924-7228-4d23-9393-548ef9c3c284-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot4_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
