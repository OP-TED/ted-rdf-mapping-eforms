  epo:hasAdditionalInformation """Modalités de candidatures : 
Pour répondre au présent avis, les candidats doivent se manifester sur le Portail Achats d'EDF pha2.edf.com. Demande d'information BPM NN° tel qu’identifié à l’article 2.1 Procedure Identifiant interne, et rattacher les documents demandés. Aucun envoi par e-mail n'est autorisé."""@fr;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/58256b44-4564-410f-b65c-b35e81513eda-01/Procedure/Identifier/BPM007407>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasMainFeature "La présente consultation est une procédure avec négociation passée en application de l’article L. 2124 3 et des articles R. 212 4 4 ainsi que des articles R. 2161 21 et sv du CCP"@fr;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-wo-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/58256b44-4564-410f-b65c-b35e81513eda-01/Lot/LOT-0001>;
