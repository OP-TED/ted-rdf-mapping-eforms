<http://data.europa.eu/a4g/resource/58256b44-4564-410f-b65c-b35e81513eda-01/Procedure/4cbae74e-fe6d-46a9-ad7d-734fe78522a7>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/58256b44-4564-410f-b65c-b35e81513eda-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
