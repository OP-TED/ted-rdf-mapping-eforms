<http://data.europa.eu/a4g/resource/a6905776-f1cb-4223-a19f-4f5ae90a4844-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/price>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/poi-exa>;
