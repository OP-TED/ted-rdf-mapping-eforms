  epo:isCoveredByGPA false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/28a7c207-7ec7-4282-899f-31ab219a7777-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/28a7c207-7ec7-4282-899f-31ab219a7777-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/28a7c207-7ec7-4282-899f-31ab219a7777-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AppealTerms1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/28a7c207-7ec7-4282-899f-31ab219a7777-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot2_TenderingProcess1>;
  dct:description """W zakres robót wchodzi:
1.	Codzienny przegląd oznakowania;
2.	Wymiana zniszczonych i nieczytelnych tablic znaków drogowych na nowe;
3.	Bieżąca naprawa uszkodzonych mechanicznie tablic, znaków drogowych oraz innych urządzeń bezpieczeństwa ruchu w pasie drogowym;
4.	Okresowe (wiosenne) mycie tablic, znaków drogowych oraz innych urządzeń bezpieczeństwa ruchu drogowego i wiat przystankowych na terenie miasta i gminy w terminie do 15.04.2025r.
5.	Interwencyjne, tymczasowe zabezpieczanie awarii i miejsc niebezpiecznych w pasie drogowym;
6.	Prowadzenie magazynu materiałowego tablic, słupków oraz innych materiałów do oznakowania.
7.	Wykonanie tymczasowego zabezpieczanie awarii i miejsc niebezpiecznych w pasie drogowym skutkujące brakiem ciągłości ruchu, tj. w terminie nie dłuższym niż 2 godziny od jej zaistnienia.
8.	Montaż nowego słupka znaku.
9.	Montaż nowego słupka ograniczającego. 
10.	Montaż nowej balustrady.
"""@pl;
  dct:title "Konserwacja oznakowania pionowego "@pl;
  adms:identifier <http://data.europa.eu/a4g/resource/28a7c207-7ec7-4282-899f-31ab219a7777-01/Identifier/LOT-0002> .

