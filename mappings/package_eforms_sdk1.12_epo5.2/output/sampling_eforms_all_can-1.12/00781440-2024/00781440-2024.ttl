  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/supplies>;
  epo:hasMaximumNumberOfRenewals 3;
  epo:hasOptionsDescription "Met de winnende inschrijver sluiten we een 2 jarige overeenkomst af. De overeenkomst gaat in op 1 januari 2025 en eindigt op 31 december 2026. Wij kunnen de overeenkomst 3 keer verlengen met 2 jaar. De overeenkomst loopt maximaal tot 31 december 2032. Wij beogen de overeenkomst aan te gaan voor 8 jaar."@nl;
  epo:hasRenewalDescription """1. Verlenging van 1 januari 2027 tot en met 31 december 2028.
2. Verlenging van 1 januari 2029 tot en met 31 december 2030.
3. Verlenging van 1 januari 2031 tot en met 31 december 2032."""@nl;
  epo:hasUnknownDuration false .

