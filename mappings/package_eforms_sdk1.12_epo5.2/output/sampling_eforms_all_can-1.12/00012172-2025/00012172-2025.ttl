  epo:hasAdditionalInformation "Marché pour la fourniture et le montage de pièces de rechange pour les pompes ASG, RIS, RCV et EAS des Paliers 1300MWe P4 et P’4"@fr;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
