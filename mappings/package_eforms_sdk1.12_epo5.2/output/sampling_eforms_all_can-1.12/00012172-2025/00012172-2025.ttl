  epo:hasAdditionalInformation "La sous-traitance est limité au rang 2."@fr;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/Lot/Identifier/C4P2196560>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  dct:description """Marché de prestations relatives à la fourniture et au montage de pièces de rechange de pompes ASG, RIS, RCV et EAS des paliers P4 et P’4.
Les Prestations comprennent notamment l’approvisionnement et la fourniture des pièces de rechange, les travaux de remplacement de ces pièces de rechange sur les tranches, les essais de requalification intrinsèques et l’accompagnement par le Titulaire des équipes du CNPE lors de la réalisation des essais de fonctionnement et de requalification en fluides du circuit.
Ce Marché comporte aussi les Prestations suivantes au bordereau de prix unitaire :
• des interventions sur les pompes,
• de la fourniture de pièces supplémentaires,
• des prestations intellectuelles supplémentaires (déplacements, requalification, réunions…)."""@fr;
  dct:title "Marché pour la fourniture et le montage de pièces de rechange pour les pompes ASG, RIS, RCV et EAS des Paliers 1300MWe P4 et P’4"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/8fef3b4c-6234-4c52-8a3e-ae341a3c2684-01/Identifier/LOT-0001> .

