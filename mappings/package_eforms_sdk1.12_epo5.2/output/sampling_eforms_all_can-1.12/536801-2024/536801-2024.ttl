<http://data.europa.eu/a4g/resource/d9a61442-e0c1-4ab1-aa3b-f930b2b96586-01/ReviewProcedureInformationProvider/ORG-0002>
  a epo:ReviewProcedureInformationProvider;
  epo:contextualisedBy <http://data.europa.eu/a4g/resource/d9a61442-e0c1-4ab1-aa3b-f930b2b96586-01/Lot/LOT-0001>,
