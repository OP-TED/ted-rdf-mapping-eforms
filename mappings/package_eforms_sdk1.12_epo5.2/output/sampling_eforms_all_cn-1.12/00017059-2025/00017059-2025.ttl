  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/d4751dd4-70b5-40f0-bc0a-79fe704be101-03/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/d4751dd4-70b5-40f0-bc0a-79fe704be101-03/ProcedureTerm$_ContractNotice1_ProcurementProjectLot2_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/d4751dd4-70b5-40f0-bc0a-79fe704be101-03/ProcedureTerm$_ContractNotice1_TenderingTerms1_LotDistribution1>;
  dct:description """De Overeenkomsten die de Tweede Kamer beoogt te sluiten d.m.v. de Aanbestedingsprocedure hebben betrekking op het leveren, plaatsen en onderhouden van high-risk respectievelijk low-risk Security Scanners voor het scannen van personen. Perceel 1: levering en onderhoud zes high-risk Security Scanners 
Perceel 2: levering en onderhoud drie low-risk Security Scanners"""@nl;
  dct:title "Levering en onderhoud Security Scanners"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/d4751dd4-70b5-40f0-bc0a-79fe704be101-03/Procedure/Identifier/bb4ca052-9666-4f98-be2b-287e8bffe245> .

