  epo:hasAdditionalInformation "Gegadigden/Inschrijvers kunnen nadere inlichtingen inwinnen over de Aanbestedingsprocedure en de Aanbestedingsstukken, door het stellen van vragen zoals beschreven in de Selectieleidraad."@nl;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/d4751dd4-70b5-40f0-bc0a-79fe704be101-03/Procedure/Identifier/UTP%2F8000578>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32009L0081>;
  epo:hasMainFeature "De procedure ziet op twee Percelen. Partijen met Russische betrokkenheid en partijen waarvan het hoofdkantoor is gevestigd in een land met een actief offensief cyberprogramma tegen (onder meer) Nederland worden uitgesloten van deelname."@nl;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/d4751dd4-70b5-40f0-bc0a-79fe704be101-03/Lot/LOT-0001>,
