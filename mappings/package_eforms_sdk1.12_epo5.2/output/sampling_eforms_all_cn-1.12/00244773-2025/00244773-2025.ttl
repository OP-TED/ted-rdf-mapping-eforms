<http://data.europa.eu/a4g/resource/0ff7d8ff-f389-429d-bd8f-16c3cb8f1ac0-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>
  a epo:SelectionCriterion;
