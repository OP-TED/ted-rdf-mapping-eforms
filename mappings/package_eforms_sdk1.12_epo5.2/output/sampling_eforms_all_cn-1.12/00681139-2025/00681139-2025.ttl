<http://data.europa.eu/a4g/resource/9a6e4280-6ead-4b15-867d-a7575a623495-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/9a6e4280-6ead-4b15-867d-a7575a623495-01/ReviewProcedureInformationProvider/ORG-0002organization>;
