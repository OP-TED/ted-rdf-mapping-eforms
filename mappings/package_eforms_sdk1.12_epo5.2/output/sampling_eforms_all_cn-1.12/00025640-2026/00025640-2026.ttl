    <http://data.europa.eu/a4g/resource/c66d3529-b361-4b36-8068-1a4057eeeaef-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot2_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>;
