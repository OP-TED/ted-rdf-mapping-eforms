  epo:hasSelectionCriterionType <http://publications.europa.eu/resource/authority/selection-criterion/slc-stand-ins>;
  dct:description "Déclaration appropriée de banques ou preuve d'une assurance pour les risques professionnels"@fr .

<http://data.europa.eu/a4g/resource/d1f9185a-3388-4864-b001-79551d0c6e14-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>
