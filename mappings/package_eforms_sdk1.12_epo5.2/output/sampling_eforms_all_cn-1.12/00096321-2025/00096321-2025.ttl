<http://data.europa.eu/a4g/resource/c9ec5810-6823-40ab-8730-61e35695172c-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/c9ec5810-6823-40ab-8730-61e35695172c-01/Interval$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasMaximumNumberOfRenewals 4;
  epo:hasOptionsDescription "Beschreibung der Optionen: 1. optionale Anpassung der Linien aufgrund von Umzügen, Schulwechseln, Neuzugängen, Abgängen, 2. optionale Verlängerung, Eine vierfache Verlängerungsoption ist vornehmlich deswegen aufgenommen, damit den Vertragspartnern bei notwendigen Anpassungen nach Ziffer 1, die vornehmlich zum neuen Schuljahr erfolgen, eine vereinfachte Lösung vom Vertrag ermöglicht wird."@de;
  epo:hasRenewalDescription """Der Auftrag kann, für jedes Los getrennt, viermal verlängert werden, jeweils um ein weiteres Schuljahr: Erste Verlängerungsoption bis zum 31.7.2027; Zweite Verlängerungsoption bis
zum 31.7.2028; Dritte Verlängerungsoption bis zum 31.7.2029; Vierte Verlängerungsoption bis zum 31.07.2030."""@de;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

