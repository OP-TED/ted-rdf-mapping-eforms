    <http://data.europa.eu/a4g/resource/72b5f898-81d1-4598-978e-fc489c18502f-01/MultipleStageProcedureTerm$_ContractNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/72b5f898-81d1-4598-978e-fc489c18502f-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/72b5f898-81d1-4598-978e-fc489c18502f-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>,
    <http://data.europa.eu/a4g/resource/72b5f898-81d1-4598-978e-fc489c18502f-01/SecurityClearanceTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/72b5f898-81d1-4598-978e-fc489c18502f-01/SubmissionTerm$_ContractNotice1_ProcurementProjectLot1>;
