  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/3540dd9a-c066-40ef-9469-1c4f2f84b847-01/ReviewProcedureInformationProvider/ORG-0004>;
