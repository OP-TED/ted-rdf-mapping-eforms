<http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/PlannedProcurement$_PriorInformationNotice1_ProcurementProject1>
  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Aggiornamento dell’Avviso di preinformazione N. 2017/S 022-038152, pubblicato sulla Gazzetta Ufficiale dell’Unione Europea in data 01/02/2017. Appalto suddiviso in due lotti: LOTTO 1. Servizi di trasporto pubblico locale automobilistici e marittimi urbani del Comune di Brindisi e parte dei servizi extraurbani di competenza dell'ATO della Provincia di Brindisi, per un quantitativo complessivo stimato di circa 5.400.000 Km annuali. LOTTO 2. servizi di trasporto pubblico locale automobilistici urbani dei Comuni di Fasano, Ostuni, Francavilla Fontana e Oria e parte dei servizi extraurbani di competenza dell'ATO della Provincia di Brindisi, per un quantitativo complessivo stimato di circa 4.730.000 Km annuali."@it;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/PlannedProcurement/Identifier/e5326626-38cc-42c1-a683-272c09584517%40698-PI-1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/other>;
  epo:hasLegalBasisDescription "Regolamento (CE) n. 1370/2007 - Direttiva 2014/24/UE";
  epo:hasPurpose <http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  dct:description "Servizi di trasporto pubblico locale automobilistici urbani, extraurbani e marittimi di competenza dell'ATO della Provincia di Brindisi distinti in due lotti, così come definiti nell’adottato Piano Triennale dei Servizi per il periodo 2024-2026 i cui Obiettivi e Strategie sono stati approvati con deliberazione di Giunta Regionale n. 1808/2024 (pubblicata su BURP n. 6/2025)."@it;
  dct:title "Servizi di trasporto pubblico locale automobilistici urbani, extraurbani e marittimi di competenza dell'ATO della Provincia di Brindisi"@it .

<http://data.europa.eu/a4g/resource/bca25dcb-199a-4ac6-afe4-ef88055e505a-01/PlannedProcurement/Identifier/e5326626-38cc-42c1-a683-272c09584517%40698-PI-1>
