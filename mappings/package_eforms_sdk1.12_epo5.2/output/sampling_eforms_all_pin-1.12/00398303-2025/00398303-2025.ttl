  epo:hasAdditionalInformation "#Besonders auch geeignet für:other-sme#"@de;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/e747192a-d184-41ec-9681-3ab947127ae9-01/PlannedProcurementPart/Identifier/03>;
  epo:hasPlannedPeriod <http://data.europa.eu/a4g/resource/e747192a-d184-41ec-9681-3ab947127ae9-01/PartInterval$_PriorInformationNotice1_ProcurementProjectLot3_ProcurementProject1_PlannedPeriod1>;
