<http://data.europa.eu/a4g/resource/dd046e60-b516-4249-acca-658036b067ed-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/dd046e60-b516-4249-acca-658036b067ed-01/ReviewProcedureInformationProvider/ORG-0002>;
