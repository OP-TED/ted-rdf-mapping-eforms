<http://data.europa.eu/a4g/resource/257c52c2-d091-4de4-aebe-c43e23cd8473-01/Procedure/0000000-0000-4000-8000-000000000000>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/257c52c2-d091-4de4-aebe-c43e23cd8473-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
