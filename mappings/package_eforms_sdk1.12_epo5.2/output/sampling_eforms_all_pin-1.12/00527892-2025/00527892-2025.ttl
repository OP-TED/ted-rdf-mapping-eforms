  epo:foreseesTerm <http://data.europa.eu/a4g/resource/3051b06e-8eb9-42a5-a505-222dbf856a6b-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/3051b06e-8eb9-42a5-a505-222dbf856a6b-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>,
    <http://data.europa.eu/a4g/resource/3051b06e-8eb9-42a5-a505-222dbf856a6b-01/PartFrameworkAgreementTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingProcess1_ContractingSystem1>,
    <http://data.europa.eu/a4g/resource/3051b06e-8eb9-42a5-a505-222dbf856a6b-01/PartInterval$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>,
    <http://data.europa.eu/a4g/resource/3051b06e-8eb9-42a5-a505-222dbf856a6b-01/PartStartPeriod$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
