  epo:concernsProcurementElement <http://data.europa.eu/a4g/resource/151b206c-961e-4cd7-a73f-dfedf6fe8cbd-01/Procedure/0000000-0000-4000-8000-000000000000>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/other> .

