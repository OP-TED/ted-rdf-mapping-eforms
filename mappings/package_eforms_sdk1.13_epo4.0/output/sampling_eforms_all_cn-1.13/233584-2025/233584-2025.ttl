  epo:hasReceiptParticipationRequestDeadline "2025-05-13T09:00:00+02:00"^^xsd:dateTime;
  epo:hasTenderSubcontractingInformation <http://publications.europa.eu/resource/authority/subcontracting-indication/shar-subc>;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:isAdvancedElectronicSignatureRequired false;
  epo:isGuaranteeRequired true;
  epo:isMultipleTenderSubmissionAllowed true .

<http://data.europa.eu/a4g/resource/35cbfc40-54e9-49dc-b2a9-57d8a2061903-01/SubmissionTerm$_ContractNotice1_ProcurementProjectLot4>
  a epo:SubmissionTerm;
  epo:definesTenderProcessor <http://data.europa.eu/a4g/resource/35cbfc40-54e9-49dc-b2a9-57d8a2061903-01/TenderProcessor/ORG-0001>;
  epo:definesTenderReceiver <http://data.europa.eu/a4g/resource/35cbfc40-54e9-49dc-b2a9-57d8a2061903-01/TenderReceiver/ORG-0001>;
