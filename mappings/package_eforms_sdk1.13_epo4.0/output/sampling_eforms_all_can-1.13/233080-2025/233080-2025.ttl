  epo:hasAdditionalInformation "Keretmegállapodást kötött nyertes ajánlattevő: Oracle Hungary Kft. 1112 Budapest, Balatoni út 2. A. ép. 6. em. Adószám: 10845606-2-44"@hu;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/a1a750fa-e4f4-4f63-a60f-a22430efe38a-02/Lot/Identifier/EKR000306052021%2F1>;
