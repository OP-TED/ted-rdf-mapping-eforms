    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AwardEvaluationTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1_AppealTerms1>,
