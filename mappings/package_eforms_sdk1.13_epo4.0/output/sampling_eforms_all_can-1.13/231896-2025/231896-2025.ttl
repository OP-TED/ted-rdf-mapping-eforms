  epo:hasPurpose <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot17_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot17_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AwardEvaluationTerm$_ContractAwardNotice1_ProcurementProjectLot17_TenderingTerms1_AwardingTerms1_AwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot17_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot17_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot17_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot17_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot17_TenderingProcess1>;
  dct:description "Ivóvízvegyszerek beszerzése adásvételi keretszerződés keretében a szerződés hatálybalépésétől számított 12 hónapos időszakra vonatkozóan, a közbeszerzési dokumentumok mellékletét képező Műszaki leírásban és az „Ivóvízvegyszerek szállítási adatok” táblázatban részletezettek szerint. Ajánlatkérő a szerződés hatályát egy alkalommal további három hónapra meghosszabbíthatja. Ajánlatkérő felhívja a figyelmet, hogy a jellemző szállítási mennyiség és szállítási gyakoriság kizárólag tájékoztató adatként kerültek feltüntetésre. Ajánlatkérő a keretszerződést egy ajánlattevővel fogja megkötni, és a keretszerződés alapján a beszerzéseket egyedi megrendelések útján fogja megvalósítani, továbbá az egyedi megrendelésben fogja pontosan meghatározni a mennyiséget. Jelen közbeszerzés tárgya: Alapmennyiség: 29 000 kg nátrium-klorit 24-25 m/m %-os vizes oldata és 30 000 kg nátrium-klorit 7,5 m/m %-os vizes oldata beszerzése a DRV Zrt. ajánlatkérő részére. Az adásvételi keretszerződést a DRV Zrt. fogja megkötni a nyertes ajánlattevővel. Ajánlatkérő az alapmennyiség lehívására kötelezettséget vállal. Opciós mennyiség: a fent jelzett mennyiségek 20%-kal növelhetők: 5 800 kg nátrium-klorit 24-25 m/m %-os vizes oldata és 6 000 kg nátrium-klorit 7,5 m/m %-os vizes oldata. A részleteket az egyéb közbeszerzési dokumentumok tartalmazzák."@hu;
  dct:title "Nátrium-klorit beszerzése - DRV"@hu;
  adms:identifier <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/Identifier/LOT-0017> .

