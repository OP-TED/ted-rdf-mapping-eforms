  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot8_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
