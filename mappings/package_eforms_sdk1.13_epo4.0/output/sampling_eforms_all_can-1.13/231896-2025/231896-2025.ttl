  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot11_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AwardEvaluationTerm$_ContractAwardNotice1_ProcurementProjectLot11_TenderingTerms1_AwardingTerms1_AwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot11_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot11_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot11_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot11_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot11_TenderingProcess1>;
  dct:description "Ivóvíz vegyszerek beszerzése adásvételi keretszerződés keretében a szerződés hatálybalépésétől számított 12 hónapos időszakra vonatkozóan, a közbeszerzési dokumentumok mellékletét képező Műszaki leírásban és „Ivóvíz vegyszerek szállítási adatok” táblázatban részletezettek szerint. Ajánlatkérő felhívja a figyelmet, hogy a jellemző szállítási mennyiség és szállítási gyakoriság kizárólag tájékoztató adatként kerültek feltüntetésre. Ajánlatkérő a keretszerződést egy ajánlattevővel fogja megkötni, és a keretszerződés alapján a beszerzéseket egyedi megrendelések útján fogja megvalósítani, továbbá az egyedi megrendelésekben fogja pontosan meghatározni a mennyiséget. Az adásvételi keretszerződést a DRV Zrt. fogja megkötni a nyertes ajánlattevővel. Jelen közbeszerzés tárgya nátrium-hipoklorit beszerzése a DRV Zrt. ajánlatkérő részére. Alapmennyiség: Nátrium-hipoklorit oldat 90 g/l aktív klór tartalommal: 620 000 kg Nátrium-hipoklorit oldat 150 g/l aktív klór tartalommal: 150 000 kg Opciós mennyiség: 20%, azaz Nátrium-hipoklorit oldat 90 g/l aktív klór tartalommal: 124 000 kg Nátrium-hipoklorit oldat 150 g/l aktív klór tartalommal: 30 000 kg Az opciós mennyiség megrendelésére Ajánlatkérő nem vállal kötelezettséget. Az opciós mennyiség lehívására Ajánlatkérő egyoldalú jognyilatkozatával jogosult. A szerződés hatályba lép mindkét fél általi aláírással. A részleteket közbeszerzési dokumentumok tartalmazzák."@hu;
  dct:title "Nátrium-hipoklorit beszerzése a DRV Zrt. részére"@hu;
  adms:identifier <http://data.europa.eu/a4g/resource/a9568989-991b-4aed-92ec-d8660c586b49-02/Identifier/LOT-0011> .

