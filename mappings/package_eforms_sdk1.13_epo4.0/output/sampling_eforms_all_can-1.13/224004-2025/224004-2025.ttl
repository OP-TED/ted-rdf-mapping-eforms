<http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/Procedure/3641ffdc-3acc-4b77-a5ac-e847979aeb33>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/Procedure/Identifier/AVIS011553>;
  epo:hasLaunchFrameworkAgreementMaximumValue <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/ProcedureValueEstimateExtension$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasMainFeature "La présente consultation est une procédure avec négociation passée en application de l’article L. 2124-3 et des articles R. 2124-4 ainsi que des articles R. 2161-21 et du CCP. EDF se réserve la possibilité d’attribuer le marché sur la base de(s) offre(s) initiale(s), sans négociation (article R. 2161-23 du CCP)."@fr;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToProcedureSpecificTerm <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description """Pour être en mesure de répondre à la trajectoire d’obligation légale et règlementaire de CPB d'EDF, la Direction Commerce souhaite mettre en place un marché cadre avec des sociétés spécialisées qui lui permettront de vérifier l’intérêt des projets de biométhane identifiés. Ces sociétés devront être en mesure d’auditer et de qualifier ces projets afin de s'assurer de leur viabilité et de leur durabilité.
Ce marché a une durée totale de 8 ans (3 ans fermes et 5 options d'une année chacune). 
Ce marché est décrit dans le cahier des charges fourni dans l'onglet documents de l'appel à candidatures AVIS011553."""@fr;
  dct:title "Accord Cadre relatif à des prestations d'audit technique des projets de méthanisation pour la Direction Commerce d'EDF"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/5fde2e6b-6209-4a2e-afb5-cd053e704b76-01/Procedure/Identifier/3641ffdc-3acc-4b77-a5ac-e847979aeb33> .

