  epo:hasPurpose <http://data.europa.eu/a4g/resource/bc0efe88-2260-42a9-932c-ae3e52401d42-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/bc0efe88-2260-42a9-932c-ae3e52401d42-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/bc0efe88-2260-42a9-932c-ae3e52401d42-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/bc0efe88-2260-42a9-932c-ae3e52401d42-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/bc0efe88-2260-42a9-932c-ae3e52401d42-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "Mobiele keukens ten bate van opvanglocaties vluchtelingen Oekraïne. In het kader van de opvang Oekraïners zijn er in 2022 onder dwingende spoed bij de opvanglocaties noodunits geplaatst met daarin keukenvoorziezingen. De gemeente Meppel heeft hiervoor een contract afgesloten met BMWSR uit Assen. Dit bedrijf heeft de units aangesloten op de nutsvoorzieningen van het voormalig ziekenhuis. Het betreft de huur van 2 units mobiele keukens voor opvang Oekraïners. Het gaat om 2 gebouwen voor het eerste halfjaar van 2023, en zeer waarschijnlijk 1 gebouw voor het tweede halfjaar. Volgens de huidige verwachtingen wordt de opvang per 31 december 2023 gesloten. Het is onzeker of dit eventueel nog verlengd moet worden."@nl;
  dct:title "Mobiele Keukens Opvang"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/bc0efe88-2260-42a9-932c-ae3e52401d42-01/Identifier/LOT-0000> .

