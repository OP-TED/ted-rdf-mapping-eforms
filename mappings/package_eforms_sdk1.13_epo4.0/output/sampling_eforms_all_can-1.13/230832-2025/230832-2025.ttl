<http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation1>
  a epo:ReviewDecision;
  epo:hasConfirmedIrregularityType <http://publications.europa.eu/resource/authority/irregularity-type/other>;
  epo:hasDecisionDate "2024-07-31+02:00"^^xsd:date;
  dct:description "„CT készülékek beszerzése egészségügyi intézmények részére” tárgyú közbeszerzési eljárás kapcsán kezdeményezett jogorvoslati eljárás. Kérelmező: BLUEMED Plusz Kft. Jogorvoslati kérelem benyújtásának időpontja. 2024.07.31. A jogorvoslati kérelem az eljárás 2. része tekintetében került benyújtásra, amelyben Kérelmező a műszaki leírásban foglalt egyes előírásokat sérelmezte. A jogorvoslati eljárás a Döntőbizottság D.482/13/2024. számú végzésével megszüntetésre került."@hu;
  dct:title "Képalkotó diagnosztikai eszközök - 2021. CT beszerzése egészségügyi intézmények részére - 2. rész"@hu;
  adms:identifier <http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision/Identifier$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation1> .

<http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation2>
  a epo:ReviewDecision;
  epo:hasConfirmedIrregularityType <http://publications.europa.eu/resource/authority/irregularity-type/other>;
  epo:hasDecisionDate "2024-08-23+02:00"^^xsd:date;
  epo:hasReviewDecisionType <http://publications.europa.eu/resource/authority/review-decision-type/rej-npaid>;
  dct:description "„CT készülékek beszerzése egészségügyi intézmények részére” tárgyú közbeszerzési eljárás kapcsán kezdeményezett jogorvoslati eljárás. Kérelmező: Humantech Solution Zrt. Jogorvoslati kérelem benyújtásának időpontja. 2024.08.23. A jogorvoslati kérelem az eljárás 1-9. és 11-12. részei tekintetében került benyújtásra, amelyben Kérelmező a műszaki leírásban foglalt előírást sérelmezte. A jogorvoslati kérelmek a Döntőbizottság D.532/5/2024., D.533/5/2024., D.534/5/2024., D.535/5/2024., D.536/5/2024., D.537/5/2024., D.538/5/2024., D.539/5/2024., D.540/5/2024., D.541/5/2024. és D.542/5/2024 számú végzésével visszautasításra kerültek."@hu;
  dct:title "„Képalkotó diagnosztikai eszközök – 2021” - „CT készülékek beszerzése egészségügyi intézmények részére” - 1-9. rész, 11-12. rész EKR000825092021"@hu;
  adms:identifier <http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision/Identifier$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation2> .

<http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation3>
  a epo:ReviewDecision;
  epo:hasConfirmedIrregularityType <http://publications.europa.eu/resource/authority/irregularity-type/other>;
  epo:hasDecisionDate "2024-08-28+02:00"^^xsd:date;
  epo:hasReviewDecisionType <http://publications.europa.eu/resource/authority/review-decision-type/rej-npaid>;
  dct:description "„CT készülékek beszerzése egészségügyi intézmények részére” tárgyú közbeszerzési eljárás kapcsán kezdeményezett jogorvoslati eljárás. Kérelmező: Humantech Solution Zrt. Jogorvoslati kérelem benyújtásának időpontja. 2024.08.28. A jogorvoslati kérelem az eljárás 3., 5. és 7. részei tekintetében került benyújtásra, amelyben Kérelmező a műszaki leírásban foglalt előírás módosítását sérelmezte. Az eljárás 3. és 5. része tekintetében a jogorvoslati kérelem a Döntőbizottság D.545/4/2024. és D.546/4/2024. számú végzéseivel visszautasításra, az eljárás 7. része tekintetében pedig a D.547/14/2024. számú végzéssel a jogorvoslati eljárás megszüntetésre került."@hu;
  dct:title "„Képalkotó diagnosztikai eszközök – 2021” - „CT készülékek beszerzése egészségügyi intézmények részére” - 3., 5., 7. rész EKR000825092021"@hu;
  adms:identifier <http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision/Identifier$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation3> .

<http://data.europa.eu/a4g/resource/24bc44db-34bd-4e86-b8b9-040631216c86-02/ReviewDecision$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_Appeals1_AppealInformation4>
  a epo:ReviewDecision;
