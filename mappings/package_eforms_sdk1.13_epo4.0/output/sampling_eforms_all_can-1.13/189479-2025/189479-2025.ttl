  epo:hasAdditionalInformation "La société nationale SNCF émet cet avis d'attribution au nom et pour le compte de la société SNCF Voyageurs."@fr;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/0e6014f8-e558-48ac-81c4-f6b63cdf972f-01/Procedure/Identifier/2024DOS0660588>;
