epd:id_59024f62-55a3-4311-8b83-770441f45567_AwardCriterion_cFotwJSndXyrHDcstooyk3
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
  dct:description """Ocena oferty w tym kryterium zostanie dokonana na podstawie złożonego przez Wykonawcę oświadczenia w ofercie, gdzie Zamawiający przyzna wykonawcy:
– 0 pkt. za termin dostawy wynoszący do 6 tygodni;
– 20 pkt. za termin dostawy wynoszący do 5 tygodni;
– 40 pkt. za termin dostawy wynoszący do 4 tygodni.  """@pl .

