<http://data.europa.eu/a4g/resource/fe6432a3-6659-4d06-93ac-b79ff404f616-01/Procedure/b4d99da3-b2f4-4200-b4f4-423f498fb768>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/fe6432a3-6659-4d06-93ac-b79ff404f616-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
