<http://data.europa.eu/a4g/resource/1c251775-71f4-4b4d-b08f-3f0106cffe79-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractDuration <http://data.europa.eu/a4g/resource/1c251775-71f4-4b4d-b08f-3f0106cffe79-01/ContractDuration$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
