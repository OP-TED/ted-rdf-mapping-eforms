  epo:hasChangeJustification <http://publications.europa.eu/resource/authority/change-corrig-justification/update-add>;
  epo:hasChangeReasonDescription """Zmiana zapisów dotyczących: 
1. Wartości szacunkowych poszczególnych części zamówienia 
2. Szacunkowego okresu obowiązywania części zamówienia 
3. Terminów składania ofert w poszczególnych częściach zamówienia
