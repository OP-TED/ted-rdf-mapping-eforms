  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/85337936-8207-4e3b-ad39-4b1c75cdb105-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
