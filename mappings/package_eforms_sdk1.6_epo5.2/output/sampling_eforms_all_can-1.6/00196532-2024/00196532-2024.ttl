<http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/Lot/LOT-0000>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
