  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/GreenProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType1>,
    <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/InnovativeProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType3>,
    <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/SocialProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/SocialProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_ProcurementAdditionalType2>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:hasRecurrenceDescription """Storitve svetovanja in uporabniške podpore prebivalcem pri uporabi naslednjih digitalnih javnih storitev:
•	uporaba elektronske osebne izkaznice in s tem povezane mobilne aplikacije,
•	prijava v elektronske storitve in elektronsko podpisovanje,
•	dostop do informacij o delu državne uprave na portalu gov.si,
•	dostop do elektronskih storitev na portalu eUprava,
•	registracija in prijava v portal SPOT, 
•	uporaba storitev eZdravja na portalu zVEM, 
•	dostop do e-storitev ZPIZ,
•	uporaba državnega davčnega portala eDavki,
•	dostop do elektronske zemljiške knjige,
•	uporaba elektronskih vinjet na portalu DARS,
•	storitve z zvezi s študijem in štipendijami,
•	storitve MKGP in UVHVVR, portal Volos,
•	prepoznava spletnih nevarnosti, center SI-CERT."""@sl;
  epo:isCoveredByGPA false;
  epo:isRecurrent false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/356291aa-60ab-418a-b07b-526d7b9d5259-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
