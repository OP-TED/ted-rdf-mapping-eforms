  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/e99556b4-2a07-4ba6-a7ce-976b88e6c0e7-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
