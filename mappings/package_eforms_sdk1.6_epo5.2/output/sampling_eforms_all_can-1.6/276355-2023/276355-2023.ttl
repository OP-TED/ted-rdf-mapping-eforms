  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/e99556b4-2a07-4ba6-a7ce-976b88e6c0e7-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/e99556b4-2a07-4ba6-a7ce-976b88e6c0e7-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/e99556b4-2a07-4ba6-a7ce-976b88e6c0e7-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description "LMR laboratory quality system is ISO 17025 accredited by ACCREDIA, the Italian Accreditation Body for 24 test methods. LMR benefits of several contracts for IT, quality and analytical support. Since LMR has limited capabilities in processing and measuring radioactive and potentially radioactive samples, to satisfy the demand of radiochemical analyses from NDWDM services, it has been decided to outsource part of such analyses to a Contractor. Contractor will perform sample analyses in its premises. Contractor has to perform radiochemical analyses of radioactive and potentially radioactive samples."@en;
  dct:title "Off-site analytical support to site Laboratory for Radioactivity Measurements of Joint Research Centre Ispra"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/e99556b4-2a07-4ba6-a7ce-976b88e6c0e7-01/Identifier/LOT-0001> .

