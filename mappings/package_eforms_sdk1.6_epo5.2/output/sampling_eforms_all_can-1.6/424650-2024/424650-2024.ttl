  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/per-exa>;
  cccev:weight 20.0;
  dct:description "P3(n) = NrClinici(n) / NrClinici(max) x 20, unde: NrClinici(n) – Numărul de clinici multidisciplinare în București ofertat de ofertantul (n), NrClinici(max) – Număr de clinici multidisciplinare în București maxim ofertat dintre ofertele evaluate, P3(n) – Punctajul obținut de ofertant pentru numărul de clinici multidisciplinare în București ofertat"@ro;
  skos:prefLabel "(P3) Număr de clinici multidisciplinare în București"@ro .

<http://data.europa.eu/a4g/resource/6c9c0638-39b6-444d-a402-5812ba29638a-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion4>
