  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/quality>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/per-exa>;
  cccev:weight 30.0;
  dct:description "P2(n) = PDso(n) / PDso(max) x 30, unde: PDso(n)– Procent de discount suplimentar ofertat de ofertantul (n), PDso(max) – Procent de discount suplimentar maxim ofertat dintre ofertele evaluate, P2(n) – Punctajul obținut de ofertant pentru procentul de discount suplimentar ofertat."@ro;
  skos:prefLabel "(P2) - Procent de discount suplimentar peste cel solicitat, conform Anexa nr. 2"@ro .

<http://data.europa.eu/a4g/resource/6c9c0638-39b6-444d-a402-5812ba29638a-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion3>
