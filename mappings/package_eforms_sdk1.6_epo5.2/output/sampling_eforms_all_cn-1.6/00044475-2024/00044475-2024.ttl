<http://data.europa.eu/a4g/resource/a367579c-5dd6-4ef0-8784-b0a08ee4c6d5-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesEstimatedContractDuration <http://data.europa.eu/a4g/resource/a367579c-5dd6-4ef0-8784-b0a08ee4c6d5-01/ContractDuration$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/supplies>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering false;
  epo:hasEPayment false;
  epo:hasPaymentArrangement """Izvajalec za dobavljeno blago izstavlja mesečne račune izključno v predpisani elektronski obliki (eRačun), in sicer najkasneje do 15. v mesecu za pretekli mesec. Izvajalec računu priloži originalen izvod dobavnice in ostalo potrebno dokumentacijo glede na vrsto posla.
Vse dobavnice in računi morajo biti opremljeni s številko tega okvirnega sporazuma.
Plačilni rok: 30 dni od dneva prejema pravilno izstavljenega računa, ki ni zavrnjen v roku osmih dni od prejema. """@sl;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

