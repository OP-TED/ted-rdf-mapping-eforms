  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/price>;
  dct:description "Merilo za izbor je ekonomsko najugodnejša ponudba (prvi odstavek 84. člena ZJN-3). Ekonomsko najugodnejša ponudba je tista ponudba, v kateri bo ponujena najnižja skupna vrednost. Naročnik bo v fazi zbiranja ponudb na podlagi zbranih ponudb oddal naročilo za posamezni sklop tistemu ponudniku, ki bo podal najnižjo skupno vrednost za posamezni sklop."@sl;
  skos:prefLabel "Najnižja skupna vrednsot"@sl .

