  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/319284f7-1c90-48d6-8111-fedac5e227e2-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/319284f7-1c90-48d6-8111-fedac5e227e2-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description "The Call for Tenders concerns the review of the Decommissioning Plan (and associated cost estimate) of HFR, the nuclear reactor on the Petten site JRC owns and for whose decommissioning JRC is responsible. The review will also elaborate on the implications the Decommissioning Plan has in terms of the internal organization that JRC needs to set up to manage the decommissioning of HFR effectively and efficiently."@en;
  dct:title "Review of HFR Decommissioning Plan, cost estimate and its implementation"@en .

