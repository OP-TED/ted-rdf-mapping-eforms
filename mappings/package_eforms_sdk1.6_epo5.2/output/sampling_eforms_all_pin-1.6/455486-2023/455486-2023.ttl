<http://data.europa.eu/a4g/resource/319284f7-1c90-48d6-8111-fedac5e227e2-01/PlannedProcurement$_PriorInformationNotice1_ProcurementProject1>
  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/319284f7-1c90-48d6-8111-fedac5e227e2-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "This prior information notice announces the intention of the contracting authority to publish a future call for tenders. No other information or documents are available at this stage. Interested economic operators are invited to subscribe at the link https://etendering.ted.europa.eu/cft/cft-display.html?cftId=14623 in order to get notified when the contract notice and all the procurement documents, including the tender specifications, are published."@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/319284f7-1c90-48d6-8111-fedac5e227e2-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
