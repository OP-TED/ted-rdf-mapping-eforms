<http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/PlannedProcurement$_PriorInformationNotice1_ProcurementProject1>
  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "This prior information notice announces the intention of the contracting authority to publish a future call for tenders. No other information or documents are available at this stage. Interested economic operators are invited to subscribe at the link https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/tender-details/606c18f6-f539-40cf-b65a-20ae065d719b-PIN in order to get notified when the contract notice and all the procurement documents, including the tender specifications, are published."@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/PlannedProcurement/Identifier/NEAR%2FANK%2F2023%2FEA-RP%2F0221-PIN>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description """The main objective of this project is to enhance sustainability, financial viability and social impact of Civil Society Organisations (CSOs) and non-state actors supporting social needs-driven development. This project will:
•	strengthen skills and knowledge on social entrepreneurship of (CSOs) and social enterprises, promote partnerships/networking between CSOs and social enterprises working in the same social domain  and raise public awareness on social entrepreneurship;
•	strengthen institutional, policy and regulatory framework related to social entrepreneurship in Türkiye.
For this purpose, various capacity building and awareness raising activities, such as, organization of trainings, workshops, networking events and study visits, provision of consultancy services and development of tools will be realised in line with technical studies, plans, policy papers and reports that are also expected to be prepared by the contractor under this contract."""@en;
  dct:title "Technical Assistance for Supporting Civil Society Through Social Entrepreneurship in Türkiye"@en .

<http://data.europa.eu/a4g/resource/6b65f3ed-38f5-406c-97bd-5941ea91e352-01/PlannedProcurement/Identifier/NEAR%2FANK%2F2023%2FEA-RP%2F0221-PIN>
  a adms:Identifier;
  skos:notation "NEAR/ANK/2023/EA-RP/0221-PIN" .

