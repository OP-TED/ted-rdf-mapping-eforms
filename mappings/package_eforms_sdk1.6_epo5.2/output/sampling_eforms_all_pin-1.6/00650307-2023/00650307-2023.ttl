<http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/PlannedProcurement$_PriorInformationNotice1_ProcurementProject1>
  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "This prior information notice announces the intention of the contracting authority to publish a future call for tenders. No other information or documents are available at this stage. Interested economic operators are invited to subscribe at the link https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/tender-details/f10c5e15-f6d1-4505-8410-dc8be18af284-PIN in order to get notified when the contract notice and all the procurement documents, including the tender specifications, are published."@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/PlannedProcurement/Identifier/JRC%2FIPR%2F2023%2FOP%2F2661-PIN>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32018R1046>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description """The foreseen call for tender will result in a single framework contract supporting the 4th phase of the Copernicus Emergency Management Service (EMS) .
The framework contract will cover standardized RRM products (RRM - STD). The services consist in the provision of on-demand geospatial information supporting the emergency management activities not related to the immediate response phase. This service addresses prevention, preparedness, disaster risk reduction or recovery phases. 
Economic operators are invited to participate in the request for information at the following link: https://ec.europa.eu/eusurvey/runner/CEMS_Standard_2023"""@en;
  dct:title "Copernicus Emergency Management Service (CEMS)  Risk and Recovery Mapping Standardised (STANDARD)"@en .

<http://data.europa.eu/a4g/resource/d9b10b17-d014-4ee6-9cab-d3f3930b13c8-01/PlannedProcurement/Identifier/JRC%2FIPR%2F2023%2FOP%2F2661-PIN>
  a adms:Identifier;
  skos:notation "JRC/IPR/2023/OP/2661-PIN" .

