        rml:referenceFormulation ql:XPath ;
    ] ;
    rr:subjectMap [
        rdfs:label "ND-PartReservedProcurement" ;
        rr:template "http://data.europa.eu/a4g/resource/{/*/cbc:ID[@schemeName='notice-id']}-{/*/cbc:VersionID}/ParticipationCondition${replace(translate(path(../../../..), concat(codepoints-to-string(123), codepoints-to-string(125), '/[]'), '  _'), 'Q .*? ', '')}" ;
        rr:class epo:ParticipationCondition
    ] ;
    rr:predicateObjectMap [
