  a epo:SubmissionTerm;
  epo:definesTenderReceiver <http://data.europa.eu/a4g/resource/50cb24c1-4aa3-40b4-9035-7a33d2fa0b66-01/TenderReceiver/ORG-7001>;
  epo:hasECataloguePermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
