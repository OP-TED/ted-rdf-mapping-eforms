  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/8778c7c8-2762-4f17-95b9-ddaaf79e0fc7-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
