  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering true;
  epo:hasEPayment false;
  epo:hasOptionsDescription "Die Laufzeit des Vertrages verlängert sich 1-malig um 1 Jahr wenn der Verlängerung nicht entsprechend den Verdingungsunterlagen widersprochen wird. Dem Auftraggeber wird darüber hinaus das Recht eingeräumt, die Laufzeit des Vertrages unter der Bedingung zu verlängern, wenn es bei der Durchführung des nachfolgenden Vergabeverfahrens zu Verzögerung kommt,"@de;
