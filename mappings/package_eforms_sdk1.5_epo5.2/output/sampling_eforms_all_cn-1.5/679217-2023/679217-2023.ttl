<http://data.europa.eu/a4g/resource/3ab37d3d-76d0-4bea-96b4-6fc056e48bc4-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
