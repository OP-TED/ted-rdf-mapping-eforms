<http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/PlannedProcurement$_PriorInformationNotice1_ProcurementProject1>
  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "This prior information notice announces the intention of the contracting authority to publish a future call for tenders. No other information or documents are available at this stage. Interested economic operators are invited to subscribe at the following address: https://etendering.ted.europa.eu/cft/cft-display.html?cftId=13260 in order to get notified when the contract notice and all the procurement documents, including the tender specifications, are published. Economic operators are also invited to participate in the request for information at the following link: https://ec.europa.eu/eusurvey/runner/CEMS_Flex_2023 "@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/PlannedProcurement/Identifier/JRC%2FIPR%2F2023%2FOP%2F0198-PIN>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description """The 4th phase of the Copernicus Emergency Management Service (CEMS) includes a framework contract with reopening of competition for flexible products (so called FLEX).
The service consists of the on-demand provision of geospatial information. This information supports emergency management activities not related to the immediate response phase.This service addresses prevention, preparedness, disaster risk reduction and/or recovery phases. Economic operators are invited to participate in the request for information at the following link: https://ec.europa.eu/eusurvey/runner/CEMS_Flex_2023. """@en;
  dct:title "FRAMEWORK SERVICE CONTRACT FOR COPERNICUS EMERGENCY MANAGEMENT SERVICE (CEMS) RISK AND RECOVERY MAPPING (RRM) TAILOR-MADE PRODUCTS (FLEX)"@en .

<http://data.europa.eu/a4g/resource/ae0849b1-3923-4fbb-9ff9-4ae5f089fa62-01/PlannedProcurement/Identifier/JRC%2FIPR%2F2023%2FOP%2F0198-PIN>
