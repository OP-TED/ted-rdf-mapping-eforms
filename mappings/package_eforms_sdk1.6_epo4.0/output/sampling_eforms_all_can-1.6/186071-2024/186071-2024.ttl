<http://data.europa.eu/a4g/resource/107f16b0-b4b9-4819-9ff2-da6616cf1847-01/Procedure/92efa382-9b60-44bb-8aa8-f5b1a4f0fcae>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/107f16b0-b4b9-4819-9ff2-da6616cf1847-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
  epo:hasAcceleratedProcedureJustification "Definitivarea zonelor de combatere s-a facut in luna februarie 2024. DS Giurgiu doreste accelerarea procedurii deoarece tratamentele de cobatere se vor efectua in luna aprilie, functie de evolutia temperaturilor, intrarea un vegetatie a arborilor si varsta omizilor (varstele L1 - L3). Perioada de 15 zile este suficienta pentru elaborarea ofertei, procedura de achizitie fiind simpla, cu minime conditii de calificare, formularele de oferta tehnica si financiara sunt usor de intocmit si completat."@ro;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/107f16b0-b4b9-4819-9ff2-da6616cf1847-01/Procedure/Identifier/1692%2F05.03.2024>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/107f16b0-b4b9-4819-9ff2-da6616cf1847-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/107f16b0-b4b9-4819-9ff2-da6616cf1847-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated true;
  dct:description "Furnizarea de insecticid biologic pentru combatere avio conform caiet de sarcini;  AC va raspunde in mod clar si complet tuturor solicitarilor de clarificari in a 3-a zi inainte de data limita stabilita pentru depunerea ofertelor. Numarul de zile pana la care se pot solicita clarificari inainte de data limita de depunere a ofertelor/candidaturilor:5;"@ro;
  dct:title "FURNIZARE INSECTICIDE BIOLOGICE PENTRU COMBATERE AVIO"@ro;
  adms:identifier <http://data.europa.eu/a4g/resource/107f16b0-b4b9-4819-9ff2-da6616cf1847-01/Procedure/Identifier/92efa382-9b60-44bb-8aa8-f5b1a4f0fcae> .

