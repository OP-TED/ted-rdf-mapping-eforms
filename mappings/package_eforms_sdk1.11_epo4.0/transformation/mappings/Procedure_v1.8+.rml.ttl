tedm:MG-ContractTerm-foreseesTerm-Procedure_ND-ProcedureContractAdditionalNature a rr:TriplesMap ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/cac:ProcurementProject/cac:ProcurementAdditionalType[cbc:ProcurementTypeCode/@listName='contract-nature']" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-531-Procedure (value)" ;
            rdfs:comment "Additional Nature (different from Main) of MG-ContractTerm under ND-ProcedurePlacePerformanceAdditionalInformation" ;
            rr:predicate epo:hasAdditionalContractNature ;
            rr:objectMap
                [
                    tedm:minSDKVersion "1.8" ;
                    rdfs:label "at-voc:contract-nature" ;
                    rr:parentTriplesMap tedm:contract-nature ;
                    rr:joinCondition [
                        rr:child "cbc:ProcurementTypeCode" ;
                        rr:parent "code.value" ;
                    ] ;
                ]
        ] ;
.

tedm:MG-ContractTerm-foreseesTerm-PlannedProcurement_ND-ProcedureContractAdditionalNature a rr:TriplesMap ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/cac:ProcurementProject/cac:ProcurementAdditionalType[cbc:ProcurementTypeCode/@listName='contract-nature']" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-531-Procedure (value; PIN notices)" ;
            rdfs:comment "Additional Nature (different from Main) of MG-ContractTerm under ND-ProcedureContractAdditionalNature" ;
            rr:predicate epo:hasAdditionalContractNature ;
            rr:objectMap
                [
                    tedm:minSDKVersion "1.8" ;
                    rdfs:label "at-voc:contract-nature" ;
                    rr:parentTriplesMap tedm:contract-nature ;
                    rr:joinCondition [
                        rr:child "cbc:ProcurementTypeCode" ;
                        rr:parent "code.value" ;
                    ] ;
                ]
        ] ;
.

tedm:MG-PlannedProcurement-specifiesProcurementCriterion-ExclusionGround_ND-ExclusionGrounds_v1.8-1.11 a rr:TriplesMap ;
    rdfs:label "MG-PlannedProcurement" ;
    tedm:maxSDKVersion "1.11" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/cac:TenderingTerms/cac:TendererQualificationRequest/cac:SpecificTendererRequirement" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-ExclusionGrounds" ;
            rml:reference "if (exists(/*/ext:UBLExtensions/ext:UBLExtension/ext:ExtensionContent/efext:EformsExtension/efac:NoticeSubType/cbc:SubTypeCode[contains('1 2 3 4 5 6 E2', text())])) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/PlannedProcurement$' || replace(replace(replace(path(/*/cac:ProcurementProject), 'Q\\{[^}]+\\}', ''), '\\[([0-9]+)\\]', '$1'), '/', '_') else null" ;
            rr:class epo:PlannedProcurement
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-67-PlannedProcurement" ;
            rr:predicate epo:specifiesProcurementCriterion ;
            rr:objectMap
                [
                    rr:parentTriplesMap tedm:MG-ExclusionGround-specifiesProcurementCriterion-PlannedProcurement_ND-ExclusionGrounds_v1.8-1.11 ;
                ] ;
        ] ;
.

tedm:MG-ExclusionGround-specifiesProcurementCriterion-PlannedProcurement_ND-ExclusionGrounds_v1.8-1.11 a rr:TriplesMap ;
    rdfs:label "MG-ExclusionGround" ;
    tedm:maxSDKVersion "1.11" ;
    rml:logicalSource
        [
            rml:source "data/source.xml" ;
            rml:iterator "/*/cac:TenderingTerms/cac:TendererQualificationRequest/cac:SpecificTendererRequirement" ;
            rml:referenceFormulation ql:XPath
        ] ;
    rr:subjectMap
        [
            rdfs:label "ND-ExclusionGrounds" ;
            rml:reference "if (exists(cbc:TendererRequirementTypeCode[@listName='exclusion-ground'])) then 'http://data.europa.eu/a4g/resource/' || /*/cbc:ID[@schemeName='notice-id'] || '-' || /*/cbc:VersionID || '/ExclusionGround$' || replace(replace(replace(path(), 'Q\\{[^}]+\\}', ''), '\\[([0-9]+)\\]', '$1'), '/', '_') else null" ;
            rr:class epo:ExclusionGround
        ] ;
    rr:predicateObjectMap
        [
            rdfs:label "BT-67(a)-PlannedProcurement" ;
            rr:predicate epo:hasExclusionGroundType ;
            rr:objectMap
                [
                    rdfs:label "at-voc:exclusion-ground" ;
                    rr:parentTriplesMap tedm:exclusion-ground ;
                    rr:joinCondition [
                        rr:child "cbc:TendererRequirementTypeCode[@listName='exclusion-ground']" ;
                        rr:parent "code.value" ;
                    ] ;
                ] ;
        ] ;
.

