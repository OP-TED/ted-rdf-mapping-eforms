<http://data.europa.eu/a4g/resource/6bc36a2d-ea46-4ba2-be92-4fe28b78f88b-02/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/6bc36a2d-ea46-4ba2-be92-4fe28b78f88b-02/ReviewProcedureInformationProvider/ORG-0002organization>;
