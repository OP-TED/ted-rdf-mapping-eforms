<http://data.europa.eu/a4g/resource/a16c47a7-4374-4023-8023-4277dd716890-02/Procedure/8e6b9cc1-390c-4018-a27a-c1be74822a16>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/a16c47a7-4374-4023-8023-4277dd716890-02/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/a16c47a7-4374-4023-8023-4277dd716890-02/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation """The date of conclusion of the contract is expected to take place no sooner than 2nd February 2025. 
