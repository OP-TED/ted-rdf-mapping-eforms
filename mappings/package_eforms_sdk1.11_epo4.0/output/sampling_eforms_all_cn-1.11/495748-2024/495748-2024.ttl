    <http://data.europa.eu/a4g/resource/77cda98b-0bfb-455a-8915-f9c8d80bea16-01/Lot/LOT-0004>;
  a epo:Reviewer;
  epo:contextualisedBy <http://data.europa.eu/a4g/resource/77cda98b-0bfb-455a-8915-f9c8d80bea16-01/Lot/LOT-0005>,
    <http://data.europa.eu/a4g/resource/77cda98b-0bfb-455a-8915-f9c8d80bea16-01/Lot/LOT-0006>,
