<http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/Procedure/2aefc9bd-5a1c-4624-8573-a4e5448fe2b7>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasAcceleratedProcedureJustification "Wyznaczenie krótszego terminu składania ofert wynika z art. 411 ust. 7 Pzp, który wskazuje, że \"jeżeli zachodzi pilna potrzeba udzielenia zamówienia, zamawiający może wyznaczyć krótszy termin składania wniosków o dopuszczenie do udziału w postępowaniu, jednak nie krótszy niż 10 dni od dnia przekazania do publikacji ogłoszenia o zamówieniu Urzędowi Publikacji Unii Europejskiej\""@pl;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/Procedure/Identifier/56%2FU>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32009L0081>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated true;
  epo:isSubjectToProcedureSpecificTerm <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description """Przedmiotem zamówienia jest Pełnienie kompleksowego nadzoru inwestorskiego na
zadaniach:
1. Bemowo – Piskie – Budowa magazynów wraz z infrastrukturą towarzyszącą,
wyburzeniem budynku nr 7 i budową wartowni w nowej lokalizacji;
2. Bemowo Piskie – Montaż systemów alarmowych w budynkach magazynowych wraz
z infrastrukturą towarzyszącą.
Szczegółowo przedmiot zamówienia opisano w załączniku nr 2 do SWZ."""@pl;
  dct:title """Pełnienie kompleksowego nadzoru inwestorskiego na zadaniach:
1. Bemowo – Piskie – Budowa magazynów wraz z infrastrukturą towarzyszącą,
wyburzeniem budynku nr 7 i budową wartowni w nowej lokalizacji;
2. Bemowo Piskie – Montaż systemów alarmowych w budynkach magazynowych wraz z
infrastrukturą towarzyszącą – postępowanie nr 56/U."""@pl;
  adms:identifier <http://data.europa.eu/a4g/resource/674fa96b-d6b6-4eb7-842a-a8c0b0808118-01/Procedure/Identifier/2aefc9bd-5a1c-4624-8573-a4e5448fe2b7> .

