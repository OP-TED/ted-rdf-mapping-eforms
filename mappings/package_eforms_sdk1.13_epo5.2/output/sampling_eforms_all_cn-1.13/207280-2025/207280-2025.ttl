<http://data.europa.eu/a4g/resource/6c518b98-6040-4d04-bff9-a74439307ba9-01/Procedure/af3248af-7ffa-4741-9543-043fb7981d2a>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/6c518b98-6040-4d04-bff9-a74439307ba9-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/6c518b98-6040-4d04-bff9-a74439307ba9-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/6c518b98-6040-4d04-bff9-a74439307ba9-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/6c518b98-6040-4d04-bff9-a74439307ba9-01/Procedure/Identifier/AQDSP2027>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0023>;
  epo:hasMainFeature """La présente consultation est organisée dans le cadre des dispositions du code de la commande publique ainsi que des articles L.1411-1 et suivants et R.1411-1 du Code général des collectivités territoriales (ci-après \" CGCT \") relatives aux délégations de service public.
La procédure étant \" restreinte \", seuls les opérateurs dont la candidature a été retenue par la commission de délégation de service public se sont vu transmettre le dossier de consultation des entreprises pour leur permettre d'élaborer leur offre. L'information transmise dans l'avis rectificatif paru (dans le BOAMP, sous le numéro 25-33799, le 27/03/2025 ;
au JOUE, sous le numéro 197168-2025 le 27/03/2025) n'est destinée qu'aux candidats sélectionnés pour soumissionner. Cet avis rectificatif a donc été publié à tort au BOAMP et au JOUE. Il est de ce fait superfétatoire et ne doit donc pas être pris en compte."""@fr;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/6c518b98-6040-4d04-bff9-a74439307ba9-01/Lot/LOT-0001>;
