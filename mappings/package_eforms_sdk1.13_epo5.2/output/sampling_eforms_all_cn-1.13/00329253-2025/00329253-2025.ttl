ocialaalba.ro la sectiunea licitatii."@ro .

<http://data.europa.eu/a4g/resource/c4f0a3ba-9b78-45e7-a205-a842ab4a6525-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot2_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
