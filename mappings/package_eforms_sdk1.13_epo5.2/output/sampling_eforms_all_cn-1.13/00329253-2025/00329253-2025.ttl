<http://data.europa.eu/a4g/resource/c4f0a3ba-9b78-45e7-a205-a842ab4a6525-01/SubmissionTerm$_PriorInformationNotice1_ProcurementProjectLot8>
  a epo:SubmissionTerm;
  epo:definesTenderProcessor <http://data.europa.eu/a4g/resource/c4f0a3ba-9b78-45e7-a205-a842ab4a6525-01/TenderProcessor/ORG-0001>;
