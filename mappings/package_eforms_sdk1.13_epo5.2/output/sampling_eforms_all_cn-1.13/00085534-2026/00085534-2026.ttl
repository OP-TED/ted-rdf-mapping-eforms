<http://data.europa.eu/a4g/resource/aea1d484-c7d3-4186-8a56-68ec2bf99dbb-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/aea1d484-c7d3-4186-8a56-68ec2bf99dbb-01/ReviewProcedureInformationProvider/ORG-0001>;
