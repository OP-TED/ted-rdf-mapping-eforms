  epo:isAccelerated false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/b18085c1-3f93-4094-85c5-3976e19764ae-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest2_SpecificTendererRequirement1>;
  dct:description "The Environment and Planning Department of the City of Reykjavík invites tenders for the provision of consultancy services. The procurement concerns specialist consultancy services in the fields of building and construction, transport and mobility, environmental matters, and spatial and urban planning, as further defined in the scope of services. The consultancy services are limited to and governed by the description set out in the scope of services. They include, inter alia, design services (both primary design and detailed design), construction management, supervision, preparation of planning documents, transport plans, environmental services, and other related professional services. This procurement is conducted as a framework agreement, under which any eligible company may submit a tender. This framework agreement procurement does not constitute a commitment to purchase services. "@en;
  dct:title "16261 Framework Agreement on Specialist Services"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/b18085c1-3f93-4094-85c5-3976e19764ae-01/Procedure/Identifier/66921731-91d2-49f4-bbc8-92eec5fe904a> .

