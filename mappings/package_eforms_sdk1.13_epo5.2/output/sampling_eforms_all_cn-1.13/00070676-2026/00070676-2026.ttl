<http://data.europa.eu/a4g/resource/f4d7bcbb-6020-4af0-9206-1a4db4667ebf-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>
  a epo:SelectionCriterion;
