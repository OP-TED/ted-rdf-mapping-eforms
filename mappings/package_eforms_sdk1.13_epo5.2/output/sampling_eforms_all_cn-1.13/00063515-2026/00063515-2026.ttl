<http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/Lot/LOT-0000>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>,
    <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/SocialProcurement$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:hasAdditionalInformation """Riigihange ei ole jagatud osadeks, kuna hankelepingu esemeks on prototüübi väljatöötamine ja katsetamine. Seda protsessi ei ole võimalik jagada osadeks ilma lõpptulemuse kvaliteeti kahjustamata. Eesmärk on saavutada töötav ja reaalses keskkonnas testitud prototüüp. Selle väljatöötamine on terviklik ja omavahel tihedalt seotud tegevuste jada, mida ei ole mõistlik ega teostatav mõõdetavateks etappideks eraldada.

Kui hanke alusdokumentides on märgitud kindel ostuallikas, protsess, kaubamärk, patent, tüüp, päritolu, tootmisviis või RHS § 88 lg-s 2 nimetatud alus, on RHS § 88 lg 3, 6 ja 7 kohaselt pakkujatel alati õigus pakkuda samaväärseid tooteid, olenemata sellest, kas hankija on lisanud märke „või sellega samaväärne“."""@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/Lot/Identifier/304487-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/LotPurpose$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isRecurrent false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/AccessTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
