<http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/Procedure/5871cb20-a5f1-4bbf-a82c-308039aa5d70>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation """Riigihange ei ole jagatud osadeks, kuna hankelepingu esemeks on prototüübi väljatöötamine ja katsetamine. Seda protsessi ei ole võimalik jagada osadeks ilma lõpptulemuse kvaliteeti kahjustamata. Eesmärk on saavutada töötav ja reaalses keskkonnas testitud prototüüp. Selle väljatöötamine on terviklik ja omavahel tihedalt seotud tegevuste jada, mida ei ole mõistlik ega teostatav mõõdetavateks etappideks eraldada.

Kui hanke alusdokumentides on märgitud kindel ostuallikas, protsess, kaubamärk, patent, tüüp, päritolu, tootmisviis või RHS § 88 lg-s 2 nimetatud alus, on RHS § 88 lg 3, 6 ja 7 kohaselt pakkujatel alati õigus pakkuda samaväärseid tooteid, olenemata sellest, kas hankija on lisanud märke „või sellega samaväärne“."""@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/Procedure/Identifier/304487-0000>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Avatud hankemenetlus"@et;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>,
    <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement2>;
  dct:description """Käesoleva hankemenetluse esemeks on mehitamata õhusõidukile (droonile) puudel asuvates kormoranipesades munade õlitamiseks paigaldatava seadme prototüübi välja töötamine ja katsetamine vastavalt HD lisas 1 esitatud tehnilisele kirjeldusele.
Hankelepingu täitmise tähtaeg on hiljemalt 18 (kaheksateist) kuud pärast hankelepingu sõlmimist.
Hanketeatel märgitud lepingu sõlmimise algusaeg on eelduslik ja pole õiguslikult siduv. / Kõrvaldamise alused ja kvalifitseerimistingimused: Vaata hanke alusdokumentidest"""@et;
  dct:title "Mehitamata õhusõidukile (droonile) puudel asuvates kormoranipesades munade õlitamiseks paigaldatava seadme prototüübi välja töötamine ja katsetamine"@et;
  adms:identifier <http://data.europa.eu/a4g/resource/8e33d009-ccd5-493d-bfb6-57e4dbc3ef13-01/Procedure/Identifier/5871cb20-a5f1-4bbf-a82c-308039aa5d70> .

