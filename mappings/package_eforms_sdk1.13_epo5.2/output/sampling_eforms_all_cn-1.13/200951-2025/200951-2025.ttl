<http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/Procedure/702de10e-e5a9-4883-b3f6-d0f1498c680d>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/MonetaryValueProcedure$_ContractNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/Procedure/Identifier/44345>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature """Europese Niet-Openbare procedure volgens hoofdstuk 4 van de Algemene Richtlijn Werken (ARW).

Fase 1 is de aanmeldingsfase waarin alle geïnteresseerde partijen die denken te voldoen aan de geschiktheidseisen zich kunnen aanmelden voor 1 of 2 percelen. Doel: per perceel maximaal 3 partijen selecteren voor de volgende fase.
Fase 2 is de inschrijvingsfase waarin de max. 6 overgebleven partijen in dialoog (kunnen) gaan met de opdrachtgever over de opgave. Doel: op basis van de inschrijving (prijs en kwaliteit) per perceel een raamovereenkomst afsluiten met 1 partij."""@nl;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/comp-dial>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/Lot/LOT-0002>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/ProcedureTerm$_ContractNotice1_TenderingTerms1_LotDistribution1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description "De nieuwbouw van gestandaardiseerde legeringsgebouwen voor Defensie. Deze bestaan uit 1- en/of 8-persoonslegeringkamers die verspreid door Nederland op Defensie locaties komen te staan. Circa 2000 legeringsbedden (1-/8-persoonskamers) verdeeld over 2 percelen."@nl;
  dct:title "44345 | Raamovereenkomst voor de nieuwbouw van gestandaardiseerde legeringsgebouwen voor Defensie"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/4e93e370-cc0c-427d-a90e-8688b0666bb9-01/Procedure/Identifier/702de10e-e5a9-4883-b3f6-d0f1498c680d> .

