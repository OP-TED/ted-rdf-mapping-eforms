  epo:hasDPSScope <http://publications.europa.eu/resource/authority/dps-usage/none> .

<http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/FrameworkAgreementTerm$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>
  a epo:FrameworkAgreementTerm;
  epo:hasBuyerCategoryDescription "All affiliates of the Contracting entity and all affiliates who are directly or indirectly controlled by Ørsted Services A/S. Ørsted establish new Affiliates on an ongoing basis. Any new Affiliate will also become a Contracting Entity under the Contract, as long as the new Affiliate’s activities are within the usual activities of the Ørsted which is to develops, constructs and operates offshore and onshore wind farms, solar farms, energy storage facilities, and bioenergy plants, and provides energy products to its customers."@en;
  epo:hasFrameworkAgreementType <http://publications.europa.eu/resource/authority/framework-agreement/fa-mix>;
  epo:hasMaximumParticipantsNumber 3 .

