<http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractDuration <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ContractDuration$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ContractPeriod$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasMaximumNumberOfRenewals 2;
  epo:hasOptionsDescription "Contract renewal"@en;
  epo:hasRenewalDescription """The Framework Agreement has a duration of 2 years. However, the contracting entity reserves the right to renew the framework agreement for a period of 12 months up to 2 times. As such, the total maximum duration of the framework agreement is 4 years. 
Please note, that the start date is only indicative and is subject to change. """@en;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no> .

<http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>
  a epo:ContractTerm;
  epo:definesSpecificPlaceOfPerformance <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ContractLocation$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1_Address1>;
  epo:hasBroadPlaceOfPerformance <http://publications.europa.eu/resource/authority/other-place-service/anyw-cou>;
  epo:hasPlaceOfPerformanceAdditionalInformation """The scope of Onshore Real Estate Legal Services covers all of the Republic of Ireland.
The estimated value of the Framework Agreement is EUR 2,400,000. The estimate is indicative, and the aggregated purchases made under the Framework Agreement may vary from the estimate. Unforeseen circumstances might occur if for instance new projects, strategic changes or new needs arise.
Therefore, the Contracting Entity has decided to also include a maximum value of EUR 3,240,000.
The above estimates and maximums do not preclude or change the Contracting Entity’s possibilities to make modifications to the Contract, cf. article 89 of the Utilities Directive.
"""@en .

<http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/DynamicPurchaseSystemTechnicalUsage$_ContractNotice1_ProcurementProjectLot1_TenderingProcess1>
