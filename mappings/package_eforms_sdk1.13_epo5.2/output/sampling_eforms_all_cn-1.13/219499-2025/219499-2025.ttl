  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasMainFeature "The tender is conducted pursuant to article 91 of the Utilities Directive. The tender will be conducted as an open procedure with possibility of negotiation. There will be awarded three framework agreements. The framework agreements will be awarded based on the award criterion best price to quality ratio. Tenderers who fulfill the minimum requirements and submit a tender may be invited for one or more rounds of negotiations. The procedure is further described in the Tender Conditions."@en;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-mult>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isSubjectToProcedureSpecificTerm <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/ProcedureTerm$_ContractNotice1_TenderingTerms1_ProcurementLegislationDocumentReference1>;
  dct:description """The Contracting Entity is issuing a tender for the provision of Orsted’s demand for Onshore Real Estate Legal Services in the Republic of Ireland. 
The Contracting Entity aims to establish a cascade with three (3) suppliers. Contracts under the framework agreement may be awarded partially with and without reopening of competition. 
The framework agreements will be entered into by Ørsted Services A/S, however, tenderers are advised that call-offs may be made by any company mentioned in Annex A."""@en;
  dct:title "Legal Services Ireland Lot 3 Onshore Real Estate"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/8f3c0598-7db6-4e22-b73a-84d9ebf2e2b9-01/Procedure/Identifier/a055e51e-5d34-450c-a8e7-047908c96950> .

