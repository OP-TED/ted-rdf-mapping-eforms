<http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Procedure/Identifier/d3bf2f0e-9f4d-431a-888b-3d08ad0ebac6>
  a adms:Identifier;
  skos:notation "d3bf2f0e-9f4d-431a-888b-3d08ad0ebac6" .

<http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Procedure/d3bf2f0e-9f4d-431a-888b-3d08ad0ebac6>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation """#Bekanntmachungs-ID: CXPWYYHLLW3#


Hinweis: Im Leistungsverzeichnis sollte hinter jeder Position ein Preis angegeben und nachvollziehbar sein. Nur die Angabe des Gesamtbetrags ist unzulässig. Änderung am Leistungsverzeichnis führen zum Ausschluss. Die Angebote der jeweiligen Lose nicht zusammenfügen als PDF.  -Sämtliche Vergabeunterlagen stellen wir über das Portal Vergabemarktplatz zur Verfügung und können geschlossen herunterladen werden.  -Bieterfragen werden unter Wahrung der Anonymität des Fragestellers über den Kommunikationsbereich des Verfahrens im o.g. Portal für alle Teilnehmer beantwortet und sind ausschließlich über diesen Kommunikationsweg einzureichen.  Ausführliche Informationen sowie Anleitungen zum Vergabemarktplatz und zur Elektronischen Angebotsabgabe über das Bietertool finden Sie im Service Support Center von Cosinex unter https://support.cosinex.de/ oder auf der Homepage Kreis Soest.  -Weitere hilfreiche Informationen zur Abgabe eines elektronischen Angebotes können Sie zudem aus dem gleichnamigen Dokument in den Vergabeunterlagen \"Sonstiges\" entnehmen.  -Das Nicht-Erfüllen von Eignungskriterien führt zum Ausschluss des Angebots  Es gelten die Auftragsbedingungen der Stadt Warstein"""@de;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Procedure/Identifier/25-261-81>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Das Vergabeverfahren wird als offenes Verfahren durchgeführt und ist in drei Lose unterteilt. Die Losaufteilung dient der Strukturierung des Leistungsgegenstands sowie der eindeutigen Beschreibung der einzelnen Leistungsbereiche.  Ungeachtet der Losaufteilung erfolgt die Zuschlagsentscheidung auf Grundlage des gesamtwirtschaftlich günstigsten Angebots.  Der Zuschlag wird pro Los einheitlich an einen Bieter erteilt.  Für jedes Los ist ein eigenständiges Angebot einzureichen. Die Angebote der einzelnen Lose werden nicht zusammengefügt und nicht zu einem Gesamtpreis addiert. Weitere Erklärungen in der Allgemein Beschreibung"@de;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Lot/LOT-0002>,
    <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Lot/LOT-0003>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/ProcedureTerm$_ContractNotice1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description "Die Straßenbaumaßnahme wird als Gemeinschaftsmaßnahme von der Stadt Warstein und dem  Landesbetrieb Straßenbau.NRW RNL Sauerland-Hochstift durchgeführt. Die Stadt Warstein wird als  Auftraggeber tätig und wickelt die Maßnahme im Bereich Bauüberwachung, Rechnungsprüfung und  Zahlung ab.   Folgende Schwerpunkte:  - Straßenbauarbeiten - Kanalbauarbeiten - Wasserleitung"@de;
  dct:title "Straßenbau B55 Warstein"@de;
  adms:identifier <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/Procedure/Identifier/d3bf2f0e-9f4d-431a-888b-3d08ad0ebac6> .

