  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/cf698721-eeda-42c7-b02f-cd93c5d5a172-01/ReviewProcedureInformationProvider/ORG-0003>;
