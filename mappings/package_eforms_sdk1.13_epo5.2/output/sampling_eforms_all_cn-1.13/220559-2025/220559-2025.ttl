  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/abcd30f4-958b-4bcc-baea-b91f5b74fdba-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>,
