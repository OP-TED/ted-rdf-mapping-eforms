  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/66340b9c-3d61-44fd-9b62-630f52cb443a-02/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/66340b9c-3d61-44fd-9b62-630f52cb443a-02/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "De uiterste datum voor aanmelding is met 1 dag verlengd i.v.m. Pasen. De uiterste datum en tijd is 22-04-2025, 10.00 uur."@nl;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/66340b9c-3d61-44fd-9b62-630f52cb443a-02/Procedure/Identifier/SV0058>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature """Deze vooraankondiging is een oproep tot mededinging in de procedure
voor sociale- en andere specifieke diensten voor de Opdracht Bedrijfsrestaurants en banqueting van de Politie. Geïnteresseerden
worden verzocht zich aan te melden vóór 21 april 2025, 10.00 uur voor
deelname aan de aanbestedingsprocedure. De aangemelde deelnemers
worden vervolgens uitgenodigd in het tweede kwartaal 2025 voor de
inschrijvingsfase. De uiterste datum (en tevens enige mogelijkheid) voor
aanmelden is 21-04-2025, 10.00 uur. Zie voor meer informatie de bijlage
Aanvullende informatie. In deze bijlage staat ook de
aanmeldingsprocedure beschreven."""@nl;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/66340b9c-3d61-44fd-9b62-630f52cb443a-02/Lot/LOT-0001>,
