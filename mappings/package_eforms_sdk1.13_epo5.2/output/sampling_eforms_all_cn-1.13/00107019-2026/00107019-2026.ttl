  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/d318ae2d-cd7f-4601-adf4-e2bfd520b3c2-01/ReviewProcedureInformationProvider/TPO-0001>;
