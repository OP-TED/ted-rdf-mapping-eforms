  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>,
    <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion3>,
    <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/AwardCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion4>,
    <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/ParticipationCondition$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest2>,
    <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement2>;
  dct:description """Kullerteenuse hankimine isikut tõendavate dokumentide väljastamiseks. 

Kontsessioonilepingu ese ja selle tehnilised tingimused on täpsemalt kirjeldatud tehnilises kirjelduses „Lisa 1- Tehniline kirjeldus“, mis on kinnitatud AvTS § 35 lg 1 p 10 alusel asutusesiseseks kasutamiseks. Tehniline kirjeldus koos pakkumuse esitamise ettepanekuga (edaspidi PEE) väljastatakse ainult nendele allkirjastatud konfidentsiaalsusdeklaratsiooni esitanud taotlejatele, kes on riigihankes jäetud kõrvaldamata.

Hankija on riigihangete registris märkinud eeldatava lepingu algusaja. / Kõrvaldamise alused ja kvalifitseerimistingimused: Vaata hanke alusdokumentidest"""@et;
  dct:title "Kullerteenuse hankimine isikut tõendavate dokumentide väljastamiseks"@et;
  adms:identifier <http://data.europa.eu/a4g/resource/93675b83-319b-4138-8f96-0ebef988edbb-01/Identifier/LOT-0000> .

