  dct:description "Nachweis über erfüllte Beitragspflichten zur Sozialversicherung (Auf Anforderung der Vergabestelle; Mittels Dritterklärung):"@de .

<http://data.europa.eu/a4g/resource/9ffee129-f36d-49d7-a337-18ba051428c0-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot31_TenderingTerms1_TendererQualificationRequest4_SpecificTendererRequirement1>
  a epo:SelectionCriterion;
  epo:hasQualificationCriteriaStatedInNotice true .

<http://data.europa.eu/a4g/resource/9ffee129-f36d-49d7-a337-18ba051428c0-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot31_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>
  a epo:SelectionCriterion;
