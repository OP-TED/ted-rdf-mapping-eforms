    <http://data.europa.eu/a4g/resource/978a0048-d385-4d93-831c-ff0fa104f80f-03/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot4_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/978a0048-d385-4d93-831c-ff0fa104f80f-03/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot4_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/978a0048-d385-4d93-831c-ff0fa104f80f-03/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot4_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
