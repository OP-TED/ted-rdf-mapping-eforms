<http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/Procedure/41474433-f248-4656-afbd-d4921726f651>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description "Поръчката има за цел да бъдат избрани финансови посредници (ФП), които да изпълнят финансов инструмент „Микрокредитиране със споделен риск“ по ОПРЧР 2014 – 2020 г., финансиран със средства от ЕСИФ (ФИ). ФИ има за цел да подобри достъпа до фин-не за създаване и развитие на стартиращи пред-тия, включително на лица от опред. уязвими групи и на соц. пред-тия, както и да привлече допълн. частен капитал, насочен към постигане на публ-те политики в сферата на заетостта. Общият бюджет на ФИ възлиза на 50 млн лв., разпределен в 13 ОП. Минимум 10% от бюджета на ФИ, изпълняван от всеки ФП, следва да подкрепи предоставянето на Микрок-ти на допустими КП Група А, Инициатива за младежка заетост (ИМЗ). Възл-ят ще предоставя договорените средства към съответният ФП на 4 равни по размер Транша в „Сметка за усвояване“ до края на Периода на инвест-не, по ред и при условия, определени в док. за участие (ДУ).Предоставеният фин. ресурс може да бъде инвестиран и след периода на допустимост съгласно ДУ."@bg;
  dct:title "\"Изпълнение на финансов инструмент за микрокредитиране със споделен риск, финансиран със средства по Оперативна програма „Развитие на човешките ресурси“ 2014-2020, разделена на 13 обособени позиции\""@bg;
  adms:identifier <http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/Procedure/Identifier/41474433-f248-4656-afbd-d4921726f651> .

<http://data.europa.eu/a4g/resource/c1835b9c-c9ad-4efb-bcac-2f9eca53876f-01/Procedure/Identifier/41474433-f248-4656-afbd-d4921726f651>
