  epo:hasAdditionalInformation """The procurement is funded by the following EU programme: Instrument for Pre-accession Assistance.
"""@en;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/MonetaryValueLot$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/Lot/Identifier/EC-ENEST%2FSKP%2F2025%2FEA-RP%2F0015>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds true;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion2>;
  dct:description """The objective of this Contract is to provide a contractual tool that can mobilise rapidly through non-key experts the expertise required to assist the Ministry of Environment and Physical Planning in filling in legislative gaps and developing the necessary acts and tools for implementing environmental policies.
The overall objective is to support North Macedonia to align the national environment and climate change system with the EU acquis, and to ensure its implementation and enforcement in line with the national strategies and the international commitments of the country. The legal harmonisation will be accompanied by measures to strengthen the institutional capacities.
The action will prepare national strategic documents, will fill in gaps that still exist in the overall environment legal system of the country, and will prepare associated specific implementation plans. These activities will contribute and support the environmental authorities throughout the upcoming post-screening process and create a good basis for negotiations under Chapter 27."""@en;
  dct:title "Further support to North Macedonia for compliance with Chapter 27 requirements"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/Identifier/LOT-0001> .

