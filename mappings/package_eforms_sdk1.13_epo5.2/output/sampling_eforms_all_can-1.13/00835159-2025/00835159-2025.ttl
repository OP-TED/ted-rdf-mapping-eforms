<http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/Procedure/15cbe097-1ef0-44d3-b298-6d029b358187>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/Procedure/Identifier/EC-ENEST%2FSKP%2F2025%2FEA-RP%2F0015>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32024R2509>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  dct:description """The objective of this Contract is to provide a contractual tool that can mobilise rapidly through non-key experts the expertise required to assist the Ministry of Environment and Physical Planning in filling in legislative gaps and developing the necessary acts and tools for implementing environmental policies.
The overall objective is to support North Macedonia to align the national environment and climate change system with the EU acquis, and to ensure its implementation and enforcement in line with the national strategies and the international commitments of the country. The legal harmonisation will be accompanied by measures to strengthen the institutional capacities.
The action will prepare national strategic documents, will fill in gaps that still exist in the overall environment legal system of the country, and will prepare associated specific implementation plans. These activities will contribute and support the environmental authorities throughout the upcoming post-screening process and create a good basis for negotiations under Chapter 27."""@en;
  dct:title "Further support to North Macedonia for compliance with Chapter 27 requirements"@en;
