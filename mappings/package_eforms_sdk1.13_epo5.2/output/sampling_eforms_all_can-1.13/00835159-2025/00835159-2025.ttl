  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a42c608c-3090-4cdf-886c-de9c1e3f3bd4-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
