  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/23ebf635-c4ee-4230-a47e-9f63bfcefa0b-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
