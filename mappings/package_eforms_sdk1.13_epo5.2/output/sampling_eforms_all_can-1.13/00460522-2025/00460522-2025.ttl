<http://data.europa.eu/a4g/resource/99a3be44-33e1-40bb-a321-636e4547f11a-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/99a3be44-33e1-40bb-a321-636e4547f11a-01/ReviewProcedureInformationProvider/ORG-0002>;
