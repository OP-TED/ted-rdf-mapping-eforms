<http://data.europa.eu/a4g/resource/58b5afc0-3179-479b-bda0-803c1fb331f2-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>
  a epo:AwardCriterion;
  epo:hasAwardCriterionType <http://publications.europa.eu/resource/authority/award-criterion-type/price>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/poi-exa>;
