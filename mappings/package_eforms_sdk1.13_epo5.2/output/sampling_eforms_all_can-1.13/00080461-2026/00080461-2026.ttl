  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/a03a0d06-3776-4ab0-8e8c-08c9ad397ba0-01/Procedure/Identifier/cmhvzpxz40000ih04evt8eiyw>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
