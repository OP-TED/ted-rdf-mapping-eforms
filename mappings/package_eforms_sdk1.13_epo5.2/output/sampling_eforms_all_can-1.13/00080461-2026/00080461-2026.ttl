  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/a03a0d06-3776-4ab0-8e8c-08c9ad397ba0-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
