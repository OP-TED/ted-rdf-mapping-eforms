  epo:hasAdditionalInformation "La société nationale SNCF émet cet avis de marché au nom et pour le compte de la société SNCF Gares & Connexions."@fr;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f30885dc-8bbe-4709-af2d-a146edcdbea8-01/Procedure/Identifier/2024DOS0559248>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/f30885dc-8bbe-4709-af2d-a146edcdbea8-01/Lot/LOT-0001>,
