    <http://data.europa.eu/a4g/resource/7b3d455b-bad9-4ac2-94ca-70ab2abef14a-03/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/7b3d455b-bad9-4ac2-94ca-70ab2abef14a-03/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/7b3d455b-bad9-4ac2-94ca-70ab2abef14a-03/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
