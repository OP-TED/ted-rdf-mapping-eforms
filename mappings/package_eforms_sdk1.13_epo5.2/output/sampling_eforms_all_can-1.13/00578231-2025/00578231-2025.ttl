  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/29e39623-cb1b-490f-8b4e-ca07da8ceb3c-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/29e39623-cb1b-490f-8b4e-ca07da8ceb3c-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
