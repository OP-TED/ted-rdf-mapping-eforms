    <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/StrategicProcurement$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:hasAdditionalInformation """Срокът за доставката и регистрация в КАТ на двата автомобила е до 149 (с думи сточетиридесет) календарни дни, считано от датата на подписване на настоящия Договор.
Гаранционният срок на всеки от автомобилите е 72 (с думи: седемдесет и два) месеца или експлоатационен пробег 150 000 /но не по-малко от 100 000/ км. пробег."""@bg;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/Lot/Identifier/503024>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA false;
  epo:isRecurrent false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  dct:description """За Обособена позиция № 1: доставените 2 (два) броя леки автомобили следва да са: 100% електрически или Plugin hybrid с Екологична норма минимум ЕВРО 6 или еквивалент, фабрично нови автомобили, от една марка и модел, произведени от един производител. Изпълнението на поръчката включва доставка, гаранционен срок, сервизно обслужване, предвидено от производителя за периода на гаранцията, и регистрация в КАТ.
Пълното описание на изискванията на възложителя е посочено в Техническата спецификация - Приложение № 1.1 към документацията за обществената поръчка."""@bg;
  dct:title "„Доставка и гаранционно (сервизно) обслужване на 2 (два) броя леки автомобили с 100% електрически или Plugin hybrid задвижване за нуждите на НЗОК“"@bg;
  adms:identifier <http://data.europa.eu/a4g/resource/a9e42bfd-2cca-4385-9453-6d9ef3f500ae-01/Identifier/LOT-0001> .

