  epo:fulfillsStrategicProcurement <http://data.europa.eu/a4g/resource/31efc07c-5d63-4ce7-bd8f-4f5b6b1cccd7-04/GreenProcurement$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_StrategicProcurement1>,
    <http://data.europa.eu/a4g/resource/31efc07c-5d63-4ce7-bd8f-4f5b6b1cccd7-04/GreenProcurement$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_StrategicProcurement2>;
  epo:hasAdditionalInformation "Ajánlatok értékelése: a Kbt. 76. § (2) bekezdés c) pont szerint legjobb ár-érték arány értékelési szempont szerint. Minőségi kritérium: Az 1. minőségi kritériumban, annak mind a 4 alszempontjában Ajánlatkérő a részvételi felhívás III.1.3. M2.) pontban meghatározott szakemberek jogosultságának, a jogosultság megszerzéséhez szükséges szakmai gyakorlaton felüli, szakirányú tervezésben szerzett összesített többlettapasztalatát értékeli. - Relatív értékelés, egyenes arányosítással. Ár kritérium: relatív értékelés, fordított arányosítással. Ponttartomány: 0-100 pont minden részszempontban, részletek közbeszerzési dokumentumban."@hu;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/31efc07c-5d63-4ce7-bd8f-4f5b6b1cccd7-04/Lot/Identifier/EKR002010122022%2F1>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/31efc07c-5d63-4ce7-bd8f-4f5b6b1cccd7-04/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/31efc07c-5d63-4ce7-bd8f-4f5b6b1cccd7-04/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
