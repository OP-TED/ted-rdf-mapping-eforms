  epo:isAccelerated false;
  dct:description "Réalisation de visites de type Vi sur hélicoptère Tigre et prestations connexes sur le site de l'Atelier Industriel de l'Aéronautique (AIA) de Clermont-Ferrand"@fr;
  dct:title "Réalisation de visites de type Vi sur hélicoptère Tigre et prestations connexes sur le site de l'Atelier Industriel de l'Aéronautique (AIA) de Clermont-Ferrand"@fr;
