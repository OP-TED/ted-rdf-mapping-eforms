<http://data.europa.eu/a4g/resource/ee758cbc-dd56-4ff3-8c2c-219d759ddf4b-01/Procedure/4031e2ee-c267-4bcd-a4a0-f45cb1bddc54>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/ee758cbc-dd56-4ff3-8c2c-219d759ddf4b-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/ee758cbc-dd56-4ff3-8c2c-219d759ddf4b-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/ee758cbc-dd56-4ff3-8c2c-219d759ddf4b-01/Procedure/Identifier/24091STF0000>;
  epo:hasLaunchFrameworkAgreementMaximumValue <http://data.europa.eu/a4g/resource/ee758cbc-dd56-4ff3-8c2c-219d759ddf4b-01/ProcedureValueEstimateExtension$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32009L0081>;
  epo:hasMainFeature """Les travaux consistent à réaliser l'ensemble des opérations de maintenance d'une visite Vi ou MIP sur hélicoptère Tigre en incluant l'entretien des moteurs et du canon.
Par défaut la prestation s'entend à partir de l’entrée en atelier après sécurisation jusqu'à la fin des opérations réalisées à l'atelier. Sont donc exclues la phase d'arrivée de l'hélicoptère
à l'AIA CF et la phase de mise au point Sol et Vol. En complément, l'AIA CF peut commander la réalisation par le titulaire des travaux de mise au point consistant notamment à exécuter les opérations de préparation et de retour de vol ainsi que les dépannages (hors garantie) et retouches associés.
Des travaux connexes peuvent également être commandés : inspection Vi d'un moteur, assistance technique (définition du dossier industriel), mise à jour documentaire, formation sur site, etc..."""@fr;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/ee758cbc-dd56-4ff3-8c2c-219d759ddf4b-01/Lot/LOT-0001>;
