  epo:isCoveredByGPA true;
  epo:isRecurrent false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/1287c30a-9a6f-4149-82b1-f914bb885fc6-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/1287c30a-9a6f-4149-82b1-f914bb885fc6-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/1287c30a-9a6f-4149-82b1-f914bb885fc6-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
  epo:isUsingEUFunds false;
  dct:description """Rijkswaterstaat is voornemens om op korte termijn een Europese Niet Openbare Aanbesteding te houden aan de hand van BvA, voor wat betreft het uitvoeren van integraal onderzoek om de Hoofdvaarweg Lemmer Delfzijl (HLD) functioneel en technisch op orde te brengen. Met name zal er onderzoek moeten worden gehouden met betrekking tot vervangingsopgaven en optimalisaties.

De opdracht betreft onder andere het doen van onderzoeken en leveren van een afweging en een Voorkeursalternatief per locatie waarbij rekening is gehouden met het afwegingskader waarin oa opgenomen:
• Ruimtelijke haalbaarheid (Inpassing, bodem, archeologie, etc.)
• Technische haalbaarheid (nautisch, verkeerskundig, etc.)
• Financiële haalbaarheid (LCC, MKI, investeringskosten etc.)
• Juridische haalbaarheid (planologische procedures, MER, etc.)
• Maatschappelijke haalbaarheid (draagvlak, meekoppelkansen etc.) ."""@nl;
  dct:title "Planuitwerking V&R HLD Trance 4&5"@nl;
  adms:identifier <http://data.europa.eu/a4g/resource/1287c30a-9a6f-4149-82b1-f914bb885fc6-01/Identifier/LOT-0000> .

