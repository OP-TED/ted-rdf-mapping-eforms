  epo:hasAdditionalInformation """Hankija ei pea mõistlikuks jagada hanget sõidukite ja ümberehituse osadeks, sest sellisel juhul peab Hankija hakkama korraldama aeganõudvaid protsesse.
Liiati on keeruline tagada tulemuslikku komplekssusastet"""@et;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/b532dd20-4f1a-44a7-b567-98a4c78a6982-01/MonetaryValueLot$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/b532dd20-4f1a-44a7-b567-98a4c78a6982-01/Lot/Identifier/299500-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/b532dd20-4f1a-44a7-b567-98a4c78a6982-01/LotPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/b532dd20-4f1a-44a7-b567-98a4c78a6982-01/AccessTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/b532dd20-4f1a-44a7-b567-98a4c78a6982-01/AccessTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms110109030>,
