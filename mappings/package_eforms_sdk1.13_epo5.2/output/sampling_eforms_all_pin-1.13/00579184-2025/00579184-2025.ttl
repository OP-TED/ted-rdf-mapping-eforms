  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/b532dd20-4f1a-44a7-b567-98a4c78a6982-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
