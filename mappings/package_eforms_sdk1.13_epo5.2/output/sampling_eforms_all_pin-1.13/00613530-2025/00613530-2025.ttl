  epo:hasESubmissionPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasGuaranteeDescription "1) Sicherheit für die Vertragserfüllung ist in Höhe von 5 % der Brutto-Auftragssumme (ohne Nachträge) zu leisten, sofern die Auftragssumme mindestens 250.000 EUR ohne Umsatzsteuer beträgt; 2) Für Mängelansprüche ist eine Sicherheit in Höhe von 5 % der Summe der Abschlagszahlungen zum Zeitpunkt der Abnahme vorzulegen."@de;
  epo:hasLanguage <http://publications.europa.eu/resource/authority/language/DEU>;
  epo:hasLateSubmissionInformationDescription "Die Unterlagen werden gemäß § 51 Abs. 2 SektVO nachgefordert."@de;
  epo:hasLateSubmissionPermission <http://publications.europa.eu/resource/authority/missing-info-submission/late-all>;
  epo:hasSubmissionURL "https://www.dtvp.de/Satellite/notice/CXP4D6B5MS8"^^xsd:anyURI;
  epo:hasTenderValidityDuration <http://data.europa.eu/a4g/resource/12751644-1eef-4fdc-8855-c11bfdf17f6f-01/SpecificDuration$_PriorInformationNotice1_ProcurementProjectLot9_TenderingTerms1_TenderValidityPeriod1>;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:isGuaranteeRequired true;
  epo:isMultipleTenderSubmissionAllowed true .

