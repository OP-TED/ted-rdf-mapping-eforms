<http://data.europa.eu/a4g/resource/12751644-1eef-4fdc-8855-c11bfdf17f6f-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot2_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>
  a epo:SelectionCriterion;
