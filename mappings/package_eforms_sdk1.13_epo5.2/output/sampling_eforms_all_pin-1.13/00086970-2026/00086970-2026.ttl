    <http://data.europa.eu/a4g/resource/ebadfe15-f665-4994-8ab7-7654ad66ee58-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest2_SpecificTendererRequirement1>,
    <http://data.europa.eu/a4g/resource/ebadfe15-f665-4994-8ab7-7654ad66ee58-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest2_SpecificTendererRequirement2>;
