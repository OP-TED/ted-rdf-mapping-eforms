<http://data.europa.eu/a4g/resource/7855d594-06e7-4dc4-b21b-ced439e1d657-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
