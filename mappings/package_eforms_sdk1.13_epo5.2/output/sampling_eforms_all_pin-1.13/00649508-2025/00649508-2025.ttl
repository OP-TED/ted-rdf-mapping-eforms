  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/7855d594-06e7-4dc4-b21b-ced439e1d657-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/7855d594-06e7-4dc4-b21b-ced439e1d657-01/Lot/LOT-0002>;
