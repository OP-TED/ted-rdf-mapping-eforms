<http://data.europa.eu/a4g/resource/73269587-d2fa-42cf-804a-60b98fe55c75-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/73269587-d2fa-42cf-804a-60b98fe55c75-01/ReviewProcedureInformationProvider/ORG-0002>;
