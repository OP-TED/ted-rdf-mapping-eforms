<http://data.europa.eu/a4g/resource/62901357-824a-4fb2-b4ab-2b4eef646010-01/SocialProcurement$_PriorInformationNotice1_ProcurementProjectLot2_ProcurementProject1>
  a epo:SocialProcurement;
  epo:includesAccessibilityCriterion <http://publications.europa.eu/resource/authority/accessibility/inc> .

<http://data.europa.eu/a4g/resource/62901357-824a-4fb2-b4ab-2b4eef646010-01/SocialProcurement$_PriorInformationNotice1_ProcurementProjectLot2_ProcurementProject1_ProcurementAdditionalType9>
  a epo:SocialProcurement;
  epo:fulfillsRequirement <http://publications.europa.eu/resource/authority/social-objective/gen-eq> .

<http://data.europa.eu/a4g/resource/62901357-824a-4fb2-b4ab-2b4eef646010-01/SocialProcurement$_PriorInformationNotice1_ProcurementProjectLot3_ProcurementProject1>
