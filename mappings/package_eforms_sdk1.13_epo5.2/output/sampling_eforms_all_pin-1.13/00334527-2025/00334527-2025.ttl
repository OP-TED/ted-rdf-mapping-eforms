  epo:hasSubmissionURL "https://app.eop.bg/today/494674"^^xsd:anyURI;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
  epo:isAdvancedElectronicSignatureRequired true;
  epo:isGuaranteeRequired true .

