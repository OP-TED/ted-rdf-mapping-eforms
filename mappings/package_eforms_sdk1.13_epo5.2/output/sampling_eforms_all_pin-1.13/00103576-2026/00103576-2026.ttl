  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering true;
  epo:hasEPayment true;
  epo:hasMaximumNumberOfRenewals 1;
  epo:hasOptionsDescription "Prodloužení smlouvy."@cs;
  epo:hasPaymentArrangement "Finanční prostředky vyčleněné na všechny objednávky učiněné v průběhu plnění předmětu této dohody nesmí překročit celkovou částku 90.000.000,- Kč bez DPH (slovy: devedasát miliónů korun českých). K ceně bude připočtena zákonná sazba DPH. Plnění poskytnuté objednateli na základě dílčí smlouvy poskytovatelé vyúčtují objednateli formou faktury, jež musí obsahovat veškeré náležitosti daňového dokladu dle zákona č. 563/1991 Sb., o účetnictví, ve znění pozdějších předpisů, zákona č. 235/2004 Sb., o dani z přidané hodnoty, ve znění pozdějších předpisů, a § 435 občanského zákoníku. Na faktuře bude vždy uvedeno číslo dílčí smlouvy, ke které se faktura vztahuje. Splatnost faktury činí 30 dnů od jejího doručení objednateli. Faktura bude zaslána elektronicky. "@cs;
  epo:hasRenewalDescription "Smluvní strany jsou oprávněny v případě nevyčerpání finančních prostředků před koncem účinnosti rámcovou, dohodu vzešlou ze zadávacího řízení, dodatkem prodloužit, a to nejvýše o 24 měsíců."@cs;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

<http://data.europa.eu/a4g/resource/ebd3de18-6e27-4a9e-bbc1-bd98ab2a23c7-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>
