<http://data.europa.eu/a4g/resource/ebd3de18-6e27-4a9e-bbc1-bd98ab2a23c7-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/ebd3de18-6e27-4a9e-bbc1-bd98ab2a23c7-01/Interval$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:definesEstimatedContractDuration <http://data.europa.eu/a4g/resource/ebd3de18-6e27-4a9e-bbc1-bd98ab2a23c7-01/ContractDuration$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
