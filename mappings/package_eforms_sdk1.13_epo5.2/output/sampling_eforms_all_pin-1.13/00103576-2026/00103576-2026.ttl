  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/ebd3de18-6e27-4a9e-bbc1-bd98ab2a23c7-01/ReviewProcedureInformationProvider/ORG-0002>;
