  epo:hasFixedValue 90000000.0;
  epo:hasFixedValueType <http://publications.europa.eu/resource/authority/number-fixed/fix-tot>;
  epo:hasWeightValueType <http://publications.europa.eu/resource/authority/number-weight/per-exa>;
  cccev:weight 70.0;
  dct:description """Účastník uvede konference, které byly realizovány členy týmu, kterými dodavatel zaštiťuje realizace konferencí pro zadavatele.
Účastník je oprávněn uvést výhradně člena týmu, který realizoval nejméně tři minimálně dvoudenní konference pro nejméně 100 účastníků. Jedná se o maximalizační, číselně vyjádřitelné kritérium."""@cs;
  skos:prefLabel "Zkušenost členů týmu – průměr na jednoho člena týmu "@cs .

