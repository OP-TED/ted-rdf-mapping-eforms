<http://data.europa.eu/a4g/resource/2bb607ed-fe85-4407-afc4-bb17950be19a-01/Procedure/0000000-0000-4000-8000-000000000000>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/2bb607ed-fe85-4407-afc4-bb17950be19a-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>,
