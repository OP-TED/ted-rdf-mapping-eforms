<http://data.europa.eu/a4g/resource/2bb607ed-fe85-4407-afc4-bb17950be19a-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/2bb607ed-fe85-4407-afc4-bb17950be19a-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
