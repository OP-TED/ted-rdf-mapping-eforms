  epo:isCoveredByGPA true;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/2b8c3b1b-2bc6-4318-bb24-a1a0bbf64871-01/AwardEvaluationTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1>,
    <http://data.europa.eu/a4g/resource/2b8c3b1b-2bc6-4318-bb24-a1a0bbf64871-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/2b8c3b1b-2bc6-4318-bb24-a1a0bbf64871-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>;
