<http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/Procedure/1dcc9cdb-0879-4113-baf7-3556ed4e6ea7>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/Procedure/Identifier/Master%20planning%20Tender%20>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/Lot/LOT-0001>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/c3dec20c-3b68-4677-b4a6-823cb8ff8be5-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  dct:description """Trinity College Dublin, the University of Dublin is seeking a masterplan to provide the tools and information to help it plan for the future in terms of how the University can fundamentally and systematically improve the internal and external spaces on the University's Estate for the benefit of the University community. 
Trinity is seeking a 'retrofit-first' approach that gives structurally sound buildings a second life, as already demonstrated by our recently completed Rubrics Building. This will require a step change from both the University and construction professionals and therefore Trinity is keen to work with those who share similar ambitions. 
An immediate challenge will be how Trinity addresses the under-utilisation of significant proportions of the Estate. The Higher Education Authority (HEA) now requires all Third-Level institutions to undertake twice-yearly space audits. These audits will provide valuable feedback and input to inform recommendations to improve utilisation. 
There are other considerations including the imperative to solidify lasting post-pandemic trends in education and the workplace. Given their dynamic nature, establishing a permanent strategy to harness the benefits of flexible/blended work and study is crucial when assessing its impact on the overall estate. 
The scope of the study extends to the main University campus and the satellite sites, although the latter will not necessarily be as involved as the Main University campus, due to the respective scale of these areas. 
The Scope of Services document included in the Invitation to Tender pack provides further details in relation to this appointment and the requirements of Trinity.       
"""@en;
  dct:title "Single-Party Framework Agreement for Masterplanning Consultancy Services for Trinity College Dublin"@en;
