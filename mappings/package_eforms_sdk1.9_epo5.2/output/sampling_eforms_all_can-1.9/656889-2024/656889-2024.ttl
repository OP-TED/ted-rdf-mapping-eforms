  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/96ae19b5-1c83-42f5-b250-9383ea275438-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation """Taotluste esitamise etapis (I etapp) hankelepingu eset ei avalikustata, kuna see on määratud asutusesiseseks kasutamiseks 16.01.2024 terviseministri kirjaga meditsiiniseadmete varu moodustamise kohta.
Kõigile kvalifitseeritud Taotlejatele saadetakse hanke II etapis peale konfidentsiaalsuslepingu sõlmimist koos pakkumuse esitamise ettepanekuga täielik tehniline kirjeldus (meditsiiniseadmete nimekiri ja kogused)."""@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/96ae19b5-1c83-42f5-b250-9383ea275438-01/Procedure/Identifier/277762>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32009L0081>;
  epo:hasMainFeature "Piiratud hankemenetlus"@et;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/restricted>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/96ae19b5-1c83-42f5-b250-9383ea275438-01/Lot/LOT-0001>;
