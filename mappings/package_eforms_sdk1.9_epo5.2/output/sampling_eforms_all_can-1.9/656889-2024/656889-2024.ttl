  a epo:NonPublishedInformation;
  epo:concernsMaskedObject <http://data.europa.eu/a4g/resource/96ae19b5-1c83-42f5-b250-9383ea275438-01/MaximumFrameworkAgreementAwardedMonetaryValueLot$_ContractAwardNotice1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_NoticeResult1>;
  epo:concernsNotice <http://data.europa.eu/a4g/resource/96ae19b5-1c83-42f5-b250-9383ea275438-01/Notice>;
  epo:hasAccessibilityDate "2034-10-27+03:00"^^xsd:date;
  epo:hasConfidentialityJustification """Hankija sõlmitavates meditsiiniseadmete delegeeritud varu lepingutes on kriitiliseks aspektiks lepingupartnerite asukohtade avalikuks tulemine ning seeläbi riigi tegevusvarude kaitstuse ja riigi varustuskindluse tagamine kriisiolukordades.
Riigi varude kaitse ning selle kaudu varustuskindluse tagamise strateegia on riigi oluliste julgeolekuhuvide vastane teave ning varustuskindlusest lähtuvaid julgeolekuhuve ei saa tagada vähem sekkuvate meetmetega, kui taotlejate ja pakkujate andmete (sh nende asukohtade) mitteavalikustamine.
Hankija on teabevaldajana avaliku teabe seaduse (AvTS) mõistes kohustatud tunnistama asutusesiseseks kasutamiseks mõeldud teabeks teabe riigikaitseülesannete täitmiseks ja hädaolukorra tagajärgede leevendamiseks vajaliku varu suuruse ja vahendite koguse kohta ning selle kasutusele võtmise ulatuse ja tingimuste kohta (AvTS § 35 lg 1 p 62)."""@et;
  epo:hasMaskableProperty epo:hasAmountValue;
  epo:hasNonPublicationJustification <http://publications.europa.eu/resource/authority/non-publication-justification/oth-int> .

