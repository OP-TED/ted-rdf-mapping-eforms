  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/3fe9ae0c-14dd-48e7-ad5c-2fdbccf5e1de-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
