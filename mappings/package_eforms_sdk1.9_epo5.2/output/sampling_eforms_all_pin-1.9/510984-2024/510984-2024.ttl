<http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/Interval$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:definesEstimatedContractDuration <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/EstimatedDuration$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/services>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering false;
  epo:hasEPayment true;
  epo:hasPaymentArrangement "Leping jõustub allkirjastamisest ning kehtib 24 kuud jõustumisest arvates või kuni lepingu maksimaalse maksumuse täitumiseni (kohaldub esimene täituv tingimus)."@et;
  epo:hasPerformanceConditions """Raamlepingu punkt 10 kohaselt:

1. Leping jõustub allkirjastamisest ning kehtib 24 kuud jõustumisest arvates või kuni lepingu maksimaalse maksumuse täitumiseni (kohaldub esimene täituv tingimus).

2. Lisaks riigihangete seaduses sätestatule, on tellijal õigus raamlepingut muuta järgmistel tingimustel:
1) lepingu perioodi samaväärsetel tingimustel pikendada kuni 10 kuu võrra, 
2) suurendada raamlepingu rahalist mahtu kuni 30% võrra.
3) Punktides 10.2.1 ja 10.2.2 sätestatud muudatusi on tellijal õigus rakendada nii eraldi kui koos. 
4) Raamlepingu muutmise õiguse rakendamisest teavitab tellija täitjat ette vähemalt 1 kuu."""@et;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no> .

