<http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/Procedure/Identifier/aacbda93-d27f-41ef-bc6c-b660d48e7779>
  a adms:Identifier;
  skos:notation "aacbda93-d27f-41ef-bc6c-b660d48e7779" .

<http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/Procedure/aacbda93-d27f-41ef-bc6c-b660d48e7779>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "Riigihange ei ole ühe menetluse raames osadeks jaotatud, sest hankelepingu esemeks on funktsionaalselt koos toimivad ja sama eesmärgi saavutamiseks vajalikud teenused. Võttes aluseks hanke eseme ühetaolisust ja omavahelist seotust (iga sündmus on omaette spetsiifiline tervik) ei ole teenuste jagamine osadeks tehniliselt mõistlik, sest moodustab ühtse terviku. Teenuste liikide tellimine eraldi hangetena ei ole ka majanduslikult otstarbekas, sest iga teenuse komponendi eraldi tellimine toob kaasa kõrgemad hinnad."@et;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/MonetaryValueProcedure$_PriorInformationNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/Procedure/Identifier/276223>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasMainFeature "Sotsiaal- ja eriteenuste erimenetlus"@et;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/ProcedureTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/ExclusionGround$_PriorInformationNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description "Hanke esemeks on sündmusturundusteenuse tellimine (sh ideed ja teostus vastavalt igakordsele tellimusele), sh vajadusel hübriid- ja veebisündmused. Igal aastal korraldab RMK (edaspidi „Hankija“) tavapäraselt sündmusi ja üritusi töötajatele, klientidele, partneritele ja laiemale avalikkusele (sh sündmused klientidele alates 15 inimesest, RMK-sisesed 50-800 inimest ning laiemale avalikkusele suunatud kuni 5000 inimest). Sündmused on mõeldud näiteks teenuste (RMK matkarajad, konverentsid, loodushariduse võimalused, RMK külastuskeskused, valminud objektide avaüritused, looduskaitsevaldkonna teavitussündmused jne) tutvustamiseks, klientide ja/või töötajate rahulolu tõstmiseks, partnerite ja klientide tänamiseks jms ning need võivad toimuda samaaegselt, erineva või sarnase formaadiga üle Eesti."@et;
  dct:title "Sündmusturundusteenus"@et;
  adms:identifier <http://data.europa.eu/a4g/resource/0d82aa10-6d34-494a-b58a-5111452713f7-01/Procedure/Identifier/aacbda93-d27f-41ef-bc6c-b660d48e7779> .

