  a epo:Lot;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/0a1f4029-1eae-4530-bd5f-3f49735b5990-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>,
