  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/058f55a1-4424-4ec3-a649-460e7891a311-01/ContractPeriod$_PriorInformationNotice1_ProcurementProjectLot2_ProcurementProject1_PlannedPeriod1>;
