    <http://data.europa.eu/a4g/resource/199ba69f-0d2a-454a-8142-ace565912bbc-01/ReviewTerm$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/199ba69f-0d2a-454a-8142-ace565912bbc-01/SubmissionTerm$_PriorInformationNotice1_ProcurementProjectLot1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/199ba69f-0d2a-454a-8142-ace565912bbc-01/ParticipationCondition$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1>,
    <http://data.europa.eu/a4g/resource/199ba69f-0d2a-454a-8142-ace565912bbc-01/SelectionCriterion$_PriorInformationNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>;
  dct:description """The project will provide a cycle and pedestrian corridor between to two towns of Bundoran and Ballyshannon which will be reserved exclusively for non-motorised journeys, enhancing both the environment and the quality of life of the surrounding area. 
This proposed scheme will be located on the northern side of the R267 consist of 3m wide shared cycle and pedestrian route commencing 50m west of the Bundoran Roundabout travelling East along a 3.5km rural route. On the approach to Ballyshannon at the speed limits the shared area separates into a 2m wide pedestrian walkway and the 3m wide 2-way cycle track to the Ballyshannon roundabout. Total Scheme is Approximately 5km in Length.
"""@en;
  dct:title "Bundoran - Ballyshannon Active Travel Scheme"@en;
  adms:identifier <http://data.europa.eu/a4g/resource/199ba69f-0d2a-454a-8142-ace565912bbc-01/Identifier/LOT-0001> .

