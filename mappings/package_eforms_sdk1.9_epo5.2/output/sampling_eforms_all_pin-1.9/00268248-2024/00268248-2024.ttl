<http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/PlannedProcurement$_PriorInformationNotice1_ProcurementProject1>
  a epo:PlannedProcurement;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/ProcurementProjectContractTerm$_PriorInformationNotice1_ProcurementProject1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/ProcedurePurpose$_PriorInformationNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/ProcessPlanningTerm$_PriorInformationNotice1_PlannedDate1>;
  dct:description "Development of a primary care centre on the tenderer’s land or within the tenderers building to be leased to the Health Service Executive (“HSE”). The HSE is initiating this tender competition in order to identify an economic operator with suitable lands or a suitable building and the capability to develop a primary care centre to HSE specifications on such lands or within such building and lease it to the HSE, including a future option for HSE to buy the primary care centre. It is anticipated that that term of the lease will be between 25 and 30 years from the completion of the primary care centre. The HSE will require an area of between 1150 and 1447 square metres. The building is also to accommodate, separately, a minimum of two GP’s with a GMS list to be brought in under terms agreed between the landlord and the GP for the duration of the lease. "@en,
    "Development of a primary care centre on the tenderer’s land or within the tenderers building to be leased to the Health Service Executive (“HSE”). The HSE is initiating this tender competition in order to identify an economic operator with suitable lands or a suitable building and the capability to develop a primary care centre to HSE specifications on such lands or within such building and lease it to the HSE, including a future option for HSE to buy the primary care centre. It is anticipated that that term of the lease will be between 25 and 30 years from the completion of the primary care centre. The HSE will require an area of between 1150 and 1447 square metres. The building is also to accommodate, separately, a minimum of two GP’s with a GMS list to be brought in under terms agreed between the landlord and the GP for the duration of the lease. "@ga;
  dct:title "Development and Lease of Primary Care Centre at Ballymahon Co. Longford"@en,
    "Development and Lease of Primary Care Centre at Ballymahon Co. Longford"@ga .

<http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/PlannedProcurementPart/PAR-0001>
  a epo:PlannedProcurementPart;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/ContractTerm$_PriorInformationNotice1_ProcurementProjectLot1>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/PartPurpose$_PriorInformationNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/ReviewTerm/ORG-0002>;
  dct:description "Development of a Primary Care Centre on the tenderer's land or within the tenderer's building to be leased to the Health Service Executive (HSE).  The HSE is initiating this tender competition in order to identify an economic operator with suitable lands or a suitable building and the capacity to develop a Primary Care Centre to HSE specifications on such lands or within such building and lease it to the HSE, including a future option for HSE to buy the Primary Care Centre.  It is anticipated that the term of the lease will be between 25 and 30 years from the completion of the Primary Care Centre.  The HSE will require an area of between 1150 and 1447 square metres.  The building is also to accommodate, separately, a minimum of two GP's with a GMS list to be brought in under terms agreed between the landlord and the GP for the duration of the lease."@en,
    "Development of a primary care centre on the tenderer’s land or within the tenderers building to be leased to the Health Service Executive (“HSE”). The HSE is initiating this tender competition in order to identify an economic operator with suitable lands or a suitable building and the capability to develop a primary care centre to HSE specifications on such lands or within such building and lease it to the HSE, including a future option for HSE to buy the primary care centre. It is anticipated that that term of the lease will be between 25 and 30 years from the completion of the primary care centre. The HSE will require an area of between 1150 and 1447 square metres. The building is also to accommodate, separately, a minimum of two GP’s with a GMS list to be brought in under terms agreed between the landlord and the GP for the duration of the lease. "@ga;
  dct:title "Development and Lease of Primary Care Centre at Ballymahon Co. Longford"@en,
    "Development and Lease of Primary Care Centre at Ballymahon Co. Longford"@ga;
  adms:identifier <http://data.europa.eu/a4g/resource/6316166c-de01-4a86-93d8-b5a7dc7d8efe-01/Identifier/PAR-0001> .

