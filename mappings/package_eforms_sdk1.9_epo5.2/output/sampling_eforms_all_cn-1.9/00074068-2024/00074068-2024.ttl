  epo:isAccelerated false;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/3e4cc371-72c6-49e5-bbe8-b8ff2bb358e8-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>;
  dct:description """Le présent marché porte sur la fourniture de licences de Vidéo Intelligente (VI) et de l’Interface Homme Machine associée destinée à la surveillance des passages à niveaux (PN).
Le marché vise également la réalisation de la maintenance logicielle, la mise à disposition support téléphonique (hotline) et une participation au déploiement de certain site ainsi que la réalisation des formations à l'utilisation/maintenance de la solution."""@fr;
  dct:title "Vidéo Intelligente aux Passages à Niveaux"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/3e4cc371-72c6-49e5-bbe8-b8ff2bb358e8-01/Procedure/Identifier/70d26001-6102-4fb7-acca-1fb24fbd76ea> .

