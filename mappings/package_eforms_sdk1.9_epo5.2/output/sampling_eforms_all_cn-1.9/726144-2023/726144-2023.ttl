  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/22c2a84c-c48b-40f0-98f9-756a1f40df93-01/ReviewProcedureInformationProvider/ORG-0002>;
