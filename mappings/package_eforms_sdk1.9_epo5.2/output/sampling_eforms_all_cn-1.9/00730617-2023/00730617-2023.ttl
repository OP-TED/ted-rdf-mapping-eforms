  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/ea619ab6-68c0-4216-8f6b-ada5748cb5be-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
    <http://data.europa.eu/a4g/resource/ea619ab6-68c0-4216-8f6b-ada5748cb5be-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/ea619ab6-68c0-4216-8f6b-ada5748cb5be-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>;
