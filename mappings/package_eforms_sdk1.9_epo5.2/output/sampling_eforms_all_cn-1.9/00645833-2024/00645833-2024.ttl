<http://data.europa.eu/a4g/resource/70697605-454a-4633-a545-2165c322b264-01/ContractTerm$_ContractNotice1_ProcurementProjectLot1>
  a epo:ContractTerm;
  epo:definesContractPeriod <http://data.europa.eu/a4g/resource/70697605-454a-4633-a545-2165c322b264-01/Interval$_ContractNotice1_ProcurementProjectLot1_ProcurementProject1_PlannedPeriod1>;
  epo:hasContractNatureType <http://publications.europa.eu/resource/authority/contract-nature/supplies>;
  epo:hasEInvoicingPermission <http://publications.europa.eu/resource/authority/permission/required>;
  epo:hasEOrdering true;
  epo:hasEPayment true;
  epo:hasMaximumNumberOfRenewals 2;
  epo:hasOptionsDescription "Juhul, kui hankija soovib rakendada RHS § 156 võimalust."@et;
  epo:hasPaymentArrangement """Pakkuja peab arvestama pakkumust esitades asjaoluga, et arvete maksetähtaeg on järgmine:
- 35 kalendripäeva, kui lepingu maksumus on vahemikus 60 000 kuni 249 999 eurot;
- 45 kalendripäeva, kui lepingu maksumus on 250 000 eurot või suurem.

Hankija faktooringuprogrammiga liitudes on lepingu maksetähtaeg 95 kalendripäeva alates kauba/teenuse/töö vastuvõtmisest. Hankija faktooringprogrammi ja selles osalemise tingimuste kohta saab lähemat teavet veebilehelt https://www.enefit.com/et/hankedokumendid.

Ettemakseid ei tehta."""@et;
  epo:hasPerformanceConditions "Hankelepingut täites peab edukas pakkuja täitma Elektrilevi OÜ juhtimissüsteemi dokumentides toodud nõudeid. Juhtimissüsteemi dokumendid on saadaval: https://www8.energia.ee/public/ee043.nsf/PKDE?OpenView, sh eetikakoodeks ning töötervishoiu ja tööohutuse nõuded, mis on saadaval https://www.energia.ee/et/hankedokumendid."@et;
  epo:hasRenewalDescription "Kooskõlas RHS § 123."@et;
  epo:hasReservedExecution <http://publications.europa.eu/resource/authority/applicability/no>;
  epo:hasUnknownDuration false .

