    <http://data.europa.eu/a4g/resource/2393dd92-aafa-4822-8117-070f62f07df0-01/ParticipationCondition$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_TendererQualificationRequest1>,
    <http://data.europa.eu/a4g/resource/2393dd92-aafa-4822-8117-070f62f07df0-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
