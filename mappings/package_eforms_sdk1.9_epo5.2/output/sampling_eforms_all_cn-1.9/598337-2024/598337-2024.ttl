<http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/Procedure/d0af0e1a-9f86-4b51-bd24-786da6927a34>
  a epo:Procedure;
  epo:foreseesTerm <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/ProcurementProjectContractTerm$_ContractNotice1_ProcurementProject1>;
  epo:hasAdditionalInformation "Pakkumus peab olema vormistatud eesti keeles, v.a tehnilised dokumendid, mis võivad olla esitatud kas eesti või inglise keeles. Võõrkeelsetele dokumentidele (v.a ingliskeelsetele tehnilistele dokumentidele) peab olema lisatud eestikeelne tõlge. Pakkumus peab olema esitatud e-riigihangete keskkonnas www.riigihanked.riik.ee. Esitatud failid ei tohi olla kaitstud kopeerimise, printimise või muu sarnase käsitlusfunktsiooni suhtes. Pakkumus peab olema allkirjastatud allkirjaõigust omava isiku poolt (juhul, kui pakkumuse allkirjastab seaduslikku allkirjaõigust mitteomav isik, siis peab pakkumusele olema lisatud allkirjastaja volikiri)."@et;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/Procedure/Identifier/283938>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasMainFeature "Sotsiaal- ja eriteenuste erimenetlus"@et;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/oth-single>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/Lot/LOT-0002>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/ProcedurePurpose$_ContractNotice1_ProcurementProject1>;
  epo:isSubjectToTerm <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/ProcedureTerm$_ContractNotice1_ProcurementProjectLot2_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/ProcedureTerm$_ContractNotice1_TenderingTerms1_LotDistribution1>;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/e274e52a-bfeb-43a4-87b9-ae3de9a5370b-01/ExclusionGround$_ContractNotice1_TenderingTerms1_TendererQualificationRequest1_SpecificTendererRequirement1>;
  dct:description """Hanke eesmärgiks on Elering AS ja Elektrilevi OÜ objektidele turvategevuse teenuse ostmine. Hanke tulemusena sõlmivad Elering AS ja Eesti Energia AS eduka pakkujaga hankelepingud turvategevuse osutamiseks.

Hankedokumendid teeb Hankija kõikidele huvitatud isikutele kättesaadavaks elektrooniliselt riigihangete registri vahendusel, v.a konfidentsiaalseks kuulutatud riigihanke alusdokumendid. Konfidentsiaalsete dokumentidega tutvumiseks peab huvitatud ettevõtja allkirjastama konfidentsiaalsuslepingu, mis asub eRHR-i sektsioonis \"Dokumendid\". Taotlus konfidentsiaalsete dokumentidega tutvumiseks tuleb koos allkirjastatud konfidentsiaalsuskokkuleppega esitada läbi riigihangete registri."""@et;
  dct:title "Elering AS ja Elektrilevi OÜ objektide turvategevus"@et;
