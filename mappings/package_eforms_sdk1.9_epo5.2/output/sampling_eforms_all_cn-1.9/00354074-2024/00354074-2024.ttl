  a epo:SubmissionTerm;
  epo:definesTenderProcessor <http://data.europa.eu/a4g/resource/5a659ec6-1cd7-48de-97f9-60ec561a7b7e-01/TenderProcessor/ORG-0001>;
  epo:definesTenderReceiver <http://data.europa.eu/a4g/resource/5a659ec6-1cd7-48de-97f9-60ec561a7b7e-01/TenderReceiver/ORG-0001>;
  epo:hasESubmissionPermission <http://publications.europa.eu/resource/authority/permission/required>;
