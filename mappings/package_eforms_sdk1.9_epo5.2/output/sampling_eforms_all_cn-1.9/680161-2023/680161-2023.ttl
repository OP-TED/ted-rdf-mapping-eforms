<http://data.europa.eu/a4g/resource/afb1df5d-7f09-4bf2-a28d-9496aa3a0eca-01/ReviewTerm$_ContractNotice1_ProcurementProjectLot9_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/afb1df5d-7f09-4bf2-a28d-9496aa3a0eca-01/ReviewProcedureInformationProvider/ORG-0002>;
