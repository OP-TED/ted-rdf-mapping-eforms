  epo:hasReceiptTenderDeadline "2023-11-13T11:00:00+01:00"^^xsd:dateTime;
  epo:hasSubmissionURL "https://portal.smartpzp.pl/nadlesnictwo.polanow"^^xsd:anyURI;
  epo:hasTenderValidityDuration <http://data.europa.eu/a4g/resource/afb1df5d-7f09-4bf2-a28d-9496aa3a0eca-01/SpecificDuration$_ContractNotice1_ProcurementProjectLot10_TenderingTerms1_TenderValidityPeriod1>;
  epo:hasVariantPermission <http://publications.europa.eu/resource/authority/permission/not-allowed>;
