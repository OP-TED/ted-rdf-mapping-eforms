  a epo:OpeningTerm;
  epo:hasOpeningDateTime "2023-11-13T11:30:00+01:00"^^xsd:dateTime;
  epo:hasOpeningDescription "Osobą uprawnioną do porozumiewania się z Wykonawcami jest:p. Łukasz Czepłowski;; e-mail: lukasz.czeplowski@szczecinek.lasy.gov.plod poniedziałku do piątku w godz. 7:00 – 15:00, z wyłączeniem dni wolnych od pracy.Otwarcie ofert następuje poprzez odszyfrowanie i otwarcie ofert za pomocą platformy Portal e-Usług SMARTPZP"@pl;
  epo:hasOpeningPlace "Wykonawca składa ofertę za pośrednictwem formularza oferty dostępnego na platformie Portalu e-Usług SMARTPZP https://portal.smartpzp.pl/nadlesnictwo.polanow Zamawiający, najpóźniej przed otwarciem ofert, udostępnia na stronie internetowej prowadzonego postępowania informację o kwocie, jaką zamierza przeznaczyć na sfinansowanie zamówienia oraz poszczególnych części Pakietów."@pl .

