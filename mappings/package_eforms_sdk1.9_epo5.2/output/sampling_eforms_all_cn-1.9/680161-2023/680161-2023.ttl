    <http://data.europa.eu/a4g/resource/afb1df5d-7f09-4bf2-a28d-9496aa3a0eca-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria1>,
    <http://data.europa.eu/a4g/resource/afb1df5d-7f09-4bf2-a28d-9496aa3a0eca-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria2>,
    <http://data.europa.eu/a4g/resource/afb1df5d-7f09-4bf2-a28d-9496aa3a0eca-01/SelectionCriterion$_ContractNotice1_ProcurementProjectLot1_TenderingTerms1_UBLExtensions1_UBLExtension1_ExtensionContent1_EformsExtension1_SelectionCriteria3>;
