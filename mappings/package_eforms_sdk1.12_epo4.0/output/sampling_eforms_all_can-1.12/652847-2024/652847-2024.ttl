<http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/Lot/LOT-0001>
  a epo:Lot;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1>,
    <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/ContractTerm$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Termin wykonania zamówienia: do 7 tygodni od dnia zawarcia umowy."@pl;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/Lot/Identifier/5B10.291.1.107.2024.JZ>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/LotPurpose$_ContractAwardNotice1_ProcurementProjectLot1_ProcurementProject1>;
  epo:isCoveredByGPA false;
  epo:isSubjectToLotSpecificTerm <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/AccessTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/FrameworkAgreementTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>,
    <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>,
    <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1_PresentationPeriod1>;
  epo:isUsingEUFunds false;
  epo:specifiesProcurementCriterion <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/AwardCriterion$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AwardingTerms1_AwardingCriterion1_SubordinateAwardingCriterion1>;
  epo:usesTechnique <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/AuctionTerms$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1_AuctionTerms1>,
    <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/DynamicPurchaseSystemTechnicalUsage$_ContractAwardNotice1_ProcurementProjectLot1_TenderingProcess1>;
  dct:description """1.	Przedmiotem zamówienia jest dostawa termocyklera, zwanego dalej „sprzętem”, dla Wydziału Biologii Uniwersytetu Gdańskiego.
2.	Kod Klasyfikacji Wspólnego Słownika Zamówień (CPV): 3800000-5 (sprzęt laboratoryjny, optyczny i precyzyjny, 
z wyjątkiem szklanego).
3.	Szczegółowy opis przedmiotu zamówienia został określony w załączniku nr 6 do SWZ – Opis przedmiotu zamówienia.
4.	Miejsce dostawy sprzętu: Katedra Biochemii Ogólnej i Medycznej, Wydział Biologii, Uniwersytet Gdański, ul. Wita Stwosza 59, 80-308 Gdańsk, pokój A/308. 
5.	Zamawiający wymaga gwarancji na sprzęt na okres 24 miesięcy. Szczegóły dotyczące gwarancji zawarte są w § 7 Projektu umowy – załączniku nr 5 do SWZ.
6.	Zamawiający może unieważnić postępowanie o udzielnie zamówienia, jeżeli środki publiczne, które Zamawiający zamierzał przeznaczyć na sfinansowanie w całości lub w części zamówienia nie zostały mu przyznane, a możliwość unieważnienia postępowania na tej podstawie została przewidziana w ogłoszeniu o zamówieniu – 
w postępowaniu prowadzonym w trybie przetargu nieograniczonego – art. 257 pkt 1 Pzp."""@pl;
  dct:title "Dostawa termocyklera dla Wydziału Biologii Uniwersytetu Gdańskiego"@pl;
  adms:identifier <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/Identifier/LOT-0001> .

