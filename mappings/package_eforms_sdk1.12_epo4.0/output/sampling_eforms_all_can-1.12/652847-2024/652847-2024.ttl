<http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/ReviewTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1_AppealTerms1>
  a epo:ReviewTerm;
  epo:definesReviewProcedureInformationProvider <http://data.europa.eu/a4g/resource/f71e1952-9f8a-444f-a345-350f2c067fc4-01/ReviewProcedureInformationProvider/ORG-0002>;
