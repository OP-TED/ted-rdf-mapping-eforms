<http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/Procedure/211b8b70-83d3-42d8-934c-65e9ec361c61>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasInternalIdentifier <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/Procedure/Identifier/37.25.2.2024>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0024>;
  epo:hasLegalBasisDescription "Ustawa z dnia 11.09.2019 r. Prawo zamówień publicznych (t.j. Dz. U. z 2023 r. poz. 1605 z późn. zm.) / Ustawa z dnia 11.09.2019 r. Prawo zamówień publicznych (t.j. Dz. U. z 2023 r. poz. 1605 z późn. zm.)"@pl;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/open>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/Lot/LOT-0001>,
    <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/Lot/LOT-0002>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  epo:isAccelerated false;
  epo:isSubjectToProcedureSpecificTerm <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot1_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/ProcedureTerm$_ContractAwardNotice1_ProcurementProjectLot2_TenderingTerms1>,
    <http://data.europa.eu/a4g/resource/45a030b6-cf22-4288-bd41-82e0aa21142c-01/ProcedureTerm$_ContractAwardNotice1_TenderingTerms1_LotDistribution1>;
  dct:description """Przedmiotem zamówienia są usługi dotyczące realizacji zadań ochronnych w ekosystemach leśnych, ochronie roślin, monitoringu przyrodniczego i technicznego oraz utrzymania turystycznego w Wolińskim Parku Narodowym w latach 2024 -2028 składające się z:
1)	Część I „Północ” – (obejmuje prace na terenie OO. Wisełka, OO. Warnowo, 
OO. Międzyzdroje)
a)	Prace z zakresu hodowli lasu – TW: zabiegi pielęgnacyjne młodego pokolenia drzewostanu, melioracje agrotechniczne: usuwanie ekspansywnych gatunków neofitów, 
takich jak: rdestowiec, czeremcha późna, robinia biała, daglezja zielona, śnieguliczka biała 
oraz świerk.
b)	Prace z zakresu ochrony lasu – konserwacja, naprawy i remonty ogrodzeń powierzchni przebudowywanych, budowa nowych ogrodzeń, wykonywanie kontroli występowania wybranych gatunków owadów, konserwacja sprzętu pożarniczego, odnawianie pasów pożarowych, usuwanie drzew oraz ich części ze skrajni dróg, a także drzew powalonych 
lub stanowiących zagrożenie obalenia się. 
c)	Prace związane z wykonywaniem cięć przebudowy i ochronnych w drzewostanach Wolińskiego Parku Narodowego, tj. cięć przebudowy i pielęgnacyjnych, cięć przygodnych wraz ze zrywką pozyskanego surowca drzewnego.
1.1	Obalanie całych drzew wraz z korzeniami.
1.2	Ochrona p. pożarowa: 
-	konserwacja sprzętu pożarniczego, 
-	odnawianie pasów pożarowych,
-	konserwacja dojazdów pożarowych, usuwanie drzew oraz ich części ze skrajni dróg, oraz powalonych lub stanowiących niebezpieczeństwo obalenia się,
- 	naprawy dojazdów pożarowych, uzupełnianie ubytków.
1.3	Utrzymanie turystyczne:
-	zbieranie śmieci, selektywne gromadzenie nieczystości;
-	wymiana worków w koszach na śmieci, 
-	koszenie trawników, pielęgnacja żywopłotów,
-	mycie infrastruktury turystycznej, zabezpieczanie drewnianych elementów urządzeń turystycznych impregnatem do konserwacji drewna, 
-	przygotowanie do sezonu letniego oraz bieżące utrzymanie miejsc postojowych KWASOWO – zadanie obejmuje takie prace jak: skoszenie trawników, wykonanie prac 
z zakresu pielęgnacji drzew i krzewów, wyczyszczenie i zamiecenie powierzchni asfaltowej, udrożnienie kanałów odprowadzających wody opadowe z powierzchni, zbieranie śmieci, wymianę worków w koszach do gromadzenia odpadów, 
-	wykonanie i remonty urządzeń turystycznych: barier drewnianych, witaczy, stelaży pod tablice, schodów ziemno – drewnianych, palisad, odnawianie oznakowania szlaków turystycznych,
-	bieżące naprawy nawierzchni szlaków oraz miejsc udostępnionych w granicach Wolińskiego Parku Narodowego.
1.4	Monitoring przyrodniczy i techniczny:
-	wykaszanie posterunku meteo wraz z wygrabieniem i wywiezieniem skoszonej biomasy,
-	naprawa i konserwacja stacjonarnych urządzeń monitoringowych (np. oczyszczenie 
i malowanie, prace stolarskie m.in. skrzynki piezometrów, stacji meteo, pomosty).
1.5	Działalność pozostała - administracja:
-	przygotowanie opału dla kancelarii,
- 	wykaszanie terenu przy zabudowaniach,
-	naprawy grodzeń przy osadach.
2)	 Część II „Południe” – (obejmuje prace na terenie OO. Wicko, OO. Wapnica, 
O.O. Wodny) 
a)	Prace z zakresu hodowli lasu – TW: zabiegi pielęgnacyjne młodego pokolenia drzewostanu, melioracje agrotechniczne: usuwanie ekspansywnych gatunków neofitów, takich jak: rdestowiec, czeremcha późna, robinia biała, daglezja zielona, śnieguliczka biała 
oraz świerk.
b)	Prace z zakresu ochrony lasu – konserwacja, naprawy i remonty ogrodzeń powierzchni przebudowywanych, budowa nowych ogrodzeń, wykonywanie kontroli występowania wybranych gatunków owadów, konserwacja sprzętu pożarniczego, odnawianie pasów pożarowych, usuwanie drzew oraz ich części ze skrajni dróg, usuwanie drzew powalonych 
lub stanowiących zagrożenie obalenia się. 
c)	Prace związane z wykonywaniem cięć przebudowy i ochronnych w drzewostanach Wolińskiego Parku Narodowego tj. cięć przebudowy i pielęgnacyjnych, cięć przygodnych 
wraz ze zrywką pozyskanego surowca drzewnego.
2.1	Obalanie całych drzew wraz z korzeniami.
2.2	Ochrona p. pożarowa: 
-	konserwacja sprzętu pożarniczego, 
-	odnawianie pasów pożarowych,
-	konserwacja dojazdów pożarowych, usuwanie drzew oraz ich części ze skrajni dróg, oraz powalonych lub stanowiących niebezpieczeństwo obalenia się,
- 	naprawy dojazdów pożarowych, uzupełnianie ubytków.
2.3	Utrzymanie turystyczne:
-	zbieranie śmieci, selektywne gromadzenie nieczystości;
-	wymiana worków w koszach na śmieci, 
-	koszenie trawników, pielęgnacja żywopłotów,
-	mycie infrastruktury turystycznej, zabezpieczanie drewnianych elementów urządzeń turystycznych impregnatem do konserwacji drewna, 
-	przygotowanie do sezonu letniego miejsca postojowego JEZIORO TURKUSOWE – zadanie obejmuje takie prace jak: skoszenie trawników, wykonanie prac z zakresu pielęgnacji drzew i krzewów, wyczyszczenie i zamiecenie powierzchni asfaltowej, udrożnienie kanałów odprowadzających wody opadowe z powierzchni, zbieranie śmieci, wymianę worków w koszach do gromadzenia odpadów, 
-	wykonanie i remonty urządzeń turystycznych: barier drewnianych, witaczy, stelaży pod tablice, schodów ziemno – drewnianych, palisad, odnawianie oznakowania szlaków turystycznych,
-	bieżące naprawy nawierzchni szlaków oraz miejsc udostępnionych w granicach Wolińskiego Parku Narodowego.
2.4	Monitoring przyrodniczy i techniczny:
-	naprawa i konserwacja stacjonarnych urządzeń monitoringowych (np. oczyszczenie 
i malowanie, prace stolarskie m.in. skrzynki piezometrów, stacji meteo, pomosty).
2.5	Działalność pozostała - administracja:
-	przygotowanie opału dla kancelarii,
- 	wykaszanie terenu przy zabudowaniach,
-	naprawy grodzeń przy osadach."""@pl;
  dct:title "Zadania ochronne w Wolińskim Parku Narodowym w latach 2024 -2028"@pl;
