  skos:notation "eb148135-7d2c-4c7d-a64c-48f90a584b1a" .

<http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/Procedure/eb148135-7d2c-4c7d-a64c-48f90a584b1a>
  a epo:Procedure;
  epo:foreseesContractSpecificTerm <http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1>,
    <http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/ProcurementProjectContractTerm$_ContractAwardNotice1_ProcurementProject1_RealizedLocation1>;
  epo:hasAdditionalInformation "Pour répondre au présent avis de marché, les candidats doivent se manifester sur le Portail Achats d'EDF - Demande d'information suivante : AVIS003211 - et rattacher les documents demandés au présent avis de marché. Les candidats intéressés, non encore inscrits, s'auto-référenceront depuis la page d'accueil du Portail Achats sur le site https://pha2.edf.com à l'aide du lien placé dans l'encart : « Accéder aux fournisseurs » puis \"créer un fournisseur\". Un document intitulé « Identification des membres du groupement et répartition des prestations » est disponible dans l'espace collaboratif dédié aux fournisseurs dans le Portail Achats. La consultation sera effectuée par e-tender via le Portail Achats électronique d’EDF (https://pha2.edf.com) EDF se réserve la possibilité d’attribuer le marché sur la base des offres initiales sans négociation. Dans le cadre de la dématérialisation de ses procédures, EDF SA informe l'ensemble des soumissionnaires que la signature électronique des marchés est privilégiée, que ceux-ci soient attribués à une seule entreprise ou à un groupement d'entreprises."@fr;
  epo:hasEstimatedValue <http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/MonetaryValueProcedure$_ContractAwardNotice1_ProcurementProject1_RequestedTenderTotal1>;
  epo:hasLegalBasis <http://publications.europa.eu/resource/authority/legal-basis/32014L0025>;
  epo:hasProcedureType <http://publications.europa.eu/resource/authority/procurement-procedure-type/neg-w-call>;
  epo:hasProcurementScopeDividedIntoLot <http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/Lot/LOT-0000>;
  epo:hasPurpose <http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/ProcedurePurpose$_ContractAwardNotice1_ProcurementProject1>;
  dct:description "Dans le cadre du programme de transformation numérique engagé par l'Entreprise, cette dernière a besoin de s’appuyer sur des petites structures et disposer d’un panel de partenaires plus large (startups, TPE, PME, indépendants, …), afin de bénéficier de prestations informatiques de haut niveau avec des compétences et des profils rares ou pointus. Ce besoin nécessite le recours à l’achat de prestations d’intermédiation qui sont l’objet du présent marché-cadre. Les prestations d’intermédiation ont pour objet : • Une qualification experte, technique et contractuelle de leurs partenaires, • L’accès à des services administratifs et contractuels simplifiant la mise en œuvre des prestations des partenaires, • Les réalisations des prestations IT de ces partenaires experts IT pour l'Entreprise."@fr;
  dct:title "SMASH : Marché cadre de prestations d'intermédiation en expertises informatiques"@fr;
  adms:identifier <http://data.europa.eu/a4g/resource/e45681a1-5ab8-4dfe-bbd1-8e8931311d6a-01/Procedure/Identifier/eb148135-7d2c-4c7d-a64c-48f90a584b1a> .

