epd:id_64bdfc22-2f35-4109-9817-a8f0bd9468b6_PlannedProcurementPart_PAR-0000 a epo:PlannedProcurementPart;
  epo:foreseesProcurementObject epd:id_64bdfc22-2f35-4109-9817-a8f0bd9468b6_PartProcurementObject_adyhtKZkzxr6SEjy3tRyua;
  epo:hasPlannedDuration epd:id_64bdfc22-2f35-4109-9817-a8f0bd9468b6_PartSpecificDuration_kSZMfSA8qTkPCvvg4J7pge;
  epo:hasPlannedPeriod epd:id_64bdfc22-2f35-4109-9817-a8f0bd9468b6_PartPeriod_kSZMfSA8qTkPCvvg4J7pge;
  dct:description "The authority has identified a requirement for a single supplier framework agreement for linguistic services in support of Permanent Joint Headquarters (PJHQ) and other user worldwide operations. This requirement shall include linguists at a variety of skill and security clearance levels to meet pre-defined roles but will also necessitate short notice deployments in to emerging operational locations when required by the authority. The authority will be looking to place a contract for four (4) years, with the potential to extend for a further twenty-four (24) months. The authority will be looking to place a contract notice for this requirement, with further details of the requirement, in the next 1-4 months. Interested suppliers will be expected to complete a Dynamic Pre-Qualification Questionnaire (DPQQ) with a minimum of three suppliers taken through to the invitation to tender (ITT) stage"@en;
  dct:title "Provision of Worldwide Linguistic Services in Support of UK MoD Operations"@en;
  adms:identifier epd:id_64bdfc22-2f35-4109-9817-a8f0bd9468b6_PlannedProcurementPartIdentifier_adyhtKZkzxr6SEjy3tRyua .

